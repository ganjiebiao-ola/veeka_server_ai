#!/usr/bin/env python3
"""Render the agent root entries CLAUDE.md (Claude Code) and AGENTS.md (Codex) from their skeletons.

Sources (platform-internals/ownership.yaml):
  platform-internals/templates/CLAUDE.md.tmpl, AGENTS.md.tmpl   framework-owned skeletons
  team-context/agent-entry.team.md                              team-owned slots (`## <section>` bodies)
Directives, each on a line of its own:
  {{ALWAYS_ON: <path>}}   CLAUDE.md → `- @<path>` (Claude Code expands @import)
                          AGENTS.md → the file's content inlined between markers (Codex has no import)
  {{TEAM: <section>}}     body of `## <section>` from agent-entry.team.md; a body that is only HTML
                          comments / blank lines renders as nothing (the seed carries guidance that way)
Zero-dependency (stdlib only). `--check` renders in memory and exits 1 if either tracked file differs
(wired into ws test / ws health through scripts/check-generated). A non-flag argv is a root override.
"""
import pathlib
import re
import sys

args = [a for a in sys.argv[1:] if a != "--check"]
check = "--check" in sys.argv[1:]
root = pathlib.Path(args[0]).resolve() if args else pathlib.Path(__file__).resolve().parent.parent
TPL = root / "platform-internals" / "templates"
TEAM = root / "team-context" / "agent-entry.team.md"
ALWAYS_ON = re.compile(r"^\{\{ALWAYS_ON:\s*(\S+?)\s*\}\}$")
TEAM_SLOT = re.compile(r"^\{\{TEAM:\s*([A-Za-z0-9_-]+)\s*\}\}$")
BANNER = ("<!-- GENERATED by scripts/render-agent-entries — do not edit. Sources: "
          "platform-internals/templates/{tmpl} + team-context/agent-entry.team.md (+ the always-on files it names). -->")


def team_sections():
    if not TEAM.exists():
        sys.exit(f"ERROR: missing {TEAM.relative_to(root)} (a seed) — restore it from the template")
    sections, name, buf = {}, None, []
    for line in TEAM.read_text().splitlines():
        m = re.match(r"^## (\S.*?)\s*$", line)
        if m:
            if name:
                sections[name] = buf
            name, buf = m.group(1), []
        elif name is not None:
            buf.append(line)
    if name:
        sections[name] = buf
    out = {}
    for k, lines in sections.items():
        # HTML comments (single- or multi-line) in a seed are guidance, never rendered
        text = re.sub(r"<!--.*?-->", "", "\n".join(lines), flags=re.S)
        body = text.splitlines()
        while body and not body[0].strip():
            body.pop(0)
        while body and not body[-1].strip():
            body.pop()
        out[k] = body
    return out


def inline_block(rel):
    src = root / rel
    if not src.exists():
        sys.exit(f"ERROR: ALWAYS_ON source {rel} does not exist")
    body = src.read_text().strip("\n")
    return (f"<!-- BEGIN inlined:{rel} — generated copy of the source; edit the source, then re-sync this block -->\n"
            f"{body}\n<!-- END inlined:{rel} -->")


def render(name, sections):
    tmpl = TPL / f"{name}.tmpl"
    if not tmpl.exists():
        sys.exit(f"ERROR: missing skeleton {tmpl.relative_to(root)}")
    out, blocks = [BANNER.format(tmpl=f"{name}.tmpl")], {}
    for line in tmpl.read_text().splitlines():
        m = ALWAYS_ON.match(line.strip())
        if m:
            rel = m.group(1)
            if name == "CLAUDE.md":
                out.append(f"- @{rel}")
            else:
                token = f"\x00INLINE:{rel}\x00"
                blocks[token] = inline_block(rel)
                out.extend([token, ""])
            continue
        m = TEAM_SLOT.match(line.strip())
        if m:
            out.extend(sections.get(m.group(1), []))
            continue
        out.append(line)
    text = re.sub(r"\n{3,}", "\n\n", "\n".join(out)).rstrip("\n") + "\n"
    for token, block in blocks.items():
        text = text.replace(token, block)
    return text


sections = team_sections()
stale = []
for name in ("CLAUDE.md", "AGENTS.md"):
    text = render(name, sections)
    target = root / name
    if check:
        if not target.exists() or target.read_text() != text:
            stale.append(name)
    else:
        target.write_text(text)
        print(f"rendered {name}")
if check:
    if stale:
        print("FAIL: agent entries stale: " + ", ".join(stale) + " — run scripts/render-agent-entries")
        sys.exit(1)
    print("OK: CLAUDE.md and AGENTS.md match their skeletons + team slots")
