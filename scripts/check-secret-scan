#!/usr/bin/env python3
"""Scan git-tracked files for committed credentials — the "no credential in the repo" red line.

Zero-dependency (stdlib only), a sibling of check-asset-metadata. Delivered by #50; this is the
harness-level check that rules/access-and-credentials.md and .gitignore promise ("harness check comes
with #50"). Two layers:
  (a) filename: a tracked file whose name matches a credential-shaped pattern (mirrors .gitignore's
      mechanical backstop) — it should have been gitignored, so its presence in the tree fails.
  (b) content: a tracked text file containing a high-signal secret (PEM private key, AWS key id,
      GitHub token, generic assignment like password=/token=).

Exit codes: 0 = scanned, clean · 1 = FAIL (a finding, OR zero tracked text files in an existing git
repo — the same "zero coverage is not a pass" rule check-asset-metadata enforces, since an established
repo with nothing tracked is anomalous, not a bootstrap state) · 2 = WARN, no git repo yet (the one
legitimate "can't scan yet" state — `ws init` releases a skeleton with no `.git` until the operator's
first commit) — check-health renders 2 as [WARN], not as a silent pass.

Scans only `git ls-files` (tracked files), so mounted content under repos/ skills/ knowledge/ (all
gitignored) is out of scope by construction. This scanner and .gitignore carry these patterns as
data, so they are self-excluded to avoid self-tripping.
"""
import re
import subprocess
import sys
import pathlib

root = pathlib.Path(__file__).resolve().parent.parent

# Files that legitimately carry credential-shaped patterns as data (spec/tooling), excluded from scan.
SELF_EXCLUDE = {
    "scripts/check-secret-scan",
    ".gitignore",
    "rules/access-and-credentials.md",
    "platform-internals/runs-format.md",
    "platform-internals/runs-example-harness-block.jsonl",
}

# (a) credential-shaped filenames (mirrors .gitignore backstop).
FILENAME_PATTERNS = [
    r"\.env$", r"\.env\.(?!example$)", r"\.pem$", r"\.key$", r"key.*\.json$",
    r"^id_rsa", r"^id_ed25519", r"\.p12$", r"\.pfx$",
    r"^credentials", r"^secrets", r"^token.*\.txt$",
]

# (b) high-signal secret content.
CONTENT_PATTERNS = [
    (r"-----BEGIN (?:RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----", "private key block"),
    (r"AKIA[0-9A-Z]{16}", "AWS access key id"),
    (r"gh[pousr]_[A-Za-z0-9]{20,}", "GitHub token"),
    # Code expressions are not credentials. Check quoted literals and bare config values.
    # A quoted UPPER_SNAKE value is an env var name, not a credential.
    (r"(?i)(?:(?:password|passwd|secret|token|api[_-]?key)\s*[:=]|[\"'][A-Za-z0-9_]*(?:password|passwd|secret|token|api[_-]?key)[\"']\s*[:=])\s*[\"'](?-i:(?![A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+[\"']))[A-Za-z0-9/+=_-]{8,}", "credential assignment"),
    (r"(?im)^\s*(?:export\s+)?[A-Z_]*(password|passwd|secret|token|api[_-]?key)\s*[:=]\s*[A-Za-z0-9/+=_-]{8,}\s*(?:#.*)?$", "credential assignment"),
]

try:
    tracked = subprocess.run(
        ["git", "-C", str(root), "ls-files"],
        capture_output=True, text=True, check=True,
    ).stdout.splitlines()
except subprocess.CalledProcessError:
    # Not a git repository yet. `ws init` releases the skeleton with `git archive | tar -x`, so a
    # freshly initialized workspace has no .git until the operator commits — and the very first thing
    # a non-FDE member does is init-then-health (#44's independent re-run). The red line governs
    # *committed* credentials, so with no git there is nothing committed and this is not a FAIL — but
    # it is not an OK either: nothing was scanned, and a green line for a scan that never ran is the
    # vacuous-green failure mode check-asset-metadata refuses. WARN (exit 2) says so out loud without
    # making the bootstrap gate impossible to pass.
    print("WARN: nothing scanned — not a git repository yet (no tracked files to scan)")
    print("  - run `git init && git add -A && git commit` here, then re-run `ws health` to get a real scan")
    sys.exit(2)
except FileNotFoundError:
    sys.exit("ERROR: could not list tracked files (git not available)")

errors = []
scanned = 0
for rel in tracked:
    if rel in SELF_EXCLUDE:
        continue
    base = rel.rsplit("/", 1)[-1]
    for pat in FILENAME_PATTERNS:
        if re.search(pat, base):
            errors.append(f"{rel}: credential-shaped filename (should be gitignored, not tracked)")
            break

    f = root / rel
    try:
        text = f.read_text()
    except (UnicodeDecodeError, OSError):
        continue  # binary / unreadable — skip content scan
    scanned += 1
    for pat, label in CONTENT_PATTERNS:
        m = re.search(pat, text)
        if m:
            errors.append(f"{rel}: possible {label} in tracked content")

if errors:
    print("FAIL: secret scan")
    for e in errors:
        print("  -", e)
    sys.exit(1)

if scanned == 0:
    # Unlike the no-git case above, this is an *existing* git repo with zero tracked text files —
    # not a bootstrap state, just vacuous green ("no credentials found" is trivially true when
    # nothing was looked at). check-asset-metadata treats the same shape of problem (zero coverage)
    # as FAIL, not WARN — match that precedent instead of inventing a softer rule for the credential
    # scan specifically.
    print("FAIL: secret scan")
    print("  - 0 tracked text files scanned — a scan with nothing to scan is not a pass")
    print("  - if this is expected (e.g. a docs-only checkout), confirm and adjust this check's scope")
    sys.exit(1)

print(f"OK: no credentials in {scanned} tracked text files")
