#!/usr/bin/env python3
"""ai-usage-weekly — the weekly AI-usage reporting chain (#22).

    submit  one person's week: local collectors (token-usage-report / token-usage-tasks) +
            price-table cost estimate + an operator-confirmed narrative -> one submission file
            in the team reports repo (reports/<week>/<human_id>.json + .md).
    team    one week for the team: read reports/<week>/*.json, validate each against the
            submission schema, aggregate, render team-report.html (inline SVG, self-contained)
            + team-report.md.
    month   one calendar month (read from the file name): import the LiteLLM key allocation xlsx
            (real cost) → cost by team, checked against the file total, in reports/months/<YYYY-MM>/
            (month.json + .md + .html); a re-import replaces the month. It also reads the local git
            history of the mounted repos (commits, AI-assisted commits, reverts) and maps keys and
            authors to persons through reports/team.json identities, and rolls up the month's weekly
            submissions (a week counts in the month of its Sunday) and resource requests into AI use,
            delivery and value.

Zero-dependency (python3 stdlib + git). Never pushes, never calls the network. Exit codes:
0 written, 2 no data / precondition missing (never green on nothing).

Privacy: the submission carries aggregates and the confirmed narrative only — never prompts,
file paths, or session ids (those never leave the collectors' sanitized JSON either). Cost is
always an estimate (估算) from assets/pricing.json; models missing from the table are listed as
unpriced, never guessed. People are never ranked by cost.

Three amounts, shown side by side and NEVER summed (schema v2, #192 T1): cost.estimated is the
local usage log × price table (估算 — an estimate, not a bill; it never enters 核算/报销 or budget
totals), cost.actual is what a bill / ledger says, cost.allocated is the share attributed to this
person / week. actual + allocated only ever come from --cost-file (a billing-owner supplied JSON,
filled from bills by T2); without it they are null and the md shows 待核实, never 0.
"""
import argparse
import html as html_mod
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import date, datetime, timedelta, timezone
from importlib.machinery import SourceFileLoader

if sys.version_info < (3, 9):
    _name = os.path.basename(__file__)
    sys.stderr.write("FAIL: %s needs Python 3.9 or newer; this is Python %s (%s). Run it with a newer python3 "
                     "(on macOS: /usr/bin/python3 scripts/%s ...).\n" % (_name, sys.version.split()[0],
                                                                         sys.executable, _name))
    sys.exit(2)

_HERE = os.path.dirname(os.path.abspath(__file__))
_loader = SourceFileLoader("token_usage_report", os.path.join(_HERE, "token-usage-report"))
_tur = importlib.util.module_from_spec(importlib.util.spec_from_loader("token_usage_report", _loader))
_loader.exec_module(_tur)
fmt = _tur.fmt
from_iso = _tur.from_iso

SCHEMA_VERSION = 2
SCHEMA_REL = os.path.join("platform-internals", "schemas", "ai-usage-submission.schema.json")
PRICING_REL = os.path.join("skills", "ai-usage-weekly", "assets", "pricing.json")
REPORTS_REL = os.path.join("knowledge", "ai-usage-reports")
STARTER_REL = os.path.join("skills", "ai-usage-weekly", "assets", "reports-repo")


# ---------------------------------------------------------------- shared helpers

def workspace_identity(root):
    """Hand-parse owner: / team: / business: from workspace.yaml. Returns (owner, team, business);
    '' when unset (business is optional — the schema allows null)."""
    vals = {"owner": "", "team": "", "business": ""}
    try:
        with open(os.path.join(root, "workspace.yaml"), encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r"^(owner|team|business)\s*:\s*(.*?)\s*(#.*)?$", line)
                if m:
                    vals[m.group(1)] = m.group(2).strip().strip("'\"")
    except OSError:
        pass
    return vals["owner"], vals["team"], vals["business"]


def local_timezone():
    """IANA name when the OS exposes one (TZ env, /etc/localtime symlink), else the fixed offset."""
    tz = os.environ.get("TZ", "").strip()
    if tz:
        return tz
    try:
        target = os.path.realpath("/etc/localtime")
        if "zoneinfo/" in target:
            return target.split("zoneinfo/", 1)[1]
    except OSError:
        pass
    off = datetime.now().astimezone().strftime("%z")  # +0800
    return off[:3] + ":" + off[3:] if off else "UTC"


def _placeholder(v):
    return (not v) or v.startswith("<") or "TODO" in v


def git_head(path):
    try:
        out = subprocess.run(["git", "-C", path, "rev-parse", "HEAD"], capture_output=True,
                             text=True, timeout=10)
        return out.stdout.strip() if out.returncode == 0 else ""
    except (OSError, subprocess.SubprocessError):
        return ""


def ensure_reports_dir(reports_dir, tool_root, create):
    """True when reports_dir exists (or was just created). Write commands (submit / request --form)
    pass create=True: a missing dir is created as a *local* reports repo — its own `git init`, the
    starter files from assets/reports-repo/ (roster / budget as `.example` so nothing placeholder is
    ever read as data) — and a WARN says it is not yet the team's repo. Read commands (team /
    request review) never create: nothing to aggregate. The tool still never pushes or networks."""
    if os.path.isdir(reports_dir):
        return True
    if not create:
        print("FAIL: reports dir not found: %s — clone your team's reports repo there, pass --reports-dir, "
              "or run `submit` once (it creates a local one)" % reports_dir)
        return False
    starter = os.path.join(tool_root, STARTER_REL)
    try:
        os.makedirs(os.path.join(reports_dir, "reports"), exist_ok=True)
        copies = [("README.md", "README.md"),
                  (os.path.join("scripts", "team-report.sh"), os.path.join("scripts", "team-report.sh")),
                  (os.path.join(".github", "workflows", "team-report.yml"), os.path.join(".github", "workflows", "team-report.yml")),
                  (os.path.join("reports", "team.json"), os.path.join("reports", "team.json.example")),
                  (os.path.join("reports", "budget.json"), os.path.join("reports", "budget.json.example"))]
        for src, dst in copies:
            sp, dp = os.path.join(starter, src), os.path.join(reports_dir, dst)
            if os.path.isfile(sp) and not os.path.exists(dp):
                os.makedirs(os.path.dirname(dp), exist_ok=True)
                with open(sp, "rb") as fi, open(dp, "wb") as fo:
                    fo.write(fi.read())
                if dst.endswith(".sh"):
                    os.chmod(dp, 0o755)
    except OSError as e:
        print("FAIL: could not create reports dir %s: %s" % (reports_dir, e))
        return False
    # Its own .git so `--commit` lands here, not in the enclosing workspace checkout (the default
    # location is gitignored there, and `git add` of an ignored path would silently do nothing).
    inited = False
    try:
        r = subprocess.run(["git", "init", "-q", reports_dir], capture_output=True, text=True, timeout=10)
        inited = r.returncode == 0
        if inited:  # starter files as the first commit; a missing git identity just leaves them untracked
            subprocess.run(["git", "-C", reports_dir, "add", "-A"], capture_output=True, timeout=10)
            subprocess.run(["git", "-C", reports_dir, "commit", "-q", "-m", "ai-usage-weekly: init local reports repo"],
                           capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass
    print("WARN: reports dir %s did not exist — created a LOCAL reports repo%s (starter files from %s)."
          % (reports_dir, " with its own git" if inited else " (git init failed: --commit will be skipped)", STARTER_REL))
    print("WARN: 这是本地目录,不是团队仓 — 团队页 / request review 看不到它。接入团队:在这里 git remote add origin <团队私有仓> 后 push,"
          "或删掉它改为 git clone <团队私有仓> %s;名单 / 预算填 reports/team.json 与 reports/budget.json(见 .example)。" % reports_dir)
    return True


def resolve_window(week, since, until):
    """--week YYYY-Www (ISO, Mon..Sun) or --since/--until; default = last complete ISO week."""
    if week:
        m = re.match(r"^(\d{4})-W(\d{2})$", week)
        if not m:
            raise ValueError("--week must look like 2026-W37")
        s = date.fromisocalendar(int(m.group(1)), int(m.group(2)), 1)
        return s, s + timedelta(days=6), week
    if since or until:
        u = datetime.strptime(until, "%Y-%m-%d").date() if until else date.today()
        s = datetime.strptime(since, "%Y-%m-%d").date() if since else u - timedelta(days=6)
        if s > u:
            raise ValueError("--since is after --until")
        iso = s.isocalendar()
        return s, u, "%04d-W%02d" % (iso[0], iso[1])
    today = date.today()
    this_monday = today - timedelta(days=today.weekday())
    s = this_monday - timedelta(days=7)
    iso = s.isocalendar()
    return s, s + timedelta(days=6), "%04d-W%02d" % (iso[0], iso[1])


def load_json(path):
    with open(path, encoding="utf-8") as fh:
        return json.load(fh)


# ---------------------------------------------------------------- minimal JSON-schema check
# Enough of draft-2020-12 to enforce the submission contract without a dependency:
# type / required / properties / additionalProperties / const / enum / pattern / minimum /
# items / oneOf. Returns a list of "path: problem" strings (empty = valid).

_TYPES = {"object": dict, "array": list, "string": str, "integer": int, "number": (int, float),
          "boolean": bool, "null": type(None)}


def _type_ok(val, t):
    if t == "integer":
        return isinstance(val, int) and not isinstance(val, bool)
    if t == "number":
        return isinstance(val, (int, float)) and not isinstance(val, bool)
    if t == "boolean":
        return isinstance(val, bool)
    return isinstance(val, _TYPES[t])


def validate(val, schema, path="$"):
    errs = []
    if "oneOf" in schema:
        matches = [sub for sub in schema["oneOf"] if not validate(val, sub, path)]
        if len(matches) != 1:
            errs.append("%s: matches %d of oneOf branches (need exactly 1)" % (path, len(matches)))
        return errs
    if "const" in schema and val != schema["const"]:
        errs.append("%s: must equal %r" % (path, schema["const"]))
    if "enum" in schema and val not in schema["enum"]:
        errs.append("%s: must be one of %r" % (path, schema["enum"]))
    t = schema.get("type")
    if t is not None:
        ts = t if isinstance(t, list) else [t]
        if not any(_type_ok(val, x) for x in ts):
            errs.append("%s: expected %s, got %s" % (path, "/".join(ts), type(val).__name__))
            return errs
    if isinstance(val, str) and "pattern" in schema and not re.search(schema["pattern"], val):
        errs.append("%s: does not match %s" % (path, schema["pattern"]))
    if isinstance(val, str) and "minLength" in schema and len(val) < schema["minLength"]:
        errs.append("%s: must not be empty" % path)
    if isinstance(val, (int, float)) and not isinstance(val, bool) and "minimum" in schema \
            and val < schema["minimum"]:
        errs.append("%s: below minimum %s" % (path, schema["minimum"]))
    if isinstance(val, (int, float)) and not isinstance(val, bool) and "maximum" in schema \
            and val > schema["maximum"]:
        errs.append("%s: above maximum %s" % (path, schema["maximum"]))
    if isinstance(val, dict):
        for k in schema.get("required", []):
            if k not in val:
                errs.append("%s: missing required key '%s'" % (path, k))
        props = schema.get("properties", {})
        addl = schema.get("additionalProperties", True)
        for k, v in val.items():
            if k in props:
                errs += validate(v, props[k], "%s.%s" % (path, k))
            elif isinstance(addl, dict):
                errs += validate(v, addl, "%s.%s" % (path, k))
            elif addl is False:
                errs.append("%s: unexpected key '%s'" % (path, k))
    if isinstance(val, list) and "items" in schema:
        for i, item in enumerate(val):
            errs += validate(item, schema["items"], "%s[%d]" % (path, i))
    return errs


# ---------------------------------------------------------------- pricing

def load_pricing(path):
    p = load_json(path)
    for k in ("version", "per_million"):
        if k not in p:
            raise ValueError("pricing table %s lacks '%s'" % (path, k))
    return p


def price_for(pricing, model):
    """exact id -> id with trailing -YYYYMMDD stripped -> longest key that prefixes the id."""
    table = pricing["per_million"]
    if model in table:
        return table[model]
    base = re.sub(r"-\d{8}$", "", model)
    if base in table:
        return table[base]
    best = None
    for k in table:
        if model.startswith(k) and (best is None or len(k) > len(best)):
            best = k
    return table[best] if best else None


def cell_cost(p, inp, out, cr, cc):
    return (inp * p.get("input", 0) + out * p.get("output", 0)
            + cr * p.get("cache_read", 0) + cc * p.get("cache_creation", 0)) / 1e6


def codex_split(x):
    """Codex `cached_input_tokens` is a SUBSET of `input_tokens` (OpenAI prompt_tokens_details.cached_tokens;
    the collector's `total_tokens` = input + output). Returns non-overlapping (uncached input, cached input)
    so the two are never added twice (#203)."""
    inp, cached = x.get("input", 0) or 0, x.get("cached_input", 0) or 0
    cached = min(cached, inp)
    return inp - cached, cached


def codex_cost(pricing, x):
    p = (pricing.get("codex") or {}).get("default")
    if not p:
        return None
    uncached, cached = codex_split(x)
    return (uncached * p.get("input", 0) + cached * p.get("cached_input", 0)
            + x.get("output", 0) * p.get("output", 0)) / 1e6


def _add_cost(a, b):
    if a is None:
        return b
    if b is None:
        return a
    return a + b


def _round(v):
    return None if v is None else round(v, 6)


# ---------------------------------------------------------------- cost file (actual / allocated / 归属)

COST_FILE_KEYS = ("actual", "allocated", "allocation", "shared_costs", "confirmed_by")


def load_cost_file(path, schema):
    """A billing-owner supplied JSON: {actual, allocated, allocation, shared_costs, confirmed_by}.
    Validated piecewise against the submission schema; allocation ratios must sum to 100.
    Returns (dict, errors)."""
    try:
        cf = load_json(path)
    except (OSError, json.JSONDecodeError) as e:
        return None, ["--cost-file unreadable: %s" % e]
    if not isinstance(cf, dict):
        return None, ["--cost-file must be a JSON object"]
    errs = ["cost-file: unexpected key '%s'" % k for k in cf if k not in COST_FILE_KEYS]
    cprops, qprops = schema["properties"]["cost"]["properties"], schema["properties"]["quality"]["properties"]
    errs += validate(cf.get("actual"), cprops["actual"], "cost.actual")
    errs += validate(cf.get("allocated"), cprops["allocated"], "cost.allocated")
    errs += validate(cf.get("allocation", []), qprops["allocation"], "quality.allocation")
    errs += validate(cf.get("shared_costs", []), qprops["shared_costs"], "quality.shared_costs")
    cb = cf.get("confirmed_by") or {}
    if not isinstance(cb, dict) or any(k not in ("billing", "attribution") for k in cb):
        errs.append("quality.confirmed_by: only 'billing' / 'attribution' may come from the cost file")
    alloc = cf.get("allocation") or []
    if alloc and abs(sum(a.get("ratio", 0) for a in alloc if isinstance(a, dict)) - 100) > 1e-9:
        errs.append("quality.allocation: ratios must sum to 100 (归属守恒), got %s"
                    % sum(a.get("ratio", 0) for a in alloc if isinstance(a, dict)))
    return cf, errs


# ---------------------------------------------------------------- ingest (T2, #196): platform export + bills
# Both are *usage* / *bill* sources next to the local log. Rules (report-contract.md § Sources):
#   - platform export rows become cells (day × model) in bucket "platform" (the platform does not know
#     the repo; project attribution stays a local-log thing, never guessed);
#   - a (day, model) present in both sources is counted ONCE — the platform record wins, the local
#     cells for it are dropped and counted as `superseded`;
#   - a platform-reported cost column is kept apart (`sources[].reported_cost`, 性质待核实) — it is
#     NOT `cost.actual`; only a bill / ledger writes `cost.actual`;
#   - a column the mapping does not know makes the run exit 2 naming it; so does an unknown currency.

MAPPING_REL = os.path.join("skills", "ai-usage-weekly", "assets", "platform-export.mapping.json")
BILL_NATURES = ("api", "seat", "gpu", "shared")


def _norm_col(name):
    return re.sub(r"\s+", " ", str(name or "").strip().lower())


def read_table(path, sheet=None):
    """(headers, rows) from .csv (utf-8 / utf-8-sig) or .xlsx (first sheet, or the sheet named `sheet`;
    zipfile + xml, no dependency)."""
    ext = os.path.splitext(path)[1].lower()
    if ext in (".csv", ".tsv", ".txt"):
        import csv
        with open(path, encoding="utf-8-sig", newline="") as fh:
            sample = fh.read(4096)
            fh.seek(0)
            dialect = csv.excel_tab if ext == ".tsv" or ("\t" in sample and "," not in sample) else csv.excel
            rows = list(csv.reader(fh, dialect))
        rows = [r for r in rows if any(c.strip() for c in r)]
        if not rows:
            return [], []
        return [c.strip() for c in rows[0]], [[c.strip() for c in r] for r in rows[1:]]
    if ext in (".xlsx", ".xlsm"):
        return _read_xlsx(path, sheet)
    if sheet:
        raise ValueError("%s is not an xlsx file — sheet %r needs one" % (os.path.basename(path), sheet))
    raise ValueError("unsupported table format %r (csv / tsv / xlsx)" % ext)


def _xlsx_sheet_part(z, name):
    """Worksheet part for the sheet called `name` (workbook.xml → its relationship target)."""
    import xml.etree.ElementTree as ET
    m = "{http://schemas.openxmlformats.org/spreadsheetml/2006/main}"
    r = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}"
    sheets = {s.get("name"): s.get(r + "id") for s in ET.fromstring(z.read("xl/workbook.xml")).iter(m + "sheet")}
    if name not in sheets:
        raise ValueError("no sheet %r (sheets: %s)" % (name, ", ".join(repr(s) for s in sheets)))
    for rel in ET.fromstring(z.read("xl/_rels/workbook.xml.rels")):
        if rel.get("Id") == sheets[name]:
            target = rel.get("Target")
            return target.lstrip("/") if target.startswith("/") else "xl/" + target
    raise ValueError("sheet %r has no worksheet part" % name)


def _read_xlsx(path, sheet_name=None):
    import zipfile
    import xml.etree.ElementTree as ET
    ns = {"m": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
    with zipfile.ZipFile(path) as z:
        shared = []
        if "xl/sharedStrings.xml" in z.namelist():
            for si in ET.fromstring(z.read("xl/sharedStrings.xml")).findall("m:si", ns):
                shared.append("".join(t.text or "" for t in si.iter("{%s}t" % ns["m"])))
        if sheet_name:
            sheet = _xlsx_sheet_part(z, sheet_name)
        else:
            sheet = sorted(n for n in z.namelist() if re.match(r"xl/worksheets/sheet\d+\.xml$", n))[0]
        root = ET.fromstring(z.read(sheet))
    grid = {}
    for c in root.iter("{%s}c" % ns["m"]):
        ref, t = c.get("r"), c.get("t")
        col = re.match(r"([A-Z]+)(\d+)", ref)
        v = c.find("m:v", ns)
        if t == "s" and v is not None:
            val = shared[int(v.text)]
        elif t == "inlineStr":
            val = "".join(x.text or "" for x in c.iter("{%s}t" % ns["m"]))
        else:
            val = v.text if v is not None else ""
        grid.setdefault(int(col.group(2)), {})[col.group(1)] = (val or "").strip()

    def colnum(s):
        n = 0
        for ch in s:
            n = n * 26 + ord(ch) - 64
        return n
    rownums = sorted(grid)
    if not rownums:
        return [], []
    width = max(colnum(k) for r in grid.values() for k in r)
    def row(r):
        out = [""] * width
        for k, v in grid.get(r, {}).items():
            out[colnum(k) - 1] = v
        return out
    header = row(rownums[0])
    return header, [row(r) for r in rownums[1:] if any(row(r))]


def load_mapping(path):
    m = load_json(path)
    for k in ("columns", "currencies", "date_formats"):
        if k not in m:
            raise ValueError("mapping %s lacks '%s'" % (path, k))
    return m


def map_columns(headers, mapping, section="columns", required=("day", "model"), ignore_key="ignore"):
    """header index per canonical field of mapping[section]; raises ValueError naming any column the
    mapping does not know, or a required field the headers lack."""
    alias = {}
    for field, names in mapping[section].items():
        for n in names:
            alias[_norm_col(n)] = field
        alias[_norm_col(field)] = field
    ignore = {_norm_col(x) for x in mapping.get(ignore_key, [])}
    idx, unknown = {}, []
    for i, h in enumerate(headers):
        key = _norm_col(h)
        if key in alias:
            idx.setdefault(alias[key], i)
        elif key in ignore or not key:
            continue
        else:
            unknown.append(h)
    if unknown:
        raise ValueError("unknown column(s) %s — add them to %s (%s / %s); the tool never guesses"
                         % (", ".join(repr(u) for u in unknown), MAPPING_REL, section, ignore_key))
    for need in required:
        if need not in idx:
            raise ValueError("export has no '%s' column (aliases: %s)" % (need, ", ".join(mapping[section][need])))
    return idx


def _parse_day(txt, mapping):
    for f in mapping["date_formats"]:
        try:
            return datetime.strptime(txt.strip(), f).date()
        except ValueError:
            continue
    raise ValueError("unparseable date %r (formats: %s)" % (txt, ", ".join(mapping["date_formats"])))


def _num(txt):
    txt = str(txt or "").strip().replace(",", "")
    if txt == "":
        return 0
    v = float(txt)
    return int(v) if v.is_integer() else v


def platform_cells(path, mapping, since, until, user_filter=None):
    """Rows → cells for one person (user_filter = human_id / platform id; None = take every row).
    Returns (cells, info) where info feeds usage.sources[]."""
    headers, rows = read_table(path)
    idx = map_columns(headers, mapping)
    cells, cost, cur, skipped_users, out_of_window = {}, None, None, 0, 0
    get = lambda r, f, d="": (r[idx[f]] if f in idx and idx[f] < len(r) else d)
    for r in rows:
        if user_filter is not None and "user" in idx and get(r, "user") != user_filter:
            skipped_users += 1
            continue
        day = _parse_day(get(r, "day"), mapping)
        if day < since or day > until:
            out_of_window += 1
            continue
        model = get(r, "model").strip() or "unknown"
        key = (day.isoformat(), model)
        c = cells.setdefault(key, {"day": key[0], "model": model, "bucket": "platform", "requests": 0, "input": 0,
                                   "output": 0, "cache_read": 0, "cache_creation": 0, "source": "platform-export"})
        c["requests"] += int(_num(get(r, "requests", "1")) or 0) if "requests" in idx else 1
        for f in ("input", "output", "cache_read", "cache_creation"):
            c[f] += int(_num(get(r, f, "0")) or 0)
        if "cost" in idx and get(r, "cost") != "":
            cost = (cost or 0) + float(_num(get(r, "cost")))
            rc = (get(r, "currency") or "USD").strip().upper() if "currency" in idx else "USD"
            if rc not in mapping["currencies"]:
                raise ValueError("unknown currency %r in export (known: %s)" % (rc, ", ".join(mapping["currencies"])))
            cur = rc if cur in (None, rc) else "mixed"
    info = {"type": "platform-export", "name": os.path.basename(path), "since": since.isoformat(), "until": until.isoformat(),
            "records": len(cells), "skipped_other_users": skipped_users, "out_of_window": out_of_window,
            "reported_cost": ({"amount": round(cost, 6), "currency": cur, "note": "平台报告金额,性质待核实,不是账单"} if cost is not None else None)}
    return list(cells.values()), info


def platform_cells_by_user(path, mapping, since, until):
    """Whole-team export → {platform user: cells}. Rows without a user column go under ''. """
    headers, rows = read_table(path)
    idx = map_columns(headers, mapping)
    users = sorted({(r[idx["user"]] if "user" in idx and idx["user"] < len(r) else "") for r in rows})
    out = {}
    for u in users:
        cells, info = platform_cells(path, mapping, since, until, user_filter=u if "user" in idx else None)
        if cells:
            out[u] = (cells, info)
    return out


def read_bills(path, mapping, since, until):
    """Bill / ledger rows → (actual block, allocated block, info). CSV or JSON (list or {"bills": [...]}).
    Subscriptions are prorated to the report week by service-period overlap and say so in `basis`."""
    cols = mapping.get("bill_columns", ["source", "nature", "currency", "amount", "since", "until", "confirmed"])
    ext = os.path.splitext(path)[1].lower()
    if ext == ".json":
        raw = load_json(path)
        rows = raw.get("bills") if isinstance(raw, dict) else raw
        if not isinstance(rows, list):
            raise ValueError("bill JSON must be a list or {\"bills\": [...]}")
        recs = [{k: r.get(k) for k in cols} for r in rows]
    else:
        headers, rows = read_table(path)
        hidx = {_norm_col(h): i for i, h in enumerate(headers)}
        missing = [c for c in cols if c not in hidx]
        if missing:
            raise ValueError("bill file lacks column(s) %s (needs %s)" % (", ".join(missing), ", ".join(cols)))
        recs = [{c: (r[hidx[c]] if hidx[c] < len(r) else "") for c in cols} for r in rows]
    if not recs:
        raise ValueError("bill file has no rows")
    total, alloc, natures, currency, confirmed, srcs, lo, hi, basis = 0.0, 0.0, set(), None, True, [], None, None, []
    items_actual, items_alloc = [], []
    for r in recs:
        cur = str(r.get("currency") or "").strip().upper()
        if cur not in mapping["currencies"]:
            raise ValueError("unknown currency %r in bill (known: %s)" % (r.get("currency"), ", ".join(mapping["currencies"])))
        if currency not in (None, cur):
            raise ValueError("bills mix currencies (%s vs %s) — one currency per submission; keep the original and convert in a note" % (currency, cur))
        currency = cur
        nat = str(r.get("nature") or "").strip().lower()
        if nat not in BILL_NATURES:
            raise ValueError("bill nature %r must be one of %s" % (r.get("nature"), ", ".join(BILL_NATURES)))
        natures.add(nat)
        amt = float(_num(r.get("amount")))
        p_since, p_until = _parse_day(str(r.get("since")), mapping), _parse_day(str(r.get("until")), mapping)
        if p_until < p_since:
            raise ValueError("bill period ends before it starts: %s..%s" % (p_since, p_until))
        conf = str(r.get("confirmed")).strip().lower() in ("true", "1", "yes", "y", "是")
        confirmed = confirmed and conf
        period_days = (p_until - p_since).days + 1
        ov_s, ov_u = max(p_since, since), min(p_until, until)
        overlap = max(0, (ov_u - ov_s).days + 1)
        share = amt * overlap / period_days
        total += amt
        alloc += share
        srcs.append(str(r.get("source") or "").strip())
        lo = p_since if lo is None else min(lo, p_since)
        hi = p_until if hi is None else max(hi, p_until)
        basis.append("%s: %s × %d/%d 天" % (srcs[-1], "%.2f" % amt, overlap, period_days))
        # One item per bill row, so a review can match a single bill_ref and a budget month can
        # intersect each bill's own service period — never the merged block (#203).
        per = {"since": p_since.isoformat(), "until": p_until.isoformat()}
        items_actual.append({"source": srcs[-1], "amount": round(amt, 6), "nature": nat, "period": per})
        items_alloc.append({"source": srcs[-1], "amount": round(share, 6), "nature": nat, "period": per})
    nature = natures.pop() if len(natures) == 1 else "shared"
    actual = {"amount": round(total, 6), "currency": currency, "nature": nature, "source": "; ".join(srcs),
              "period": {"since": lo.isoformat(), "until": hi.isoformat()}, "confirmed": confirmed, "items": items_actual}
    allocated = {"amount": round(alloc, 6), "currency": currency, "nature": nature, "source": "; ".join(srcs),
                 "period": {"since": since.isoformat(), "until": until.isoformat()}, "confirmed": confirmed,
                 "basis": "按服务周期折算到报告周: " + "; ".join(basis), "items": items_alloc}
    info = {"type": "actual-bill", "name": os.path.basename(path), "since": lo.isoformat(), "until": hi.isoformat(),
            "records": len(recs)}
    return actual, allocated, info


_ALLOC_NUMERIC = ("tokens", "token_share", "original_cost", "cost_usd",
                  "total_original", "total_usd", "allocated_usd", "unallocated_usd", "vk_count")


def _allocation_sheet(path, mapping, which, section, required):
    headers, rows = read_table(path, mapping["allocation_sheets"][which])
    idx = map_columns(headers, mapping, section, required, "allocation_ignore")
    out = []
    for n, r in enumerate(rows, start=2):
        rec = {}
        for field, i in idx.items():
            v = r[i] if i < len(r) else ""
            if field in _ALLOC_NUMERIC:
                try:
                    v = _num(v)
                except ValueError:
                    raise ValueError("sheet %r row %d: %s is not a number (%r)"
                                     % (mapping["allocation_sheets"][which], n, field, v))
            rec[field] = v
        cur = rec.get("currency")
        if cur and cur not in mapping["currencies"]:
            raise ValueError("unknown currency %r in sheet %r row %d (known: %s)"
                             % (cur, mapping["allocation_sheets"][which], n, ", ".join(mapping["currencies"])))
        out.append(rec)
    return out


def read_allocation(path, mapping):
    """The monthly LiteLLM key allocation file → (spend rows, summary rows), one dict per row with the
    canonical field names of allocation_columns / allocation_summary_columns. Raises ValueError on an
    unknown column, a missing sheet or column, a non-number amount, or an unknown currency."""
    spend = _allocation_sheet(path, mapping, "spend", "allocation_columns",
                              ("vk", "team", "provider", "model", "cost_usd"))
    summary = _allocation_sheet(path, mapping, "summary", "allocation_summary_columns",
                                ("provider", "model", "total_usd"))
    return spend, summary


def local_cells(usage):
    """Collector cells → the common cell shape (source local-usage-log). Never carries paths / session ids."""
    out = []
    for c in ((usage or {}).get("claude") or {}).get("cells", []):
        out.append({"day": c["day"], "model": c["model"], "bucket": c["bucket"], "requests": c.get("messages", 0),
                    "input": c.get("input", 0), "output": c.get("output", 0), "cache_read": c.get("cache_read", 0),
                    "cache_creation": c.get("cache_creation", 0), "source": "local-usage-log"})
    return out


def merge_cells(local, platform):
    """择一计入: a (day, model) the platform reports replaces every local cell for it. Returns (cells, superseded)."""
    covered = {(c["day"], c["model"]) for c in platform}
    kept = [c for c in local if (c["day"], c["model"]) not in covered]
    dropped = {(c["day"], c["model"]) for c in local if (c["day"], c["model"]) in covered}
    return kept + list(platform), len(dropped)  # superseded = distinct (day, model) pairs


def merge_platform_exports(previous, incoming):
    """Same precedence for submit/team: later files replace overlapping (day, model) cells.
    Keep each export's original amount for audit; overlapping file totals cannot be added."""
    if previous is None:
        return incoming
    cells, replaced = merge_cells(previous[0], incoming[0])
    prior, info = previous[1], incoming[1]
    exports = (prior.get("exports") or [prior]) + [info]
    return cells, {
        "type": "platform-export", "name": " + ".join(x["name"] for x in exports),
        "since": info["since"], "until": info["until"], "records": len(cells),
        "skipped_other_users": sum(x.get("skipped_other_users", 0) for x in exports),
        "out_of_window": sum(x.get("out_of_window", 0) for x in exports),
        "overlapping_exports": prior.get("overlapping_exports", 0) + replaced,
        "reported_cost": None, "exports": exports,
        "note": "多个导出按(日×模型)以后传入文件为准;各文件原始报告金额保留在 exports,不合计",
    }


def rollup(cells, pricing, inferred_buckets=None):
    """cells → by_day / by_model / by_bucket / totals / estimate parts. Codex is added by the caller."""
    by_day, by_model, by_bucket, unpriced, total_cost = {}, {}, {}, [], None
    tot = {"requests": 0, "input": 0, "output": 0, "cache_read": 0, "cache_creation": 0}
    for cell in cells:
        p = price_for(pricing, cell["model"]) if pricing else None
        cost = cell_cost(p, cell["input"], cell["output"], cell["cache_read"], cell["cache_creation"]) if p else None
        if p is None and cell["model"] not in unpriced:
            unpriced.append(cell["model"])
        total_cost = _add_cost(total_cost, cost)
        d = by_day.setdefault(cell["day"], {"requests": 0, "input": 0, "output": 0, "cache_read": 0, "cache_creation": 0, "cost": None})
        m = by_model.setdefault(cell["model"], {"requests": 0, "input": 0, "output": 0, "cache_read": 0, "cache_creation": 0, "cost": None})
        b = by_bucket.setdefault(cell["bucket"], {"requests": 0, "tokens": 0, "cost": None,
                                                  "inferred": bool((inferred_buckets or {}).get(cell["bucket"]))})
        for tgt in (d, m, tot):
            for k in ("requests", "input", "output", "cache_read", "cache_creation"):
                tgt[k] += cell[k]
        d["cost"] = _add_cost(d["cost"], cost)
        m["cost"] = _add_cost(m["cost"], cost)
        b["requests"] += cell["requests"]
        b["tokens"] += cell["input"] + cell["output"] + cell["cache_read"] + cell["cache_creation"]
        b["cost"] = _add_cost(b["cost"], cost)
    return {"by_day": dict(sorted(by_day.items())), "by_model": by_model, "by_bucket": by_bucket,
            "totals": tot, "unpriced": unpriced, "cost": total_cost}


# ---------------------------------------------------------------- submit

def run_collectors(args, since, until, root, out_dir, timezone=None):
    """Run token-usage-report / token-usage-tasks for the window; return (usage, tasks|None, err).
    The declared team timezone is handed to the collectors via TZ so that each message lands on the
    day of its own event time in that zone (cross-week sessions split there, not at session start)."""
    env = dict(os.environ)
    if timezone:
        env["TZ"] = timezone
    base = [sys.executable or "python3", os.path.join(_HERE, "token-usage-report"), "--since", since.isoformat(),
            "--until", until.isoformat(), "--json", "--out", out_dir, "--workspace-root", root,
            "--claude-dir", args.claude_dir, "--codex-dir", args.codex_dir, "--qoder-dir", args.qoder_dir,
            "--source", args.source]
    r = subprocess.run(base, capture_output=True, text=True, env=env)
    if r.returncode != 0:
        return None, None, (r.stdout + r.stderr).strip()
    usage = load_json(os.path.join(out_dir, "usage-report-%s-%s.json" % (since.isoformat(), until.isoformat())))
    tcmd = [sys.executable or "python3", os.path.join(_HERE, "token-usage-tasks"), "report", "--since", since.isoformat(),
            "--until", until.isoformat(), "--json", "--out", out_dir, "--workspace-root", root,
            "--claude-dir", args.claude_dir, "--db", os.path.join(out_dir, "annotations.sqlite")]
    t = subprocess.run(tcmd, capture_output=True, text=True, env=env)
    tasks = None
    if t.returncode == 0:
        tp = os.path.join(out_dir, "tasks-%s-%s.json" % (since.isoformat(), until.isoformat()))
        if os.path.isfile(tp):
            tasks = load_json(tp)
    return usage, tasks, ""


QODER_NOTE = "Qoder 只记录积分,没有 token:积分来自本机日志,未与账单核对;不换算为 token,不计入请求数与估算费用"


def qoder_agent(q):
    """Collector Qoder block → usage.by_agent.qoder (credits only, rounded; never paths / session ids)."""
    if not q or not (q.get("totals") or {}).get("messages"):
        return None
    r4 = lambda v: round(v, 4)
    return {"messages": q["totals"]["messages"], "credits": r4(q["totals"]["credits"]), "sessions": q.get("sessions", 0),
            "by_day": {d: {"messages": v["messages"], "credits": r4(v["credits"])} for d, v in sorted((q.get("by_day") or {}).items())},
            "by_bucket": {b: {"messages": v["messages"], "credits": r4(v["credits"]), "inferred": bool(v.get("inferred"))}
                          for b, v in (q.get("by_bucket") or {}).items()},
            "confirmed": False, "note": QODER_NOTE}


def credits(v):
    """Qoder credits for display; None (no Qoder use) is a dash, never 0."""
    if v is None:
        return "—"
    return "%.4f" % v if 0 < v < 0.01 else "%.2f" % v


def build_submission(usage, tasks, pricing, meta, cost_file=None, platform=None, bill=None):
    """usage: collector JSON (or {} when there is none); platform: (cells, info) from --platform-export;
    bill: (actual, allocated, info) from --bill. Three amounts stay apart; sources are bookkept."""
    usage = usage or {}
    c = usage.get("claude") or {}
    x = usage.get("codex") or {}
    ct, xt = c.get("totals", {}), x.get("totals", {})
    qd = qoder_agent(usage.get("qoder"))
    loc = local_cells(usage)
    plat_cells, plat_info = platform if platform else ([], None)
    cells, superseded = merge_cells(loc, plat_cells)
    r = rollup(cells, pricing, c.get("by_bucket"))
    by_day, by_model, by_bucket, unpriced, total_cost, tot = (r["by_day"], r["by_model"], r["by_bucket"],
                                                              r["unpriced"], r["cost"], r["totals"])
    sources = []
    if loc or xt.get("sessions") or qd:
        src = {"type": "local-usage-log", "name": "claude+codex" + ("+qoder" if qd else ""), "since": meta["since"],
               "until": meta["until"], "records": len(loc), "superseded": superseded}
        if qd:
            src["note"] = "Qoder %d 条消息,%s 积分(%s)" % (qd["messages"], credits(qd["credits"]), QODER_NOTE)
        sources.append(src)
    if plat_info:
        sources.append(plat_info)
    if bill:
        sources.append(bill[2])

    if xt.get("sessions"):
        xcost = codex_cost(pricing, xt)
        if xcost is None:
            unpriced.append("codex")
        total_cost = _add_cost(total_cost, xcost)
        x_in, x_cr = codex_split(xt)
        by_model["codex"] = {"requests": xt.get("sessions", 0), "input": x_in,
                             "output": xt.get("output", 0), "cache_read": x_cr,
                             "cache_creation": 0, "cost": _round(xcost)}
        for bk, bv in (x.get("by_bucket") or {}).items():
            b = by_bucket.setdefault(bk, {"requests": 0, "tokens": 0, "cost": None,
                                          "inferred": bool(bv.get("inferred"))})
            b["requests"] += bv.get("sessions", 0)
            b["tokens"] += bv.get("input", 0) + bv.get("output", 0)  # cached_input ⊆ input
            b["cost"] = _add_cost(b["cost"], codex_cost(pricing, bv))

    for tbl in (by_day, by_model, by_bucket):
        for v in tbl.values():
            v["cost"] = _round(v["cost"])

    x_in, x_cr = codex_split(xt) if xt.get("sessions") else (0, 0)
    inp = tot["input"] + x_in
    cr = tot["cache_read"] + x_cr
    cc = tot["cache_creation"]
    denom = tot["input"] + tot["cache_read"] + tot["cache_creation"]
    est_source = "+".join(t for t in ("local-usage-log", "platform-export")
                          if any(sc["type"] == t for sc in sources)) or "local-usage-log"
    note = ("cells (local usage log%s) × pricing table; Codex: session totals × codex.default"
            " (no daily granularity — Codex is not in by_day)" % (" + platform export, 择一计入" if plat_info else ""))
    if "codex" in unpriced:
        note += "; Codex unpriced (codex.default is null)"
    if qd:
        note += "; Qoder: credits only, not in this estimate"
    cf = cost_file or {}
    cb = cf.get("confirmed_by") or {}
    actual = bill[0] if bill else cf.get("actual")
    allocated = bill[1] if bill else cf.get("allocated")
    # Sources this submission should have but does not — shown as 待接入 / 待核实, never as 0.
    missing = []
    if not plat_info:
        missing.append("platform-export")
    if not actual:
        missing.append("actual-bill")
    if not loc and not xt.get("sessions") and not qd:
        missing.append("local-usage-log")
    if not usage.get("git"):
        missing.append("git")
    return {
        "meta": meta,
        "usage": {
            "requests": tot["requests"] + xt.get("sessions", 0),
            "input": inp, "output": tot["output"] + xt.get("output", 0),
            "cache_read": cr, "cache_creation": cc,
            "cache_hit_rate": (tot["cache_read"] / denom) if denom else None,
            "sessions": c.get("sessions", {}).get("count", 0) + xt.get("sessions", 0),
            "task_instances": len((tasks or {}).get("tasks", [])),
            "by_day": by_day,
            "by_model": by_model,
            "by_bucket": by_bucket,
            "by_agent": {
                "claude": ({"messages": ct.get("messages", 0), "input": ct.get("input", 0),
                            "output": ct.get("output", 0), "cache_read": ct.get("cache_read", 0),
                            "cache_creation": ct.get("cache_creation", 0)} if c else None),
                "codex": ({"sessions": xt.get("sessions", 0), "input": xt.get("input", 0),
                           "cached_input": xt.get("cached_input", 0), "output": xt.get("output", 0),
                           "reasoning": xt.get("reasoning", 0),
                           "note": "collector totals: cached_input ⊆ input, reasoning ⊆ output (raw, overlapping)"} if x else None),
                "qoder": qd,
            },
            "sources": sources,
            "cells": cells,
        },
        "cost": {
            # 估算: usage cells × price table. An estimate, never a bill — shown with its pricing
            # version, never summed with actual/allocated, never in 核算/报销 or budget totals.
            "estimated": {"amount": _round(total_cost), "currency": "USD", "nature": "api",
                          "source": est_source, "method": "price-table",
                          "pricing_version": str(pricing["version"]), "unpriced_models": unpriced,
                          "period": {"since": meta["since"], "until": meta["until"]},
                          "confirmed": False, "note": note},
            "actual": actual,
            "allocated": allocated,
        },
        "git": {k: {"commits": v.get("commits", 0), "insertions": v.get("insertions", 0),
                    "deletions": v.get("deletions", 0)} for k, v in (usage.get("git") or {}).items()},
        "quality": {
            "missing_sources": missing,
            "unpriced_models": list(unpriced),
            "shared_costs": cf.get("shared_costs") or [],
            "allocation": cf.get("allocation") or [],
            "confirmed_by": {"member": None, "billing": cb.get("billing"), "attribution": cb.get("attribution")},
        },
        "narrative": None,
    }


def usd(v):
    """Estimate cells: never print a non-zero figure as $0.00 (that reads as 'nothing')."""
    if v is None:
        return "未定价"
    return "$%.4f" % v if 0 < v < 0.01 else "$%.2f" % v


def money(blk):
    if not blk or blk.get("amount") is None:
        return "待核实"
    v = blk["amount"]
    return ("%.4f %s" if 0 < v < 0.01 else "%.2f %s") % (v, blk.get("currency", ""))


def money_row(blk):
    """(value, nature, source, confirmed) for a 实际/分摊 block; 待核实 when absent — never 0."""
    if not blk:
        return ("待核实", "—", "待接入", "—")
    return (money(blk), blk.get("nature", "—"), blk.get("source", "—"), "已确认" if blk.get("confirmed") else "未确认")


def pct(v):
    return "—" if v is None else "%.1f%%" % (v * 100)


def render_personal_md(s):
    m, u, c, g, n, q = s["meta"], s["usage"], s["cost"], s["git"], s["narrative"], s["quality"]
    e = c["estimated"]
    qd = (u.get("by_agent") or {}).get("qoder")
    L = ["# AI 使用周小结 %s — %s (%s)" % (m["week"], m["human_id"], m["team"]), "",
         "周期 %s ~ %s (%s) · 业务/职能 %s · 提交版本 v%s · 生成 %s · 数据源 %s · 工具版本 ws-%s" % (
             m["since"], m["until"], m["timezone"], m["business"] or "—", m["submission_version"],
             m["generated_at"][:16], m["base_source"], (m["workspace_sha"] or "unknown")[:6]),
         "", "## 用量 / 费用", "",
         "| 指标 | 值 |", "|---|---|",
         "| 请求数 (Claude 消息 + Codex 会话) | %s |" % fmt(u["requests"]),
         "| Token 总吞吐 (input+output+cache) | %s |" % fmt(u["input"] + u["output"] + u["cache_read"] + u["cache_creation"]),
         "| 其中 output | %s |" % fmt(u["output"]),
         "| 缓存命中率 (Claude) | %s |" % pct(u["cache_hit_rate"]),
         "| 会话 / 任务实例 | %s / %s |" % (u["sessions"], u["task_instances"]),
         "| Qoder 积分(本机日志,未核对账单) | %s |" % (("%s(%s 条消息)" % (credits(qd["credits"]), fmt(qd["messages"]))) if qd else "—"),
         "", "### 三种金额(分列展示,不相加)", "",
         "| 金额 | 值 | 性质 | 来源 | 确认 |", "|---|---|---|---|---|",
         "| **估算费用** | **%s** · 估算,非账单(价格表 %s) | %s | %s × 价格表 | 未确认 |" % (
             money(e), e["pricing_version"], e["nature"],
             {"local-usage-log": "本机 usage 日志", "platform-export": "平台导出",
              "local-usage-log+platform-export": "本机日志 + 平台导出(择一计入)"}.get(e.get("source"), e.get("source"))),
         "| 实际费用 | %s | %s | %s | %s |" % money_row(c["actual"]),
         "| 分摊费用 | %s | %s | %s | %s |" % money_row(c["allocated"]),
         ""]
    if e["unpriced_models"]:
        L.append("> 未定价模型(只计 token 不计费): %s" % ", ".join(e["unpriced_models"]))
        L.append("")
    if u.get("sources"):
        L += ["### 数据来源", "", "| 来源 | 名称 | 覆盖 | 记录 | 备注 |", "|---|---|---|---|---|"]
        for sc in u["sources"]:
            notes = [sc["note"]] if sc.get("note") else []
            if sc.get("superseded"):
                notes.append("%d 个(日×模型)被平台记录替代(择一计入)" % sc["superseded"])
            if sc.get("skipped_other_users"):
                notes.append("跳过他人行 %d" % sc["skipped_other_users"])
            if sc.get("out_of_window"):
                notes.append("窗口外 %d" % sc["out_of_window"])
            if sc.get("reported_cost"):
                rc = sc["reported_cost"]
                notes.append("平台报告金额 %s %s(性质待核实,不是账单)" % (rc["amount"], rc.get("currency") or ""))
            L.append("| %s | %s | %s ~ %s | %s | %s |" % (sc["type"], sc.get("name", ""), sc.get("since", ""), sc.get("until", ""),
                                                        sc.get("records", ""), "; ".join(notes) or "—"))
        L.append("")
    L += ["### 按模型", "", "| 模型 | 请求 | input | output | 估算费用 |", "|---|---|---|---|---|"]
    L[L.index("| 模型 | 请求 | input | output | 估算费用 |")] = "| 模型 | 请求 | input | output | 估算费用(估算) |"
    for k, v in sorted(u["by_model"].items(), key=lambda kv: -kv[1]["requests"]):
        L.append("| %s | %s | %s | %s | %s |" % (k, fmt(v["requests"]), fmt(v["input"]), fmt(v["output"]), usd(v["cost"])))
    L += ["", "### 按项目 (bucket)", "", "| 项目 | 请求 | token | 估算费用 | commits |", "|---|---|---|---|---|"]
    for k, v in sorted(u["by_bucket"].items(), key=lambda kv: -kv[1]["tokens"]):
        tag = " # inferred" if v.get("inferred") else ""
        L.append("| %s%s | %s | %s | %s | %s |" % (k, tag, fmt(v["requests"]), fmt(v["tokens"]), usd(v["cost"]),
                                                  g.get(k, {}).get("commits", 0)))
    L += ["", "### 每日", "", "| 日期 | 请求 | output | 估算费用 |", "|---|---|---|---|"]
    for k, v in u["by_day"].items():
        L.append("| %s | %s | %s | %s |" % (k, fmt(v["requests"]), fmt(v["output"]), usd(v["cost"])))
    if qd:
        L += ["", "### Qoder 积分", "", "> " + QODER_NOTE, "", "| 日期 | 消息 | 积分 |", "|---|---|---|"]
        for k, v in qd["by_day"].items():
            L.append("| %s | %s | %s |" % (k, fmt(v["messages"]), credits(v["credits"])))
        L += ["", "| 项目 | 消息 | 积分 |", "|---|---|---|"]
        for k, v in sorted(qd["by_bucket"].items(), key=lambda kv: -kv[1]["credits"]):
            L.append("| %s%s | %s | %s |" % (k, " # inferred" if v.get("inferred") else "", fmt(v["messages"]), credits(v["credits"])))
    L += ["", "## 质量与归属", "",
          "- 缺失来源: %s" % (", ".join(q["missing_sources"]) or "无"),
          "- 未定价模型: %s" % (", ".join(q["unpriced_models"]) or "无"),
          "- 共享费用: %s" % ("; ".join("%s %s %s" % (x["description"], x["amount"], x["currency"]) for x in q["shared_costs"]) or "无"),
          "- 分摊比例: %s" % ("; ".join("%s %s%%" % (a["target"], a["ratio"]) for a in q["allocation"]) or "无(归属本人)"),
          "- 确认状态: 成员 %s · 账单 %s · 归属 %s" % tuple(q["confirmed_by"][k] or "待确认" for k in ("member", "billing", "attribution")),
          "", "## 使用内容 / 产生的价值", ""]
    if not n:
        L.append("_叙事待补 — 用 `scripts/ai-usage-weekly submit --week %s --narrative <file>` 补齐。_" % m["week"])
    else:
        L.append(n["summary"])
        for p in n["projects"]:
            L += ["", "### %s — %s" % (p["name"], p["headline"]),
                  "状态: %s · 价值: %s" % (" / ".join(p.get("status") or []) or "—", p.get("value") or "—"), ""]
            for t in p["tasks"]:
                tags = " · ".join(x for x in (t.get("ai_role"), t.get("deliverable"), t.get("status")) if x)
                L.append("- **%s** %s%s" % (t["title"], t.get("detail", ""), (" (%s)" % tags) if tags else ""))
                if t.get("evidence"):
                    L.append("  - 证据: %s" % t["evidence"])
            for r in p.get("risks") or []:
                L.append("- 风险: %s" % r)
        for title, key in (("值得复用的方法", "reusable_methods"), ("效果不好的尝试", "failed_experiments"),
                           ("工具 / 模型 / 额度问题", "issues"), ("下一步资源需求", "resource_needs")):
            if n.get(key):
                L += ["", "### " + title, ""] + ["- " + x for x in n[key]]
        if n.get("next_actions"):
            L += ["", "### 建议跟进", "", "| 优先级 | 事项 | 验收 |", "|---|---|---|"]
            for a in n["next_actions"]:
                L.append("| %s | %s | %s |" % (a["priority"], a["item"], a.get("acceptance", "")))
    items = checklist(s)
    L += ["", "## 提交前需要补齐", ""] + (["%d. %s → `%s`" % (i + 1, t, f) for i, (t, f) in enumerate(items)] or ["✓ 无待补项"])
    L += ["", "---", "估算费用 = 本机 usage 日志 × 价格表,是估算不是账单,不进核算/报销/预算;实际与分摊费用只来自账单。"
          "三种金额不相加。个人用量不是绩效输入。数据不含 prompt、路径与会话 id。", ""]
    return "\n".join(L)


def cmd_submit(args):
    root = os.path.abspath(args.workspace_root) if args.workspace_root else os.path.dirname(_HERE)
    tool_root = os.path.dirname(_HERE)
    try:
        since, until, week = resolve_window(args.week, args.since, args.until)
    except ValueError as e:
        print("FAIL: %s" % e)
        return 2
    owner, team, business = workspace_identity(root)
    if _placeholder(owner) or _placeholder(team):
        print("FAIL: workspace.yaml owner/team must be filled (owner=%r team=%r) — people are accountable"
              % (owner, team))
        return 2
    reports_dir = os.path.abspath(args.reports_dir) if args.reports_dir else os.path.join(root, REPORTS_REL)
    if not ensure_reports_dir(reports_dir, tool_root, create=True):
        return 2
    try:
        pricing = load_pricing(args.pricing or os.path.join(tool_root, PRICING_REL))
    except (OSError, ValueError, json.JSONDecodeError) as e:
        print("FAIL: pricing table unusable: %s" % e)
        return 2
    schema = load_json(os.path.join(tool_root, SCHEMA_REL))

    cost_file = None
    if args.cost_file:
        cost_file, errs = load_cost_file(args.cost_file, schema)
        if errs:
            print("FAIL: --cost-file rejected:\n  " + "\n  ".join(errs))
            return 2

    timezone = args.timezone or local_timezone()
    platform = bill = None
    if args.platform_export or args.bill:
        try:
            mapping = load_mapping(args.mapping or os.path.join(tool_root, MAPPING_REL))
        except (OSError, ValueError, json.JSONDecodeError) as e:
            print("FAIL: platform-export mapping unusable: %s" % e)
            return 2
        try:
            if args.platform_export:
                for pth in args.platform_export:
                    cs, info = platform_cells(pth, mapping, since, until, user_filter=args.platform_user or owner)
                    platform = merge_platform_exports(platform, (cs, info))
            if args.bill:
                bill = read_bills(args.bill, mapping, since, until)
        except (OSError, ValueError) as e:
            print("FAIL: %s" % e)
            return 2
        if bill and cost_file and (cost_file.get("actual") or cost_file.get("allocated")):
            print("FAIL: --bill and --cost-file both carry actual/allocated — keep one source for the bill")
            return 2

    narrative = None
    if args.narrative:
        try:
            narrative = load_json(args.narrative)
        except (OSError, json.JSONDecodeError) as e:
            print("FAIL: --narrative unreadable: %s" % e)
            return 2
        errs = validate(narrative, schema["properties"]["narrative"]["oneOf"][1], "narrative")
        if errs:
            print("FAIL: narrative does not follow assets/narrative.example.json:\n  " + "\n  ".join(errs))
            return 2

    out_dir = args.out or os.path.join(root, "runs", "token-usage")
    os.makedirs(out_dir, exist_ok=True)
    usage, tasks, err = run_collectors(args, since, until, root, out_dir, timezone)
    if usage is None and not (platform and platform[0]):
        print("FAIL: collectors found no usage in %s..%s and no platform export rows — nothing to submit (%s)" % (since, until, err))
        return 2
    if usage is None:
        usage = {}

    week_dir = os.path.join(reports_dir, "reports", week)
    jp = os.path.join(week_dir, owner + ".json")
    mp = os.path.join(week_dir, owner + ".md")
    # Re-submitting the same week replaces the record and bumps submission_version.
    version = 1
    if os.path.isfile(jp):
        try:
            version = int(load_json(jp).get("meta", {}).get("submission_version", 0)) + 1
        except (OSError, json.JSONDecodeError, TypeError, ValueError):
            version = 1
    meta = {"schema_version": SCHEMA_VERSION, "week": week, "since": since.isoformat(),
            "until": until.isoformat(), "human_id": owner, "team": team,
            "business": business or None, "timezone": timezone,
            "submission_version": version,
            "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
            "workspace_sha": git_head(root), "tool": "ai-usage-weekly",
            "base_source": usage.get("meta", {}).get("base_source", "native" if usage else "platform-export")}
    sub = build_submission(usage, tasks, pricing, meta, cost_file, platform, bill)
    sub["narrative"] = narrative
    if narrative:
        sub["quality"]["confirmed_by"]["member"] = owner  # the narrative is what the person confirmed
    errs = validate(sub, schema)
    if errs:
        print("FAIL: built submission violates the schema (tool bug):\n  " + "\n  ".join(errs))
        return 2

    os.makedirs(week_dir, exist_ok=True)
    with open(jp, "w", encoding="utf-8") as fh:
        json.dump(sub, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    with open(mp, "w", encoding="utf-8") as fh:
        fh.write(render_personal_md(sub))
    hp = os.path.join(week_dir, owner + ".html")
    with open(hp, "w", encoding="utf-8") as fh:
        fh.write(render_personal_html(sub))
    todo = checklist(sub)
    print("OK: submission v%d written: %s (+ .md + .html) — requests %s, 估算费用 %s (估算,非账单), 实际费用 %s%s" % (
        version, jp, fmt(sub["usage"]["requests"]), money(sub["cost"]["estimated"]), money(sub["cost"]["actual"]),
        "" if narrative else "; 叙事待补(--narrative)"))
    if sub["cost"]["estimated"]["unpriced_models"]:
        print("NOTE: 未定价模型 %s — 补 %s 后重跑" % (", ".join(sub["cost"]["estimated"]["unpriced_models"]), PRICING_REL))
    if sub["quality"]["missing_sources"]:
        print("NOTE: 缺失来源 %s — 页面显示待接入/待核实,不填零" % ", ".join(sub["quality"]["missing_sources"]))
    if todo:
        print("TODO: 提交前需要补齐 %d 项(见 .html/.md 页末):" % len(todo))
        for t, f in todo:
            print("  - %s  [%s]" % (t, f))
    if args.open:
        import webbrowser
        webbrowser.open("file://" + hp)

    if args.commit:
        rel = [os.path.relpath(p, reports_dir) for p in (jp, mp, hp)]
        if subprocess.run(["git", "-C", reports_dir, "rev-parse", "--git-dir"], capture_output=True).returncode != 0:
            print("WARN: --commit skipped: %s is not a git checkout" % reports_dir)
        else:
            subprocess.run(["git", "-C", reports_dir, "add", "--"] + rel, check=False)
            r = subprocess.run(["git", "-C", reports_dir, "commit", "-q", "-m",
                                "ai-usage-weekly: %s %s" % (owner, week)], capture_output=True, text=True)
            print("OK: committed in %s" % reports_dir if r.returncode == 0
                  else "WARN: nothing to commit or commit failed: %s" % (r.stdout + r.stderr).strip())
    print("NEXT: review %s, then push / open the PR your team uses — this tool never pushes." % mp)
    return 0


# ---------------------------------------------------------------- team (T4, #198)
# Reads reports/<week>/*.json, validates each (v2 strictly; v1 leniently, normalised to the v2
# shape), aggregates, runs the six checks, renders team-report.html + team-report.md beside the
# submissions. People are listed in name order — never by cost. Missing data is shown as
# 待接入 / 待核实, never as 0. Every estimate carries 估算 + the pricing-table version.

V1_REQUIRED = {"meta": ("week", "since", "until", "human_id", "team"),
               "usage": ("requests", "input", "output", "cache_read", "cache_creation", "by_day", "by_model", "by_bucket"),
               "cost": ("estimated_usd", "pricing_version", "unpriced_models")}


def normalize_v1(s):
    """Lift a schema-v1 file to the v2 shape (read-compat only; the tool never writes v1)."""
    m, c = s["meta"], s["cost"]
    est = {"amount": c.get("estimated_usd"), "currency": "USD", "nature": "api", "source": "local-usage-log",
           "method": "price-table", "pricing_version": str(c.get("pricing_version", "?")),
           "unpriced_models": list(c.get("unpriced_models") or []),
           "period": {"since": m["since"], "until": m["until"]}, "confirmed": False, "note": c.get("note", "")}
    n = s.get("narrative")
    return {
        "meta": dict(m, schema_version=1, business=None, timezone=None, submission_version=1),
        "usage": s["usage"], "git": s.get("git") or {},
        "cost": {"estimated": est, "actual": None, "allocated": None},
        "quality": {"missing_sources": ["platform-export", "actual-bill"], "unpriced_models": est["unpriced_models"],
                    "shared_costs": [], "allocation": [],
                    "confirmed_by": {"member": m["human_id"] if n else None, "billing": None, "attribution": None}},
        "narrative": n,
    }


def week_window_error(meta, week):
    """A week label cannot stand in for its actual Monday-Sunday reporting window."""
    since, until, _ = resolve_window(week, None, None)
    if meta.get("since") != since.isoformat() or meta.get("until") != until.isoformat():
        return "since/until is %s..%s, expected ISO week %s: %s..%s" % (
            meta.get("since"), meta.get("until"), week, since, until)
    return None


def load_week(reports_dir, week, schema):
    """Returns (submissions sorted by human_id, rejected [(file, reason)]). A broken file never stops the run."""
    week_dir = os.path.join(reports_dir, "reports", week)
    subs, rejected = [], []
    if not os.path.isdir(week_dir):
        return subs, rejected
    for fn in sorted(os.listdir(week_dir)):
        if not fn.endswith(".json") or fn.startswith("team-report"):
            continue
        path = os.path.join(week_dir, fn)
        try:
            raw = load_json(path)
        except (OSError, json.JSONDecodeError) as e:
            rejected.append((fn, "not readable JSON: %s" % e))
            continue
        if not isinstance(raw, dict):
            rejected.append((fn, "not a JSON object"))
            continue
        ver = (raw.get("meta") or {}).get("schema_version")
        if ver == 1:
            missing = ["%s.%s" % (blk, k) for blk, keys in V1_REQUIRED.items()
                       for k in keys if k not in (raw.get(blk) or {})]
            if missing or "narrative" not in raw:
                rejected.append((fn, "schema v1 file lacks: %s" % ", ".join(missing or ["narrative"])))
                continue
            sub = normalize_v1(raw)
        else:
            errs = validate(raw, schema)
            if errs:
                rejected.append((fn, "schema v2: " + "; ".join(errs[:3]) + (" …" if len(errs) > 3 else "")))
                continue
            sub = raw
        if sub["meta"]["week"] != week:
            rejected.append((fn, "meta.week is %s, expected %s" % (sub["meta"]["week"], week)))
            continue
        window_error = week_window_error(sub["meta"], week)
        if window_error:
            rejected.append((fn, window_error))
            continue
        sub["_file"] = fn
        subs.append(sub)
    subs.sort(key=lambda s: s["meta"]["human_id"].lower())  # name order — never by cost
    return subs, rejected


def apply_platform(sub, cells, info, pricing):
    """Merge a lead's platform rows into an existing submission at (day, model) grain — the platform
    record wins. A file without usage.cells (v1) cannot be deduped at that grain, so the platform
    record replaces its usage rollups wholesale (noted in sources). by_bucket is left as the
    person's own attribution reference (the platform does not know repos)."""
    u, c = sub["usage"], sub["cost"]
    local = u.get("cells") or []
    if local:
        merged, superseded = merge_cells(local, cells)
        note = "择一计入: %d 个(日×模型)由平台记录替代" % superseded
    else:
        merged, superseded = list(cells), None
        note = "文件无 cells(v1),平台记录整体替代其用量;项目归属仍取文件"
    r = rollup(merged, pricing)
    codex = (u.get("by_model") or {}).get("codex")
    by_model = r["by_model"]
    tot = r["totals"]
    est = r["cost"]
    if codex:
        by_model["codex"] = codex
        for k in ("requests", "input", "output", "cache_read", "cache_creation"):
            tot[k] += codex.get(k, 0)
        est = _add_cost(est, codex.get("cost"))
    for tbl in (r["by_day"], by_model):
        for v in tbl.values():
            v["cost"] = _round(v["cost"])
    denom = r["totals"]["input"] + r["totals"]["cache_read"] + r["totals"]["cache_creation"]
    u.update({"requests": tot["requests"], "input": tot["input"], "output": tot["output"], "cache_read": tot["cache_read"],
              "cache_creation": tot["cache_creation"], "cache_hit_rate": (r["totals"]["cache_read"] / denom) if denom else None,
              "by_day": r["by_day"], "by_model": by_model, "cells": merged})
    u.setdefault("sources", []).append(dict(info, superseded=superseded, note=note))
    e = c["estimated"]
    e.update({"amount": _round(est), "source": "local-usage-log+platform-export" if local else "platform-export",
              "unpriced_models": r["unpriced"] + (["codex"] if codex and codex.get("cost") is None else []),
              "pricing_version": str(pricing["version"]), "note": (e.get("note") or "") + "; " + note})
    q = sub["quality"]
    q["missing_sources"] = [m for m in q["missing_sources"] if m != "platform-export"]
    q["unpriced_models"] = list(e["unpriced_models"])
    sub["_platform"] = True
    return sub


def synthesize_platform_submission(human_id, cells, info, pricing, team, week, since, until):
    """A member the platform saw but who has not submitted: usage only, narrative 待提交."""
    r = rollup(cells, pricing)
    for tbl in (r["by_day"], r["by_model"], r["by_bucket"]):
        for v in tbl.values():
            v["cost"] = _round(v["cost"])
    t = team if team and not team.get("_broken") else {}
    tot = r["totals"]
    denom = tot["input"] + tot["cache_read"] + tot["cache_creation"]
    return {
        "meta": {"schema_version": SCHEMA_VERSION, "week": week, "since": since.isoformat(), "until": until.isoformat(),
                 "human_id": human_id, "team": t.get("team") or "—", "business": t.get("business"), "timezone": t.get("timezone"),
                 "submission_version": 0, "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
                 "workspace_sha": "", "tool": "ai-usage-weekly", "base_source": "platform-export"},
        "usage": {"requests": tot["requests"], "input": tot["input"], "output": tot["output"], "cache_read": tot["cache_read"],
                  "cache_creation": tot["cache_creation"], "cache_hit_rate": (tot["cache_read"] / denom) if denom else None,
                  "sessions": 0, "task_instances": 0, "by_day": r["by_day"], "by_model": r["by_model"], "by_bucket": r["by_bucket"],
                  "by_agent": {"claude": None, "codex": None}, "sources": [info], "cells": list(cells)},
        "cost": {"estimated": {"amount": _round(r["cost"]), "currency": "USD", "nature": "api", "source": "platform-export",
                               "method": "price-table", "pricing_version": str(pricing["version"]), "unpriced_models": r["unpriced"],
                               "period": {"since": since.isoformat(), "until": until.isoformat()}, "confirmed": False,
                               "note": "platform export cells × pricing table (估算,非账单)"},
                 "actual": None, "allocated": None},
        "git": {},
        "quality": {"missing_sources": ["actual-bill", "local-usage-log", "git"], "unpriced_models": list(r["unpriced"]),
                    "shared_costs": [], "allocation": [], "confirmed_by": {"member": None, "billing": None, "attribution": None}},
        "narrative": None, "_platform_only": True, "_file": None,
    }


def load_team_json(reports_dir):
    p = os.path.join(reports_dir, "reports", "team.json")
    if not os.path.isfile(p):
        return None
    try:
        t = load_json(p)
    except (OSError, json.JSONDecodeError):
        return {"_broken": True}
    return t if isinstance(t, dict) else {"_broken": True}


def _sum_into(tgt, src, keys):
    for k in keys:
        tgt[k] = tgt.get(k, 0) + (src.get(k) or 0)


def aggregate(subs, rejected, team, since=None, until=None, platform_infos=None):
    """Everything the two renderers need. Sums are over accepted submissions (+ platform-only rows)."""
    a = {"since": since.isoformat() if since else None, "until": until.isoformat() if until else None,
         "platform_infos": platform_infos or [], "requests_new": [], "requests_due": [], "requests_bad": [], "budget": None, "people": [], "requests": 0, "input": 0, "output": 0, "cache_read": 0, "cache_creation": 0,
         "claude_input": 0, "claude_cache_read": 0, "claude_cache_creation": 0, "sessions": 0, "task_instances": 0,
         "by_day": {}, "by_model": {}, "by_bucket": {}, "git": {}, "est_total": None, "est_unpriced": [],
         "pricing_versions": [], "actual_confirmed": 0, "actual_given": 0, "actual_sum": {}, "allocated_sum": {},
         "methods": [], "failed": [], "issues": [], "resource_needs": [], "next_actions": [],
         "deliverables": {}, "no_evidence": 0, "rejected": rejected, "team": team,
         "qoder_credits": None, "qoder_messages": 0, "qoder_by_bucket": {}}
    for s in subs:
        m, u, c, q, n = s["meta"], s["usage"], s["cost"], s["quality"], s["narrative"]
        hid = m["human_id"]
        _sum_into(a, u, ("requests", "input", "output", "cache_read", "cache_creation", "sessions", "task_instances"))
        cl = (u.get("by_agent") or {}).get("claude") or {}
        qd = (u.get("by_agent") or {}).get("qoder")
        if qd:
            a["qoder_credits"] = (a["qoder_credits"] or 0) + qd.get("credits", 0)
            a["qoder_messages"] += qd.get("messages", 0)
            for b, v in (qd.get("by_bucket") or {}).items():
                d = a["qoder_by_bucket"].setdefault(b, {"messages": 0, "credits": 0, "people": []})
                d["messages"] += v.get("messages", 0)
                d["credits"] += v.get("credits", 0)
                if hid not in d["people"]:
                    d["people"].append(hid)
        a["claude_input"] += cl.get("input", 0)
        a["claude_cache_read"] += cl.get("cache_read", 0)
        a["claude_cache_creation"] += cl.get("cache_creation", 0)
        for day, v in u["by_day"].items():
            d = a["by_day"].setdefault(day, {"requests": 0, "output": 0, "cost": None})
            d["requests"] += v.get("requests", 0)
            d["output"] += v.get("output", 0)
            d["cost"] = _add_cost(d["cost"], v.get("cost"))
        for model, v in u["by_model"].items():
            d = a["by_model"].setdefault(model, {"requests": 0, "cost": None})
            d["requests"] += v.get("requests", 0)
            d["cost"] = _add_cost(d["cost"], v.get("cost"))
        for b, v in u["by_bucket"].items():
            d = a["by_bucket"].setdefault(b, {"requests": 0, "tokens": 0, "cost": None, "people": [], "commits": 0})
            d["requests"] += v.get("requests", 0)
            d["tokens"] += v.get("tokens", 0)
            d["cost"] = _add_cost(d["cost"], v.get("cost"))
            d["people"].append(hid)
        for b, g in (s.get("git") or {}).items():
            d = a["by_bucket"].setdefault(b, {"requests": 0, "tokens": 0, "cost": None, "people": [], "commits": 0})
            d["commits"] += g.get("commits", 0)
            if hid not in d["people"]:
                d["people"].append(hid)
        e = c["estimated"]
        a["est_total"] = _add_cost(a["est_total"], e.get("amount"))
        for um in e.get("unpriced_models") or []:
            if um not in a["est_unpriced"]:
                a["est_unpriced"].append(um)
        if e.get("pricing_version") not in a["pricing_versions"]:
            a["pricing_versions"].append(e.get("pricing_version"))
        act, alloc = c.get("actual"), c.get("allocated")
        if act and act.get("amount") is not None:
            a["actual_given"] += 1
            if act.get("confirmed"):
                a["actual_confirmed"] += 1
                cur = act.get("currency", "?")
                a["actual_sum"][cur] = a["actual_sum"].get(cur, 0) + act["amount"]
        if alloc and alloc.get("amount") is not None:
            cur = alloc.get("currency", "?")
            a["allocated_sum"][cur] = a["allocated_sum"].get(cur, 0) + alloc["amount"]
        person = {"human_id": hid, "team": m.get("team"), "business": m.get("business"), "requests": u["requests"],
                  "tokens": u["input"] + u["output"] + u["cache_read"] + u["cache_creation"],
                  "estimated": e, "actual": act, "allocated": alloc, "quality": q, "narrative": n,
                  "qoder_credits": qd.get("credits") if qd else None,
                  "git_commits": sum(g.get("commits", 0) for g in (s.get("git") or {}).values()),
                  "buckets": sorted(u["by_bucket"], key=lambda k: -u["by_bucket"][k].get("tokens", 0)),
                  "schema_version": m.get("schema_version"), "timezone": m.get("timezone"),
                  "week": m["week"], "since": m["since"], "until": m["until"],
                  "platform_only": bool(s.get("_platform_only")), "platform": bool(s.get("_platform") or s.get("_platform_only")),
                  "sources": u.get("sources") or []}
        a["people"].append(person)
        if n:
            for key, tgt in (("reusable_methods", "methods"), ("failed_experiments", "failed"),
                             ("issues", "issues"), ("resource_needs", "resource_needs")):
                a[tgt] += [(hid, x) for x in (n.get(key) or [])]
            a["next_actions"] += [dict(x, who=hid) for x in (n.get("next_actions") or [])]
            for p in n.get("projects") or []:
                for t in p.get("tasks") or []:
                    ev = (t.get("evidence") or "").strip()
                    if not ev:
                        a["no_evidence"] += 1
                        key = "%s::%s::%s" % (hid, p["name"], t["title"])
                    else:
                        key = "%s::%s" % (p["name"], ev)  # same evidence across people → one deliverable
                    d = a["deliverables"].setdefault(key, {"project": p["name"], "title": t["title"], "evidence": ev,
                                                           "status": t.get("status") or " / ".join(p.get("status") or []),
                                                           "people": []})
                    if hid not in d["people"]:
                        d["people"].append(hid)
    a["by_day"] = dict(sorted(a["by_day"].items()))
    prio = {"high": 0, "mid": 1, "low": 2}
    a["next_actions"].sort(key=lambda x: (prio.get(x.get("priority"), 9), x["who"]))
    a["cache_hit_rate"] = (a["claude_cache_read"] / (a["claude_input"] + a["claude_cache_read"] + a["claude_cache_creation"])
                           if (a["claude_input"] + a["claude_cache_read"] + a["claude_cache_creation"]) else None)
    # coverage — only when a roster exists; otherwise 待接入, never 0/0
    if team and not team.get("_broken") and isinstance(team.get("members"), list):
        members = [str(x) for x in team["members"]]
        submitted = [p["human_id"] for p in a["people"] if not p["platform_only"]]
        a["members"] = members
        a["not_submitted"] = [x for x in members if x not in submitted]
        a["not_in_roster"] = [x for x in submitted if x not in members]
        a["rate"] = (len([x for x in members if x in submitted]), len(members))
    else:
        a["members"] = None
        a["not_submitted"] = None
        a["not_in_roster"] = []
        a["rate"] = None
    return a


def run_checks(a, week):
    """The six pre-aggregation checks. status: ok | warn | fail. A fail never blocks rendering —
    it is flagged at the top of the page and listed in the footer."""
    people = a["people"]
    out = []
    # 1 来源不重复
    ids = [p["human_id"].lower() for p in people]
    dups = sorted({x for x in ids if ids.count(x) > 1})
    sup = sum((sc.get("superseded") or 0) for p in people for sc in p["sources"] if sc["type"] in ("local-usage-log", "platform-export"))
    out.append(("来源不重复", "fail" if dups else "ok",
                "重复的成员文件: %s" % ", ".join(dups) if dups
                else ("每位成员一份记录;本机日志与平台导出重叠的(日×模型)择一计入,共 %d 处" % sup if a["platform_infos"] or sup
                      else "每位成员一份记录;无平台导出,未做跨来源去重")))
    # 2 周期一致
    bad_week = [p["human_id"] for p in people if p["week"] != week]
    bad_window = ["%s: %s" % (p["human_id"], week_window_error(p, week))
                  for p in people if week_window_error(p, week)]
    tzs = sorted({p["timezone"] for p in people if p["timezone"]})
    unknown_tz = [p["human_id"] for p in people if not p["timezone"]]
    team_tz = (a["team"] or {}).get("timezone") if a["team"] and not a["team"].get("_broken") else None
    tz_bad = len(tzs) > 1 or (team_tz and tzs and tzs != [team_tz])
    st = "fail" if (bad_week or bad_window or tz_bad) else ("warn" if unknown_tz else "ok")
    detail = []
    if bad_week:
        detail.append("周不一致: %s" % ", ".join(bad_week))
    if bad_window:
        detail.append("起止日期不一致: %s" % "; ".join(bad_window))
    if tz_bad:
        detail.append("时区不一致: %s%s" % (", ".join(tzs), " (团队: %s)" % team_tz if team_tz else ""))
    if unknown_tz:
        detail.append("未声明时区 (v1 文件): %s" % ", ".join(unknown_tz))
    out.append(("周期一致", st, "; ".join(detail) or "所有提交同一周 %s,时区 %s" % (week, ", ".join(tzs) or "—")))
    # 3 金额可解释
    bad = []
    for p in people:
        e = p["estimated"]
        if e.get("amount") is not None and not e.get("pricing_version"):
            bad.append("%s 估算无价格表版本" % p["human_id"])
        for name, blk in (("实际", p["actual"]), ("分摊", p["allocated"])):
            if blk and (not blk.get("currency") or not blk.get("nature")):
                bad.append("%s %s费用缺币种/性质" % (p["human_id"], name))
    out.append(("金额可解释", "fail" if bad else "ok",
                "; ".join(bad) or "估算 / 实际 / 分摊分列,币种与性质保留,价格表 %s" % ", ".join(str(v) for v in a["pricing_versions"])))
    # 4 归属守恒
    bad = []
    for p in people:
        al = p["quality"].get("allocation") or []
        if al:
            tot = sum(x.get("ratio", 0) for x in al)
            if abs(tot - 100) > 1e-9:
                bad.append("%s 分摊合计 %s%%" % (p["human_id"], tot))
    out.append(("归属守恒", "fail" if bad else "ok", "; ".join(bad) or "有分摊的成员比例合计均为 100%"))
    # 5 缺失可见 — informational: the four kinds are listed separately, never folded into 0
    no_bill = [p["human_id"] for p in people if not p["actual"]]
    zero_actual = [p["human_id"] for p in people if p["actual"] and p["actual"].get("amount") == 0]
    out.append(("缺失可见", "ok",
                "未提交 %s · 采集失败/未纳入 %d · 缺账单 %d · 实际为零 %d" % (
                    len(a["not_submitted"]) if a["not_submitted"] is not None else "待接入",
                    len(a["rejected"]), len(no_bill), len(zero_actual))))
    # 6 成果有依据
    out.append(("成果有依据", "warn" if a["no_evidence"] else "ok",
                "%d 项无证据的任务" % a["no_evidence"] if a["no_evidence"] else "所有任务都有证据链接"))
    return out


def default_summary(a):
    top = sorted(a["by_bucket"].items(), key=lambda kv: -kv[1]["tokens"])[:3]
    return ("%d 人提交;总请求 %s;估算总费用 %s(估算,价格表 %s,非账单);最活跃项目 %s;commits %d。"
            % (len(a["people"]), fmt(a["requests"]), money({"amount": a["est_total"], "currency": "USD"}) if a["est_total"] is not None else "待核实",
               ", ".join(str(v) for v in a["pricing_versions"]) or "—",
               ", ".join(k for k, _ in top) or "—", sum(v["commits"] for v in a["by_bucket"].values())))


def actual_line(a):
    if not a["people"]:
        return "待接入"
    sums = " + ".join("%.2f %s" % (v, k) for k, v in sorted(a["actual_sum"].items())) or "待核实"
    return "%d/%d 已确认 · %s" % (a["actual_confirmed"], len(a["people"]), sums)


def coverage_line(a):
    if a["rate"] is None:
        return "待接入(reports/team.json 未提供名单)"
    return "%d/%d 已提交" % a["rate"]


# --- markdown

def render_team_md(a, week, checks, summary, ws_sha):
    fails = [c for c in checks if c[1] == "fail"]
    team_name = (a["team"] or {}).get("team") if a["team"] and not a["team"].get("_broken") else (a["people"][0]["team"] if a["people"] else "—")
    since = a["since"] or (a["people"][0]["since"] if a["people"] else "—")
    until = a["until"] or (a["people"][0]["until"] if a["people"] else "—")
    L = ["# 团队 AI 使用汇总 %s — %s" % (week, team_name), "",
         "周期 %s ~ %s · 生成 %s · 工具版本 ws-%s · 提交 %s" % (
             since, until, datetime.now().astimezone().isoformat(timespec="minutes"), (ws_sha or "unknown")[:6], coverage_line(a)), ""]
    if fails:
        L += ["> **校验未通过:** " + "; ".join("%s — %s" % (c[0], c[2]) for c in fails), ""]
    if a["platform_infos"]:
        L += ["数据来源: 平台导出 %s(用量以平台记录为准,与个人本机日志重叠处择一计入;本机日志只是估算)" % "; ".join(
            "%s(%d 行,%d 人)" % (i["name"], i["rows"], i["users"]) for i in a["platform_infos"]), ""]
    L += ["## 管理摘要", "", summary, "",
          "## KPI", "", "| 指标 | 值 |", "|---|---|",
          "| 总请求 | %s |" % fmt(a["requests"]),
          "| 总 token(缓存命中率 Claude) | %s (%s) |" % (fmt(a["input"] + a["output"] + a["cache_read"] + a["cache_creation"]), pct(a["cache_hit_rate"])),
          "| **估算总费用**(估算,价格表 %s,非账单) | %s |" % (", ".join(str(v) for v in a["pricing_versions"]) or "—",
                                                    money({"amount": a["est_total"], "currency": "USD"}) if a["est_total"] is not None else "待核实"),
          "| 实际费用确认情况(账单) | %s |" % actual_line(a),
          "| 活跃项目 | %d |" % len(a["by_bucket"]),
          "| commits | %d |" % sum(v["commits"] for v in a["by_bucket"].values()),
          "| 团队覆盖 | %s |" % coverage_line(a)]
    if a["qoder_credits"] is not None:
        L.append("| Qoder 积分合计(本机日志,未核对账单,不计入估算) | %s(%s 条消息) |" % (credits(a["qoder_credits"]), fmt(a["qoder_messages"])))
    L.append("")
    if a["est_unpriced"]:
        L += ["> 未定价模型(只计 token): %s" % ", ".join(a["est_unpriced"]), ""]
    L += ["## 每日", "", "| 日期 | 请求 | output | 估算费用 |", "|---|---|---|---|"]
    for d, v in a["by_day"].items():
        L.append("| %s | %s | %s | %s |" % (d, fmt(v["requests"]), fmt(v["output"]), usd(v["cost"])))
    L += ["", "## 模型分布(按请求)", "", "| 模型 | 请求 | 估算费用 |", "|---|---|---|"]
    for k, v in sorted(a["by_model"].items(), key=lambda kv: -kv[1]["requests"]):
        L.append("| %s | %s | %s |" % (k, fmt(v["requests"]), usd(v["cost"])))
    L += ["", "## 按成员(名称序,不按费用排名)", "",
          "| 成员 | 请求 | token | Qoder 积分 | 估算费用(估算) | 实际费用 | 分摊费用 | 项目 | commits | 确认 |", "|---|---|---|---|---|---|---|---|---|---|"]
    for p in a["people"]:
        cb = p["quality"]["confirmed_by"]
        L.append("| %s | %s | %s | %s | %s | %s | %s | %s | %d | %s |" % (
            p["human_id"] + (" (平台)" if p["platform"] else ""), fmt(p["requests"]), fmt(p["tokens"]), credits(p["qoder_credits"]),
            money(p["estimated"]),
            money(p["actual"]) + (" (%s)" % p["actual"]["nature"] if p["actual"] else ""),
            money(p["allocated"]), ", ".join(p["buckets"][:3]) or "—", p["git_commits"],
            "成员 %s · 账单 %s · 归属 %s" % tuple("✓" if cb.get(k) else "待" for k in ("member", "billing", "attribution"))))
    if a["not_in_roster"]:
        L += ["", "> 名单外的提交: %s" % ", ".join(a["not_in_roster"])]
    L += ["", "## 按成员卡片", ""]
    for p in a["people"]:
        n = p["narrative"]
        L += ["### %s%s" % (p["human_id"], "(仅平台用量)" if p["platform_only"] else ""), ""]
        if not n:
            L += ["_叙事待提交。_" if p["platform_only"] else "_叙事待补。_", ""]
            continue
        L += [n.get("summary", ""), ""]
        for pr in n.get("projects") or []:
            L.append("- **%s** — %s" % (pr["name"], pr.get("headline", "")))
            for t in pr.get("tasks") or []:
                L.append("  - %s%s" % (t["title"], (" · 证据: %s" % t["evidence"]) if t.get("evidence") else " · _无证据_"))
        L.append("")
    L += ["## 按项目", "", "| 项目 | 请求 | token | 估算费用 | commits | 参与 | 交付物(去重) |", "|---|---|---|---|---|---|---|"]
    for b, v in sorted(a["by_bucket"].items(), key=lambda kv: -kv[1]["tokens"]):
        dl = [d for d in a["deliverables"].values() if d["project"] == b]
        L.append("| %s | %s | %s | %s | %d | %s | %d |" % (b, fmt(v["requests"]), fmt(v["tokens"]), usd(v["cost"]), v["commits"],
                                                       ", ".join(v["people"]), len(dl)))
    if a["qoder_by_bucket"]:
        L += ["", "### Qoder 积分(按项目)", "", "| 项目 | 消息 | 积分 | 参与 |", "|---|---|---|---|"]
        for b, v in sorted(a["qoder_by_bucket"].items(), key=lambda kv: -kv[1]["credits"]):
            L.append("| %s | %s | %s | %s |" % (b, fmt(v["messages"]), credits(v["credits"]), ", ".join(v["people"])))
    L += ["", "### 交付物(同一证据多人参与只计一次)", ""]
    for d in a["deliverables"].values():
        L.append("- [%s] %s — %s · %s · %s" % (d["project"], d["title"], d["evidence"] or "无证据", d["status"] or "—", " / ".join(d["people"])))
    for title, key in (("值得学习", "methods"), ("效果不好的尝试", "failed"), ("问题清单", "issues"), ("资源需求", "resource_needs")):
        L += ["", "## " + title, ""] + (["- %s (%s)" % (x, who) for who, x in a[key]] or ["- 无"])
    L += ["", "### 本周新申请(reports/requests/)", ""] + (
        ["- %s · %s · %s %s · %s 至 %s · %s · %s" % (r["human_id"], KIND_LABEL[r["kind"]], r["resource"], r["project"], r["start"], r["end"],
                                                   STATUS_LABEL[r["status"]], "%s %s" % (r["amount"], r["currency"])) for r in a["requests_new"]] or ["- 无"])
    L += ["", "### 待复评(30 天内到期的续费,尚无复评结论)", ""] + (
        ["- %s · %s · 到期 %s · %s · 复评前带出历史投入 / 利用情况 / 成果" % (r["human_id"], r["resource"], r["end"], RENEWAL_LABEL[r["renewal"]]) for r in a["requests_due"]] or ["- 无"])
    if a["requests_bad"]:
        L += ["", "> 申请文件未纳入: " + "; ".join("%s (%s)" % b for b in a["requests_bad"])]
    L += ["", "## 建议跟进", "", "| 优先级 | 事项 | 验收 | 谁 |", "|---|---|---|---|"]
    for x in a["next_actions"]:
        L.append("| %s | %s | %s | %s |" % (x.get("priority"), x.get("item"), x.get("acceptance", ""), x["who"]))
    L += [""] + budget_md(a.get("budget"))
    L += ["", "## 六项校验", "", "| 校验 | 结果 | 说明 |", "|---|---|---|"]
    for name, st, detail in checks:
        L.append("| %s | %s | %s |" % (name, {"ok": "通过", "warn": "提醒", "fail": "未通过"}[st], detail))
    L += ["", "## 未纳入 / 未提交", ""]
    L += ["- 未纳入: " + ("; ".join("%s (%s)" % r for r in a["rejected"]) if a["rejected"] else "无")]
    L += ["- 未提交: " + (", ".join(a["not_submitted"]) if a["not_submitted"] else ("无" if a["not_submitted"] == [] else "待接入(无名单)"))]
    L += ["", "---", "估算费用 = 本机 usage 日志 × 价格表,是估算不是账单,不进核算/报销/预算;实际费用只来自账单。三种金额不相加。"
          "成员按名称序展示,个人用量不是绩效输入。数据不含 prompt、路径与会话 id。", ""]
    return "\n".join(L)


# --- html (self-contained: inline CSS + inline SVG; the only script is the theme toggle)

def esc(x):
    return html_mod.escape(str(x if x is not None else ""), quote=True)


