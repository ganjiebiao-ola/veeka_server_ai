.tag{display:inline-block;font-size:12px;padding:1px 8px;border-radius:999px;border:1px solid var(--line);color:var(--ink2);margin-right:4px}
.ok{color:var(--good)}.warn{color:#8a6000}.fail{color:var(--crit)}
svg text{fill:var(--ink2);font-size:11px}svg .axis{stroke:var(--line)}svg .bar{fill:var(--s1)}svg .bar:hover{opacity:.85}
.legend{display:flex;flex-wrap:wrap;gap:10px;font-size:13px;color:var(--ink2)}.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:5px;vertical-align:-1px}
footer{margin-top:40px;color:var(--muted);font-size:12px;border-top:1px solid var(--line);padding-top:12px}
button{font:inherit;font-size:13px;padding:4px 10px;border-radius:6px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}
@media print{button{display:none}}
"""

_JS = """
(function(){var b=document.getElementById('theme');b.addEventListener('click',function(){var r=document.documentElement;
r.dataset.theme=(r.dataset.theme==='dark')?'light':'dark';});})();
"""

_SERIES = ["--s1", "--s2", "--s3", "--s4", "--s5", "--s6", "--s7", "--s8"]


def svg_bars(rows, value_key, label_fn, title, fmt_fn):
    """Single-series vertical bars, direct-labelled, native <title> tooltips. rows: list of (label, dict)."""
    if not rows:
        return '<div class="card"><h3>%s</h3><p class="meta">待接入</p></div>' % esc(title)
    W, H, pad_l, pad_b, pad_t = 520, 200, 8, 28, 22
    n = len(rows)
    mx = max((r[1].get(value_key) or 0) for r in rows) or 1
    gap, bw = 2, max(6, (W - pad_l * 2) / n - 2)
    out = ['<div class="card"><h3>%s</h3><svg viewBox="0 0 %d %d" width="100%%" role="img" aria-label="%s">' % (esc(title), W, H, esc(title))]
    out.append('<line class="axis" x1="%d" y1="%d" x2="%d" y2="%d"/>' % (pad_l, H - pad_b, W - pad_l, H - pad_b))
    for i, (label, r) in enumerate(rows):
        v = r.get(value_key) or 0
        h = (H - pad_b - pad_t) * v / mx
        x = pad_l + i * (bw + gap)
        y = H - pad_b - h
        out.append('<rect class="bar" x="%.1f" y="%.1f" width="%.1f" height="%.1f" rx="3"><title>%s: %s</title></rect>'
                   % (x, y, bw, h, esc(label), esc(fmt_fn(v))))
        if n <= 14 or i % max(1, n // 7) == 0:
            out.append('<text x="%.1f" y="%d" text-anchor="middle">%s</text>' % (x + bw / 2, H - pad_b + 14, esc(label_fn(label))))
        if n <= 14:
            out.append('<text x="%.1f" y="%.1f" text-anchor="middle">%s</text>' % (x + bw / 2, max(10, y - 4), esc(fmt_fn(v))))
    out.append("</svg></div>")
    return "".join(out)


def svg_donut(items, title):
    """Categorical share (fixed slot order by rank, 8 slots then Other). items: [(label, value)]."""
    if not items:
        return '<div class="card"><h3>%s</h3><p class="meta">待接入</p></div>' % esc(title)
    items = sorted(items, key=lambda kv: -kv[1])
    if len(items) > 8:
        items = items[:7] + [("其他", sum(v for _, v in items[7:]))]
    total = sum(v for _, v in items) or 1
    import math
    cx, cy, r, w = 90, 90, 70, 26
    out = ['<div class="card"><h3>%s</h3><div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">'
           '<svg viewBox="0 0 180 180" width="180" height="180" role="img" aria-label="%s">' % (esc(title), esc(title))]
    ang = -math.pi / 2
    for i, (label, v) in enumerate(items):
        frac = v / total
        a2 = ang + frac * 2 * math.pi
        if frac >= 0.999:
            out.append('<circle cx="%d" cy="%d" r="%d" fill="none" stroke="var(%s)" stroke-width="%d"><title>%s: %s (100%%)</title></circle>'
                       % (cx, cy, r, _SERIES[0], w, esc(label), fmt(v)))
            break
        x1, y1 = cx + r * math.cos(ang), cy + r * math.sin(ang)
        x2, y2 = cx + r * math.cos(a2), cy + r * math.sin(a2)
        large = 1 if frac > 0.5 else 0
        color = "var(--other)" if label == "其他" else "var(%s)" % _SERIES[i % 8]
        out.append('<path d="M%.1f %.1fA%d %d 0 %d 1 %.1f %.1f" fill="none" stroke="%s" stroke-width="%d" stroke-linecap="butt">'
                   '<title>%s: %s (%.1f%%)</title></path>' % (x1, y1, r, r, large, x2, y2, color, w, esc(label), fmt(v), frac * 100))
        # 2px surface gap between segments
        out.append('<line x1="%.1f" y1="%.1f" x2="%.1f" y2="%.1f" stroke="var(--surface)" stroke-width="2"/>'
                   % (cx + (r - w / 2) * math.cos(a2), cy + (r - w / 2) * math.sin(a2), cx + (r + w / 2) * math.cos(a2), cy + (r + w / 2) * math.sin(a2)))
        ang = a2
    out.append('</svg><div class="legend">')
    for i, (label, v) in enumerate(items):
        color = "var(--other)" if label == "其他" else "var(%s)" % _SERIES[i % 8]
        out.append('<span><i style="background:%s"></i>%s %s · %.1f%%</span>' % (color, esc(label), fmt(v), 100 * v / total))
    out.append("</div></div></div>")
    return "".join(out)


def render_team_html(a, week, checks, summary, ws_sha):
    fails = [c for c in checks if c[1] == "fail"]
    warns = [c for c in checks if c[1] == "warn"]
    team_name = (a["team"] or {}).get("team") if a["team"] and not a["team"].get("_broken") else (a["people"][0]["team"] if a["people"] else "—")
    since = a["since"] or (a["people"][0]["since"] if a["people"] else "—")
    until = a["until"] or (a["people"][0]["until"] if a["people"] else "—")
    pv = ", ".join(str(v) for v in a["pricing_versions"]) or "—"
    tot_tokens = a["input"] + a["output"] + a["cache_read"] + a["cache_creation"]
    H = ['<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">',
         "<title>团队 AI 使用汇总 %s</title><style>%s</style></head><body><main>" % (esc(week), _CSS),
         "<header><div><h1>团队 AI 使用汇总 %s · %s</h1><div class=\"meta\">周期 %s ~ %s · 生成 %s · 工具版本 ws-%s · 提交 %s</div></div>"
         "<button id=\"theme\" type=\"button\">浅色 / 深色</button>" % (
             esc(week), esc(team_name), esc(since), esc(until), esc(datetime.now().astimezone().isoformat(timespec="minutes")),
             esc((ws_sha or "unknown")[:6]), esc(coverage_line(a)))]
    if fails:
        H.append('<div class="alert"><strong>校验未通过:</strong> ' + "; ".join("%s — %s" % (esc(c[0]), esc(c[2])) for c in fails) + "</div>")
    H.append("</header>")
    if warns:
        H.append('<div class="note">提醒: ' + "; ".join("%s — %s" % (esc(c[0]), esc(c[2])) for c in warns) + "</div>")
    if a["platform_infos"]:
        H.append('<p class="meta">数据来源: 平台导出 %s — 用量以平台记录为准,与个人本机日志重叠处择一计入;本机日志只是估算。</p>' % esc("; ".join(
            "%s(%d 行,%d 人)" % (i["name"], i["rows"], i["users"]) for i in a["platform_infos"])))
    H.append("<h2>管理摘要</h2><div class=\"card\">%s</div>" % esc(summary).replace("\n", "<br>"))
    est = money({"amount": a["est_total"], "currency": "USD"}) if a["est_total"] is not None else "待核实"
    kpis = [("总请求", fmt(a["requests"]), "Claude 消息 + Codex 会话"),
            ("总 token", fmt(tot_tokens), "缓存命中率 (Claude) %s" % pct(a["cache_hit_rate"])),
            ("估算总费用", est, "估算 · 价格表 %s · 非账单" % pv),
            ("实际费用确认情况", actual_line(a), "账单 / 台账确认"),
            ("活跃项目", str(len(a["by_bucket"])), "commits %d" % sum(v["commits"] for v in a["by_bucket"].values())),
            ("团队覆盖", coverage_line(a), "未提交 %s" % (", ".join(a["not_submitted"]) if a["not_submitted"] else ("无" if a["not_submitted"] == [] else "待接入")))]
    if a["qoder_credits"] is not None:
        kpis.insert(2, ("Qoder 积分合计", credits(a["qoder_credits"]), "%s 条消息 · 本机日志,未核对账单 · 不计入估算" % fmt(a["qoder_messages"])))
    H.append('<h2>KPI</h2><div class="kpis">' + "".join('<div class="kpi"><div class="l">%s</div><div class="v">%s</div><div class="s">%s</div></div>'
                                                         % (esc(l), esc(v), esc(s)) for l, v, s in kpis) + "</div>")
    if a["est_unpriced"]:
        H.append('<p class="meta">未定价模型(只计 token,不计费): %s</p>' % esc(", ".join(a["est_unpriced"])))
    H.append('<h2>每日与模型</h2><div class="charts">')
    days = list(a["by_day"].items())
    H.append(svg_bars(days, "requests", lambda d: d[5:], "每日请求", lambda v: fmt(v)))
    H.append(svg_bars([(d, {"cost": (v["cost"] or 0)}) for d, v in days], "cost", lambda d: d[5:],
                      "每日估算费用(估算 · 价格表 %s)" % pv, lambda v: usd(v)))
    H.append(svg_donut([(k, v["requests"]) for k, v in a["by_model"].items()], "模型分布(按请求)"))
    H.append("</div>")
    H.append('<h2>按成员(名称序,不按费用排名)</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr>'
             '<th>成员</th><th class="n">请求</th><th class="n">token</th><th class="n">Qoder 积分</th><th class="n">估算费用<br><span class="meta">估算 · 非账单</span></th>'
             '<th class="n">实际费用</th><th class="n">分摊费用</th><th>项目</th><th class="n">commits</th><th>确认</th></tr></thead><tbody>')
    for p in a["people"]:
        cb = p["quality"]["confirmed_by"]
        H.append('<tr><td><strong>%s</strong><br><span class="meta">%s</span></td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td>'
                 '<td class="n">%s%s</td><td class="n">%s</td><td>%s</td><td class="n">%d</td><td class="meta">%s</td></tr>' % (
                     esc(p["human_id"]), esc(p["business"] or p["team"] or ""), fmt(p["requests"]), fmt(p["tokens"]),
                     esc(credits(p["qoder_credits"])), esc(money(p["estimated"])),
                     esc(money(p["actual"])), (' <span class="tag">%s</span>' % esc(p["actual"]["nature"])) if p["actual"] else "",
                     esc(money(p["allocated"])), esc(", ".join(p["buckets"][:3]) or "—"), p["git_commits"],
                     "成员 %s · 账单 %s · 归属 %s" % tuple("✓" if cb.get(k) else "待" for k in ("member", "billing", "attribution"))))
    H.append("</tbody></table></div>")
    if a["not_in_roster"]:
        H.append('<p class="meta">名单外的提交: %s</p>' % esc(", ".join(a["not_in_roster"])))
    H.append("<h2>按成员卡片</h2>")
    for p in a["people"]:
        n = p["narrative"]
        H.append('<div class="card"><h3>%s%s</h3>' % (esc(p["human_id"]), ' <span class="tag">仅平台用量</span>' if p["platform_only"] else ""))
        if not n:
            H.append('<p class="meta">%s</p></div>' % ("叙事待提交。" if p["platform_only"] else "叙事待补。"))
            continue
        H.append("<p>%s</p>" % esc(n.get("summary", "")))
        for pr in n.get("projects") or []:
            H.append("<p><strong>%s</strong> — %s %s</p><ul>" % (esc(pr["name"]), esc(pr.get("headline", "")),
                                                           "".join('<span class="tag">%s</span>' % esc(s) for s in (pr.get("status") or []))))
            for t in pr.get("tasks") or []:
                tags = " · ".join(esc(x) for x in (t.get("ai_role"), t.get("deliverable"), t.get("status")) if x)
                H.append("<li>%s %s%s%s</li>" % (esc(t["title"]), esc(t.get("detail", "")),
                                                 (' <span class="meta">(%s)</span>' % tags) if tags else "",
                                                 (' <span class="meta">证据: %s</span>' % esc(t["evidence"])) if t.get("evidence") else ' <span class="warn">无证据</span>'))
            H.append("</ul>")
            for rsk in pr.get("risks") or []:
                H.append('<p class="meta">风险: %s</p>' % esc(rsk))
        H.append("</div>")
    H.append('<h2>按项目</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>项目</th><th class="n">请求</th><th class="n">token</th>'
             '<th class="n">估算费用</th><th class="n">commits</th><th>参与</th><th class="n">交付物(去重)</th></tr></thead><tbody>')
    for b, v in sorted(a["by_bucket"].items(), key=lambda kv: -kv[1]["tokens"]):
        dl = [d for d in a["deliverables"].values() if d["project"] == b]
        H.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%d</td><td>%s</td><td class="n">%d</td></tr>'
                 % (esc(b), fmt(v["requests"]), fmt(v["tokens"]), esc(usd(v["cost"])), v["commits"], esc(", ".join(v["people"])), len(dl)))
    H.append("</tbody></table></div>")
    if a["qoder_by_bucket"]:
        H.append('<h3>Qoder 积分(按项目)</h3><p class="meta">%s</p><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>项目</th>'
                 '<th class="n">消息</th><th class="n">积分</th><th>参与</th></tr></thead><tbody>' % esc(QODER_NOTE))
        for b, v in sorted(a["qoder_by_bucket"].items(), key=lambda kv: -kv[1]["credits"]):
            H.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td>%s</td></tr>' % (
                esc(b), fmt(v["messages"]), esc(credits(v["credits"])), esc(", ".join(v["people"]))))
        H.append("</tbody></table></div>")
    H.append("<h3>交付物(同一证据多人参与只计一次)</h3><ul>")
    for d in a["deliverables"].values():
        H.append("<li><span class=\"tag\">%s</span>%s — %s · %s · %s</li>" % (esc(d["project"]), esc(d["title"]),
                                                                            esc(d["evidence"]) if d["evidence"] else '<span class="warn">无证据</span>',
                                                                            esc(d["status"] or "—"), esc(" / ".join(d["people"]))))
    H.append("</ul>")
    for title, key in (("值得学习", "methods"), ("效果不好的尝试", "failed"), ("问题清单", "issues"), ("资源需求", "resource_needs")):
        H.append("<h2>%s</h2><ul>" % title + ("".join("<li>%s <span class=\"meta\">(%s)</span></li>" % (esc(x), esc(who)) for who, x in a[key]) or "<li class=\"meta\">无</li>") + "</ul>")
    H.append("<h3>本周新申请 <span class=\"meta\">reports/requests/</span></h3><ul>" + ("".join(
        "<li><strong>%s</strong> · %s · %s <span class=\"tag\">%s</span> %s · %s 至 %s · %s %s</li>" % (
            esc(r["resource"]), esc(r["human_id"]), esc(KIND_LABEL[r["kind"]]), esc(STATUS_LABEL[r["status"]]), esc(r["project"]),
            esc(r["start"]), esc(r["end"]), esc(r["amount"]), esc(r["currency"])) for r in a["requests_new"]) or "<li class=\"meta\">无</li>") + "</ul>")
    H.append("<h3>待复评 <span class=\"meta\">30 天内到期的续费,尚无复评结论</span></h3><ul>" + ("".join(
        "<li><strong>%s</strong> · %s · 到期 %s · %s · 复评前带出历史投入 / 利用情况 / 成果</li>" % (
            esc(r["resource"]), esc(r["human_id"]), esc(r["end"]), esc(RENEWAL_LABEL[r["renewal"]])) for r in a["requests_due"]) or "<li class=\"meta\">无</li>") + "</ul>")
    if a["requests_bad"]:
        H.append('<p class="meta">申请文件未纳入: %s</p>' % esc("; ".join("%s (%s)" % b for b in a["requests_bad"])))
    H.append('<h2>建议跟进</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>优先级</th><th>事项</th><th>验收</th><th>谁</th></tr></thead><tbody>')
    for x in a["next_actions"]:
        H.append("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>" % (esc(x.get("priority")), esc(x.get("item")), esc(x.get("acceptance", "")), esc(x["who"])))
    H.append("</tbody></table></div>")
    H.append(budget_html(a.get("budget")))
    H.append('<h2>六项校验</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>校验</th><th>结果</th><th>说明</th></tr></thead><tbody>')
    icon = {"ok": ("ok", "✓ 通过"), "warn": ("warn", "△ 提醒"), "fail": ("fail", "✗ 未通过")}
    for name, st, detail in checks:
        H.append('<tr><td>%s</td><td class="%s">%s</td><td>%s</td></tr>' % (esc(name), icon[st][0], icon[st][1], esc(detail)))
    H.append("</tbody></table></div>")
    H.append("<h2>未纳入 / 未提交</h2><ul><li>未纳入: %s</li><li>未提交: %s</li></ul>" % (
        esc("; ".join("%s (%s)" % r for r in a["rejected"]) if a["rejected"] else "无"),
        esc(", ".join(a["not_submitted"]) if a["not_submitted"] else ("无" if a["not_submitted"] == [] else "待接入(reports/team.json 未提供名单)"))))
    H.append("<footer>估算费用 = 本机 usage 日志 × 价格表(版本 %s),是估算不是账单,不进核算 / 报销 / 预算;实际费用只来自账单。三种金额不相加。"
             "成员按名称序展示,个人用量不是绩效输入。数据不含 prompt、路径与会话 id。数据来源:reports/%s/*.json(schema v1 兼容读入,v2 为准)。</footer>"
             % (esc(pv), esc(week)))
    H.append("</main><script>%s</script></body></html>" % _JS)
    return "".join(H)


def cmd_team(args):
    root = os.path.abspath(args.workspace_root) if args.workspace_root else os.path.dirname(_HERE)
    tool_root = os.path.dirname(_HERE)
    if not re.match(r"^\d{4}-W\d{2}$", args.week or ""):
        print("FAIL: --week must look like 2026-W37")
        return 2
    reports_dir = os.path.abspath(args.reports_dir) if args.reports_dir else os.path.join(root, REPORTS_REL)
    if not ensure_reports_dir(reports_dir, tool_root, create=False):
        return 2
    schema = load_json(os.path.join(tool_root, SCHEMA_REL))
    since, until, _ = resolve_window(args.week, None, None)
    subs, rejected = load_week(reports_dir, args.week, schema)
    team = load_team_json(reports_dir)
    platform_infos = []
    if args.platform_export:
        try:
            pricing = load_pricing(args.pricing or os.path.join(tool_root, PRICING_REL))
            mapping = load_mapping(args.mapping or os.path.join(tool_root, MAPPING_REL))
        except (OSError, ValueError, json.JSONDecodeError) as e:
            print("FAIL: pricing / mapping unusable: %s" % e)
            return 2
        ids = (team or {}).get("platform_ids") if team and not team.get("_broken") else None
        ids = ids if isinstance(ids, dict) else {}
        per_person = {}
        for pth in args.platform_export:
            try:
                by_user = platform_cells_by_user(pth, mapping, since, until)
            except (OSError, ValueError) as e:
                print("FAIL: %s" % e)
                return 2
            rows = 0
            for user, (cells, info) in by_user.items():
                hid = ids.get(user, user)
                per_person[hid] = merge_platform_exports(per_person.get(hid), (cells, info))
                rows += info["records"]
            platform_infos.append({"name": os.path.basename(pth), "rows": rows, "users": len(by_user),
                                   "unmapped": sorted(u for u in by_user if u not in ids and ids)})
        by_id = {s["meta"]["human_id"]: s for s in subs}
        for hid, (cells, info) in sorted(per_person.items()):
            if hid in by_id:
                apply_platform(by_id[hid], cells, info, pricing)
            else:
                subs.append(synthesize_platform_submission(hid, cells, info, pricing, team, args.week, since, until))
        subs.sort(key=lambda s: s["meta"]["human_id"].lower())
    if not subs:
        print("FAIL: no valid submission under %s/reports/%s%s — nothing to aggregate%s" % (
            reports_dir, args.week, " and no platform rows" if args.platform_export else "",
            ("; 未纳入: " + "; ".join("%s (%s)" % r for r in rejected)) if rejected else ""))
        return 2
    a = aggregate(subs, rejected, team, since, until, platform_infos)
    reqs, bad_reqs = load_requests(reports_dir, load_json(os.path.join(tool_root, REQUEST_SCHEMA_REL)))
    a["requests_new"], a["requests_due"] = requests_for_week(reqs, since, until)
    a["requests_bad"] = bad_reqs
    biz = (team or {}).get("business") if team and not team.get("_broken") else None
    if not biz:
        bizs = sorted({p["business"] for p in a["people"] if p.get("business")})
        biz = bizs[0] if len(bizs) == 1 else None
    a["budget"] = budget_status(reports_dir, args.week, until,
                                load_budget(args.budget_file or os.path.join(reports_dir, "reports", "budget.json")), biz, schema)
    checks = run_checks(a, args.week)
    summary = default_summary(a)
    if args.summary_file:
        try:
            with open(args.summary_file, encoding="utf-8") as fh:
                summary = fh.read().strip() or summary
        except OSError as e:
            print("FAIL: --summary-file unreadable: %s" % e)
            return 2
    ws_sha = git_head(root)
    out_dir = os.path.abspath(args.out) if args.out else os.path.join(reports_dir, "reports", args.week)
    os.makedirs(out_dir, exist_ok=True)
    hp, mp = os.path.join(out_dir, "team-report.html"), os.path.join(out_dir, "team-report.md")
    with open(hp, "w", encoding="utf-8") as fh:
        fh.write(render_team_html(a, args.week, checks, summary, ws_sha))
    with open(mp, "w", encoding="utf-8") as fh:
        fh.write(render_team_md(a, args.week, checks, summary, ws_sha))
    fails = [c for c in checks if c[1] == "fail"]
    print("OK: team report written: %s (+ .md) — %d 人, 总请求 %s, 估算总费用 %s (估算,非账单), 实际费用 %s" % (
        hp, len(a["people"]), fmt(a["requests"]),
        money({"amount": a["est_total"], "currency": "USD"}) if a["est_total"] is not None else "待核实", actual_line(a)))
    if rejected:
        print("NOTE: 未纳入 %d: %s" % (len(rejected), "; ".join("%s (%s)" % r for r in rejected)))
    if a["not_submitted"]:
        print("NOTE: 未提交: %s" % ", ".join(a["not_submitted"]))
    elif a["not_submitted"] is None:
        print("NOTE: 无 reports/team.json 名单 — 团队覆盖显示待接入")
    for name, st, detail in fails:
        print("WARN: 校验未通过 %s — %s" % (name, detail))
    if args.open:
        import webbrowser
        webbrowser.open("file://" + hp)
    print("NEXT: review %s, then commit / push the report through your normal flow — this tool never pushes." % mp)
    return 0


# ---------------------------------------------------------------- personal page (T3, #197)
# The md and the html are two renderings of ONE submission dict — nothing is recomputed per format.
# The 提交前需要补齐 list is program-made from the same dict; each item points at the field to fix.

_CLAIM_RE = re.compile(r"\d+(?:\.\d+)?\s*(?:%|％|倍|小时|h\b|分钟|min\b|天|人日|人天)")


def checklist(s):
    """[(text, field)] — what the person must settle before submitting. Never invents; only points."""
    m, u, c, q, n = s["meta"], s["usage"], s["cost"], s["quality"], s["narrative"]
    items = []
    e = c["estimated"]
    if not c["actual"]:
        items.append(("本周金额为本机估算(价格表 %s),不是账单 — 账单待核实,不能用估算顶位" % e["pricing_version"], "cost.actual"))
    elif not c["actual"].get("confirmed"):
        items.append(("实际费用 %s 尚未经账单负责人确认" % money(c["actual"]), "cost.actual.confirmed"))
    if c["actual"] and not c["allocated"]:
        items.append(("有实际费用但无分摊:确认是否需要按服务周期 / 项目折算到本周", "cost.allocated"))
    if e.get("unpriced_models"):
        items.append(("未定价模型只计 token 不计费: %s — 补价格表后重跑" % ", ".join(e["unpriced_models"]), "cost.estimated.unpriced_models"))
    labels = {"platform-export": "平台导出(待接入)", "actual-bill": "账单 / 台账(待核实)", "local-usage-log": "本机 usage 日志(待接入)", "git": "Git 提交(未关联仓)"}
    for src in q.get("missing_sources") or []:
        items.append(("来源缺失: %s" % labels.get(src, src), "quality.missing_sources"))
    try:
        d0 = datetime.strptime(m["since"], "%Y-%m-%d").date()
        d1 = datetime.strptime(m["until"], "%Y-%m-%d").date()
        days = [(d0 + timedelta(days=i)).isoformat() for i in range((d1 - d0).days + 1)]
        qdays = (((u.get("by_agent") or {}).get("qoder") or {}).get("by_day") or {})
        empty = [d for d in days if d not in (u.get("by_day") or {}) and d not in qdays]
        if empty:
            items.append(("周内 %d 天无记录(%s)— 确认是无使用还是采集缺口" % (len(empty), ", ".join(x[5:] for x in empty)), "usage.by_day"))
    except (ValueError, TypeError):
        pass
    if q.get("allocation"):
        tot = sum(a.get("ratio", 0) for a in q["allocation"])
        if abs(tot - 100) > 1e-9:
            items.append(("分摊比例合计 %s%%,应为 100%%" % tot, "quality.allocation"))
    if not n:
        items.append(("叙事待补: 本周主要用 AI 完成了什么 / 具体产出 / 改善 / 可复用方法 / 失败尝试 / 工具问题", "narrative"))
    else:
        for i, p in enumerate(n.get("projects") or []):
            for j, t in enumerate(p.get("tasks") or []):
                field = "narrative.projects[%d].tasks[%d]" % (i, j)
                if not (t.get("evidence") or "").strip():
                    items.append(("证据待确认: %s / %s — 补 PR / commit / 文档链接" % (p["name"], t["title"]), field + ".evidence"))
                    txt = (t.get("detail") or t.get("title") or "").strip()
                    mm = _CLAIM_RE.search(txt)
                    if mm:
                        items.append(("时间/效率数字无测量依据: 「%s」— 没有测量就改成定性说明" % txt[max(0, mm.start() - 12):mm.end() + 4].strip(),
                                      field + ".detail"))
            if p.get("value") and _CLAIM_RE.search(p["value"]) and not all((t.get("evidence") or "").strip() for t in p.get("tasks") or []):
                items.append(("项目价值「%s」含数字但任务缺证据" % p["value"], "narrative.projects[%d].value" % i))
        if not (n.get("reusable_methods") or n.get("failed_experiments") or n.get("issues")):
            items.append(("补 1–2 条可复用方法 / 失败探索 / 工具问题", "narrative.reusable_methods"))
    cb = q.get("confirmed_by") or {}
    if n and not cb.get("member"):
        items.append(("成员确认状态为空", "quality.confirmed_by.member"))
    return items


def render_personal_html(s):
    m, u, c, g, n, q = s["meta"], s["usage"], s["cost"], s["git"], s["narrative"], s["quality"]
    e = c["estimated"]
    items = checklist(s)
    tot_tokens = u["input"] + u["output"] + u["cache_read"] + u["cache_creation"]
    src_label = {"local-usage-log": "本机 usage 日志", "platform-export": "平台导出",
                 "local-usage-log+platform-export": "本机日志 + 平台导出(择一计入)"}.get(e.get("source"), e.get("source"))
    projects = [p for p in (n or {}).get("projects") or []]
    qd = (u.get("by_agent") or {}).get("qoder")
    H = ['<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">',
         "<title>AI 使用周报 %s · %s</title><style>%s</style></head><body><main>" % (esc(m["week"]), esc(m["human_id"]), _CSS),
         '<header><div><h1>个人 AI 使用周报 %s · %s</h1><div class="meta">%s · %s · 周期 %s ~ %s (%s) · 提交版本 v%s · 生成 %s · ws-%s</div></div>'
         '<button id="theme" type="button">浅色 / 深色</button></header>' % (
             esc(m["week"]), esc(m["human_id"]), esc(m.get("team") or ""), esc(m.get("business") or "业务/职能待填"),
             esc(m["since"]), esc(m["until"]), esc(m.get("timezone") or "—"), esc(m.get("submission_version")),
             esc((m.get("generated_at") or "")[:16]), esc((m.get("workspace_sha") or "unknown")[:6]))]
    if items:
        H.append('<div class="note"><strong>提交前需要补齐(%d)</strong> — 见页末清单。本页数字来自提交 JSON,金额性质见「三种金额」。</div>' % len(items))
    kpis = [("AI 请求数", fmt(u["requests"]), "Claude 消息 + Codex 会话"),
            ("Token 总吞吐", fmt(tot_tokens), "缓存命中率 %s" % pct(u.get("cache_hit_rate"))),
            ("估算费用", money(e), "估算 · 价格表 %s · 非账单" % e["pricing_version"]),
            ("实际费用", money(c["actual"]), ("%s · %s" % (c["actual"].get("nature"), "已确认" if c["actual"].get("confirmed") else "未确认")) if c["actual"] else "账单待核实"),
            ("核心项目", str(len(projects)) if n else "待补", ", ".join(p["name"] for p in projects[:3]) if projects else "叙事待补")]
    if qd:
        kpis.insert(2, ("Qoder 积分", credits(qd["credits"]), "%s 条消息 · 本机日志,未核对账单 · 不计入估算" % fmt(qd["messages"])))
    H.append('<h2>用量 / 费用</h2><div class="kpis">' + "".join('<div class="kpi"><div class="l">%s</div><div class="v">%s</div><div class="s">%s</div></div>'
                                                             % (esc(l), esc(v), esc(x)) for l, v, x in kpis) + "</div>")
    H.append('<h2>三种金额(分列展示,不相加)</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>金额</th><th class="n">值</th><th>性质</th><th>来源</th><th>确认</th></tr></thead><tbody>')
    H.append('<tr><td><strong>估算费用</strong></td><td class="n"><strong>%s</strong><br><span class="meta">估算,非账单 · 价格表 %s</span></td><td>%s</td><td>%s × 价格表</td><td>未确认</td></tr>'
             % (esc(money(e)), esc(e["pricing_version"]), esc(e["nature"]), esc(src_label)))
    for name, blk in (("实际费用", c["actual"]), ("分摊费用", c["allocated"])):
        v, nat, src, conf = money_row(blk)
        H.append("<tr><td>%s</td><td class=\"n\">%s</td><td>%s</td><td>%s%s</td><td>%s</td></tr>" % (
            name, esc(v), esc(nat), esc(src), (' <span class="meta">%s</span>' % esc(blk["basis"])) if blk and blk.get("basis") else "", esc(conf)))
    H.append("</tbody></table></div>")
    if e.get("unpriced_models"):
        H.append('<p class="meta">未定价模型(只计 token,不计费): %s</p>' % esc(", ".join(e["unpriced_models"])))
    H.append('<h2>每日与模型</h2><div class="charts">')
    days = list((u.get("by_day") or {}).items())
    H.append(svg_bars(days, "requests", lambda d: d[5:], "每日请求", lambda v: fmt(v)))
    H.append(svg_bars([(d, {"cost": (v.get("cost") or 0)}) for d, v in days], "cost", lambda d: d[5:],
                      "每日估算费用(估算 · 价格表 %s)" % e["pricing_version"], lambda v: usd(v)))
    H.append(svg_donut([(k, v["requests"]) for k, v in (u.get("by_model") or {}).items()], "模型分布(按请求)"))
    H.append("</div>")
    if u.get("sources"):
        H.append('<h2>数据来源</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>来源</th><th>名称</th><th>覆盖</th><th class="n">记录</th><th>备注</th></tr></thead><tbody>')
        for sc in u["sources"]:
            notes = [sc["note"]] if sc.get("note") else []
            if sc.get("superseded"):
                notes.append("%d 个(日×模型)被平台记录替代(择一计入)" % sc["superseded"])
            if sc.get("skipped_other_users"):
                notes.append("跳过他人行 %d" % sc["skipped_other_users"])
            if sc.get("reported_cost"):
                rc = sc["reported_cost"]
                notes.append("平台报告金额 %s %s(性质待核实,不是账单)" % (rc["amount"], rc.get("currency") or ""))
            H.append('<tr><td>%s</td><td>%s</td><td>%s ~ %s</td><td class="n">%s</td><td class="meta">%s</td></tr>' % (
                esc(sc["type"]), esc(sc.get("name", "")), esc(sc.get("since", "")), esc(sc.get("until", "")), esc(sc.get("records", "")), esc("; ".join(notes) or "—")))
        H.append("</tbody></table></div>")
    H.append('<h2>按项目(bucket)</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>项目</th><th class="n">请求</th><th class="n">token</th><th class="n">估算费用</th><th class="n">commits</th></tr></thead><tbody>')
    for k, v in sorted((u.get("by_bucket") or {}).items(), key=lambda kv: -kv[1]["tokens"]):
        H.append('<tr><td>%s%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
            esc(k), ' <span class="tag">inferred</span>' if v.get("inferred") else "", fmt(v["requests"]), fmt(v["tokens"]), esc(usd(v["cost"])), g.get(k, {}).get("commits", 0)))
    H.append("</tbody></table></div>")
    if qd:
        H.append('<h2>Qoder 积分</h2><p class="meta">%s</p><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>日期 / 项目</th>'
                 '<th class="n">消息</th><th class="n">积分</th></tr></thead><tbody>' % esc(QODER_NOTE))
        for k, v in qd["by_day"].items():
            H.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (esc(k), fmt(v["messages"]), esc(credits(v["credits"]))))
        for k, v in sorted(qd["by_bucket"].items(), key=lambda kv: -kv[1]["credits"]):
            H.append('<tr><td>%s%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (
                esc(k), ' <span class="tag">inferred</span>' if v.get("inferred") else "", fmt(v["messages"]), esc(credits(v["credits"]))))
        H.append('<tr><td><strong>合计</strong></td><td class="n"><strong>%s</strong></td><td class="n"><strong>%s</strong></td></tr></tbody></table></div>'
                 % (fmt(qd["messages"]), esc(credits(qd["credits"]))))
    H.append("<h2>主要工作与交付</h2>")
    if not n:
        H.append('<div class="card"><p class="meta">叙事待补 — 用 <code>scripts/ai-usage-weekly submit --week %s --narrative &lt;file&gt;</code> 补齐。</p></div>' % esc(m["week"]))
    else:
        H.append("<div class=\"card\"><p>%s</p></div>" % esc(n.get("summary", "")))
        for p in projects:
            H.append('<div class="card"><h3>%s — %s %s</h3><p class="meta">价值: %s</p><ul>' % (
                esc(p["name"]), esc(p.get("headline", "")), "".join('<span class="tag">%s</span>' % esc(x) for x in (p.get("status") or [])), esc(p.get("value") or "—")))
            for t in p.get("tasks") or []:
                tags = " · ".join(esc(x) for x in (t.get("ai_role"), t.get("deliverable"), t.get("status")) if x)
                H.append("<li><strong>%s</strong> %s%s<br><span class=\"meta\">%s</span></li>" % (
                    esc(t["title"]), esc(t.get("detail", "")), (' <span class="meta">(%s)</span>' % tags) if tags else "",
                    ("证据: " + esc(t["evidence"])) if (t.get("evidence") or "").strip() else '<span class="warn">证据待确认</span>'))
            H.append("</ul>")
            for r in p.get("risks") or []:
                H.append('<p class="meta">待跟进 / 风险: %s</p>' % esc(r))
            H.append("</div>")
        for title, key in (("值得复用的方法", "reusable_methods"), ("效果不好的尝试", "failed_experiments"),
                           ("工具 / 模型 / 额度问题", "issues"), ("下一步资源需求", "resource_needs")):
            if n.get(key):
                H.append("<h3>%s</h3><ul>%s</ul>" % (title, "".join("<li>%s</li>" % esc(x) for x in n[key])))
        if n.get("next_actions"):
            H.append('<h3>建议跟进</h3><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>优先级</th><th>事项</th><th>验收</th></tr></thead><tbody>')
            for a in n["next_actions"]:
                H.append("<tr><td>%s</td><td>%s</td><td>%s</td></tr>" % (esc(a.get("priority")), esc(a.get("item")), esc(a.get("acceptance", ""))))
            H.append("</tbody></table></div>")
    H.append('<h2>质量与归属</h2><div class="card"><ul>')
    H.append("<li>缺失来源: %s</li><li>未定价模型: %s</li><li>共享费用: %s</li><li>分摊比例: %s</li><li>确认状态: 成员 %s · 账单 %s · 归属 %s</li>" % (
        esc(", ".join(q["missing_sources"]) or "无"), esc(", ".join(q["unpriced_models"]) or "无"),
        esc("; ".join("%s %s %s" % (x["description"], x["amount"], x["currency"]) for x in q["shared_costs"]) or "无"),
        esc("; ".join("%s %s%%" % (a["target"], a["ratio"]) for a in q["allocation"]) or "无(归属本人)"),
        *[esc(q["confirmed_by"].get(k) or "待确认") for k in ("member", "billing", "attribution")]))
    H.append("</ul></div>")
    H.append('<h2>金额与来源明细</h2><div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>日期</th><th class="n">请求</th><th class="n">output</th><th class="n">估算费用(估算)</th></tr></thead><tbody>')
    for d, v in days:
        H.append('<tr><td>%s</td><td class="n">%s</td><td class="n">%s</td><td class="n">%s</td></tr>' % (esc(d), fmt(v["requests"]), fmt(v["output"]), esc(usd(v.get("cost")))))
    H.append('<tr><td><strong>合计</strong></td><td class="n"><strong>%s</strong></td><td class="n">%s</td><td class="n"><strong>%s</strong> <span class="meta">估算</span></td></tr></tbody></table></div>'
             % (fmt(u["requests"]), fmt(u["output"]), esc(money(e))))
    H.append("<h2>提交前需要补齐</h2>")
    if items:
        H.append('<div class="card"><ol>' + "".join('<li>%s <span class="meta">→ <code>%s</code></span></li>' % (esc(t), esc(f)) for t, f in items) + "</ol></div>")
    else:
        H.append('<div class="card"><p class="ok">✓ 无待补项</p></div>')
    H.append("<footer>估算费用 = %s × 价格表(版本 %s),是估算不是账单,不进核算 / 报销 / 预算;实际与分摊费用只来自账单。三种金额不相加。"
             "个人用量不是绩效输入。数据不含 prompt、路径与会话 id。</footer>" % (esc(src_label), esc(e["pricing_version"])))
    H.append("</main><script>%s</script></body></html>" % _JS)
    return "".join(H)


# ---------------------------------------------------------------- monthly budget (T5, #199)
# reports/budget.json = {"<business>": {"monthly": 5000, "currency": "USD"}}, kept by the lead.
# The month is the one the report week ends in. Only bills count: a member-week's contribution is
# cost.allocated (the week's share) or cost.actual when its period sits inside the week; a member-week
# with neither is 待核实 and NOT counted — the estimate never stands in. Forecast is linear over the
# days of the month elapsed by the end of the report week. Tiers follow the guide: ≤ 1.0× 正常;
# ≤ 1.5× 超出但可从下月扣减; > 1.5× 预计超过,需沟通并额外确认. 预警用于支持决策,不做考核.

BUDGET_RULE = ("按团队 AI 资源与预算使用指南:月预算 1.5 倍以内的超出部分可从下月扣减;预计超过 1.5 倍应及时沟通并额外确认。"
               "预警用于支持决策,不做考核。累计与预测只用账单(实际 / 分摊),本机估算永不计入。")


def load_budget(path):
    if not os.path.isfile(path):
        return None
    try:
        b = load_json(path)
    except (OSError, json.JSONDecodeError):
        return {"_broken": True}
    return b if isinstance(b, dict) else {"_broken": True}


def _week_contribution(sub, since, until):
    """(amount, currency, note, parts) for one submission-week; amount None = 待核实.
    parts = [(amount, span_since, span_until)] — the days inside the week each amount covers, so a
    month can take exactly its share of a week that straddles a month boundary (#203):
    an allocated block with `items[]` covers, per bill, week ∩ that bill's service period; without
    items a single bill can use `cost.actual.period`. A legacy merged bill's enclosing period does
    not preserve the amounts on either side of a month boundary: parts is None (待核实) unless its
    entire in-week span is in one month. A missing period is also unknown; a within-week actual
    covers its own period."""
    c = sub["cost"]
    al, ac = c.get("allocated"), c.get("actual")
    bill_span = _span_in_week((ac or {}).get("period"), since, until)
    merged = any(len([s for s in (blk.get("source") or "").split(";") if s.strip()]) > 1
                 for blk in (al, ac) if blk) or len((ac or {}).get("items") or []) > 1
    ambiguous = merged and bill_span and bill_span[0].month != bill_span[1].month
    if al and al.get("amount") is not None:
        note = "分摊" + ("" if al.get("confirmed") else "(未确认)")
        parts = []
        for it in al.get("items") or []:
            span = _span_in_week(it.get("period"), since, until)
            parts.append((float(it.get("amount") or 0), span[0], span[1]) if span else (float(it.get("amount") or 0), since, until))
        if parts and abs(sum(a for a, _, _ in parts) - al["amount"]) > 0.005:
            parts = []  # items don't add up to the block: fall back to the block-level period below
        if not parts:
            parts = [(al["amount"], bill_span[0], bill_span[1])] if bill_span and not ambiguous else None
            if ambiguous:
                note += " · 合并账单跨月且缺逐笔分摊金额,请补齐 items"
            elif not bill_span:
                note += " · 无账单服务期可折算"
        return al["amount"], al.get("currency"), note, parts
    if ac and ac.get("amount") is not None:
        p = ac.get("period") or {}
        if p.get("since", "") >= since.isoformat() and p.get("until", "") <= until.isoformat():
            p0, p1 = datetime.strptime(p["since"], "%Y-%m-%d").date(), datetime.strptime(p["until"], "%Y-%m-%d").date()
            note = "实际" + ("" if ac.get("confirmed") else "(未确认)")
            if ambiguous and not ac.get("items"):
                return ac["amount"], ac.get("currency"), note + " · 合并账单跨月且缺逐笔金额,请补齐 items", None
            return ac["amount"], ac.get("currency"), note, [(ac["amount"], p0, p1)]
        return None, ac.get("currency"), "实际账单跨周期 %s~%s 但无分摊 — 待核实" % (p.get("since"), p.get("until")), []
    return None, None, "无账单 — 待核实", []


def _span_in_week(period, since, until):
    """(p0, p1) = week ∩ period, or None when the period is missing / unparseable / disjoint."""
    try:
        p0 = max(since, datetime.strptime(period["since"], "%Y-%m-%d").date())
        p1 = min(until, datetime.strptime(period["until"], "%Y-%m-%d").date())
    except (KeyError, ValueError, TypeError):
        return None
    return (p0, p1) if p1 >= p0 else None


def _month_share(parts, month_start, month_end):
    """Σ amount × (days of span inside the month / days of span). A span fully inside the month
    contributes all of it; one straddling the boundary only its in-month days."""
    total = 0.0
    for amt, p0, p1 in parts:
        days = (p1 - p0).days + 1
        if days <= 0:
            continue
        o0, o1 = max(p0, month_start), min(p1, month_end)
        inside = max(0, (o1 - o0).days + 1)
        total += amt * inside / days
    return total


def budget_status(reports_dir, week, until, budget, business, schema):
    """Everything the budget section renders. Returns None when there is nothing honest to show."""
    if not budget or budget.get("_broken"):
        return {"state": "none", "reason": "reports/budget.json 尚未提供" if not budget else "reports/budget.json 不是合法 JSON"}
    row = budget.get(business) if business else None
    if not row and len(budget) == 1:
        business, row = next(iter(budget.items()))
    if not isinstance(row, dict) or "monthly" not in row:
        return {"state": "none", "reason": "budget.json 里没有 %r 的月预算" % (business or "本团队业务/职能")}
    month_start = until.replace(day=1)
    nxt = (month_start.replace(day=28) + timedelta(days=4)).replace(day=1)
    month_end = nxt - timedelta(days=1)
    days_in_month = (month_end - month_start).days + 1
    elapsed = (min(until, month_end) - month_start).days + 1
    cur = row.get("currency", "USD")
    weeks = []
    rdir = os.path.join(reports_dir, "reports")
    for name in sorted(os.listdir(rdir)):
        m = re.match(r"^(\d{4})-W(\d{2})$", name)
        if not m:
            continue
        try:
            s0, s1, _ = resolve_window(name, None, None)
        except ValueError:
            continue
        if s1 < month_start or s0 > month_end or s1 > until:
            continue
        subs, _ = load_week(reports_dir, name, schema)
        straddles = s0 < month_start or s1 > month_end
        entries, counted = [], 0.0
        for sub in subs:
            amt, c, note, parts = _week_contribution(sub, s0, s1)
            if amt is not None and c and c != cur:
                entries.append((sub["meta"]["human_id"], None, "币种 %s ≠ 预算币种 %s — 待核实" % (c, cur)))
                continue
            if amt is not None and straddles:
                if parts is None:
                    entries.append((sub["meta"]["human_id"], None,
                                    "跨月周 %.2f 无法确定月内金额 — 待核实; %s" % (amt, note)))
                    continue
                share = _month_share(parts, month_start, month_end)
                note += " · 跨月折算 %.2f→%.2f(只计 %s 内的天,按账单服务期)" % (amt, share, month_start.strftime("%Y-%m"))
                amt = share
            entries.append((sub["meta"]["human_id"], amt, note))
            if amt is not None:
                counted += amt
        weeks.append({"week": name, "since": s0.isoformat(), "until": s1.isoformat(), "entries": entries, "counted": counted,
                      "pending": [e[0] for e in entries if e[1] is None], "straddles": straddles})
    accumulated = sum(w["counted"] for w in weeks)
    any_bill = any(e[1] is not None for w in weeks for e in w["entries"])
    if not weeks or not any_bill:
        pending = ["%s %s: %s" % (w["week"], h, note)
                   for w in weeks for h, amt, note in w["entries"] if amt is None]
        if pending:
            return {"state": "none", "reason": "%s 尚无可计入的月内账单金额 — 累计、余额与预测待核实; %s"
                    % (month_start.strftime("%Y-%m"), "; ".join(pending))}
        return {"state": "none", "reason": "%s 尚无任何账单 / 分摊记录 — 累计、余额与预测待账单接入后计算" % month_start.strftime("%Y-%m")}
    monthly = float(row["monthly"])
    forecast = accumulated / elapsed * days_in_month if elapsed else accumulated
    ratio = round(forecast / monthly, 6) if monthly else None
    if ratio is None:
        tier = ("待核实", "月预算为 0,无法比较")
    elif ratio <= 1.0:
        tier = ("正常", "预测 %.2f× 月预算" % ratio)
    elif ratio <= 1.5:
        tier = ("超出但 ≤1.5×", "预测 %.2f× 月预算 — 超出部分可从下月扣减" % ratio)
    else:
        tier = ("预计超过 1.5×", "预测 %.2f× 月预算 — 应及时沟通并额外确认" % ratio)
    return {"state": "ok", "business": business, "month": month_start.strftime("%Y-%m"), "currency": cur, "monthly": monthly,
            "accumulated": accumulated, "remaining": monthly - accumulated, "forecast": forecast, "ratio": ratio,
            "elapsed": elapsed, "days": days_in_month, "tier": tier, "weeks": weeks}


def budget_md(b):
    L = ["## 月度预算状态", ""]
    if b is None or b["state"] == "none":
        L += ["尚未提供 — %s。" % (b["reason"] if b else "reports/budget.json 尚未提供"), "", "> " + BUDGET_RULE, ""]
        return L
    L += ["业务 / 职能 **%s** · 月份 %s · 已过 %d/%d 天(截至本报告周末)" % (b["business"], b["month"], b["elapsed"], b["days"]), "",
          "| 月预算 | 实际累计(账单) | 预算余额 | 月底预测(线性) | 档位 |", "|---|---|---|---|---|",
          "| %.2f %s | %.2f %s | %.2f %s | %.2f %s | %s |" % (b["monthly"], b["currency"], b["accumulated"], b["currency"],
                                                             b["remaining"], b["currency"], b["forecast"], b["currency"], b["tier"][0]),
          "", "档位: %s — %s" % b["tier"], "", "| 周 | 计入(账单) | 待核实 | 明细 |", "|---|---|---|---|"]
    for w in b["weeks"]:
        L.append("| %s (%s~%s) | %.2f %s | %s | %s |" % (w["week"][5:], w["since"][5:], w["until"][5:], w["counted"], b["currency"],
                                                     ", ".join(w["pending"]) or "—",
                                                     "; ".join("%s %s%s" % (h, ("%.2f" % a) if a is not None else "待核实", " (%s)" % n if n else "") for h, a, n in w["entries"])))
    L += ["", "> " + BUDGET_RULE, ""]
    return L


def budget_html(b):
    H = ["<h2>月度预算状态</h2>"]
    if b is None or b["state"] == "none":
        H.append('<div class="card"><p>尚未提供 — %s。</p><p class="meta">%s</p></div>' % (esc(b["reason"] if b else "reports/budget.json 尚未提供"), esc(BUDGET_RULE)))
        return "".join(H)
    cls = {"正常": "ok", "超出但 ≤1.5×": "warn", "预计超过 1.5×": "fail"}.get(b["tier"][0], "")
    H.append('<p class="meta">业务 / 职能 <strong>%s</strong> · 月份 %s · 已过 %d/%d 天(截至本报告周末)</p>' % (esc(b["business"]), esc(b["month"]), b["elapsed"], b["days"]))
    kp = [("月预算", "%.2f %s" % (b["monthly"], b["currency"]), "reports/budget.json"),
          ("实际累计(账单)", "%.2f %s" % (b["accumulated"], b["currency"]), "只计分摊 / 实际,估算不计入"),
          ("预算余额", "%.2f %s" % (b["remaining"], b["currency"]), "月预算 − 累计"),
          ("月底预测(线性)", "%.2f %s" % (b["forecast"], b["currency"]), "%.2f× 月预算" % (b["ratio"] or 0)),
          ("档位", b["tier"][0], b["tier"][1])]
    H.append('<div class="kpis">' + "".join('<div class="kpi"><div class="l">%s</div><div class="v %s">%s</div><div class="s">%s</div></div>'
                                             % (esc(l), cls if l == "档位" else "", esc(v), esc(x)) for l, v, x in kp) + "</div>")
    H.append('<p>档位: <strong class="%s">%s</strong> — %s</p>' % (cls, esc(b["tier"][0]), esc(b["tier"][1])))
    H.append('<div class="card" style="padding:0;overflow:auto"><table><thead><tr><th>周</th><th class="n">计入(账单)</th><th>待核实</th><th>明细</th></tr></thead><tbody>')
    for w in b["weeks"]:
        H.append('<tr><td>%s <span class="meta">%s~%s</span></td><td class="n">%.2f %s</td><td>%s</td><td class="meta">%s</td></tr>' % (
            esc(w["week"][5:]), esc(w["since"][5:]), esc(w["until"][5:]), w["counted"], esc(b["currency"]), esc(", ".join(w["pending"]) or "—"),
            esc("; ".join("%s %s%s" % (h, ("%.2f" % a) if a is not None else "待核实", " (%s)" % n if n else "") for h, a, n in w["entries"]))))
    H.append("</tbody></table></div><p class=\"meta\">%s</p>" % esc(BUDGET_RULE))
    return "".join(H)


# ---------------------------------------------------------------- request (T6, #200): AI 资源申请
# A structured DRAFT for the company's existing approval flow. The tool validates the form, writes
# reports/requests/<yyyy-mm>-<human_id>-<slug>.json + .md, optionally makes a LOCAL commit — and never
# submits for approval, never buys, never calls the network. Closed loop lives in the json:
# status draft → confirmed → purchased (bill_refs) → expired; review_before_renewal before any renewal.

REQUEST_SCHEMA_REL = os.path.join("platform-internals", "schemas", "ai-resource-request.schema.json")
FORM_REQUIRED = ("kind", "resource", "business", "project", "purpose", "outcome", "amount", "currency",
                 "start", "end", "renewal", "allocation")
KIND_LABEL = {"new": "新购资源", "quota": "增加额度", "renewal": "续费"}
RENEWAL_LABEL = {"once": "一次性,不自动续费", "monthly": "按月自动续费", "yearly": "按年自动续费", "manual": "到期后人工确认"}
ALLOC_LABEL = {"single": "归属上述单一项目", "split": "多个项目分摊", "shared": "团队共享成本"}
STATUS_LABEL = {"draft": "草稿", "confirmed": "已确认", "purchased": "已购买", "expired": "已到期", "rejected": "未批准"}
REQUEST_PRINCIPLES = ("已有公司方案优先使用;外购或续费先确认再购买。",
                      "授权范围内的合理探索可以失败;应分享失败结论,避免团队重复付出同样的探索成本。",
                      "每周回看实际使用;续费前带出历史投入、利用情况和成果再决定继续、调整或停止。")
REQUEST_CLOSING = "确认与报销:按公司现行流程办理;购买或续费前取得确认,保留账单与付款凭证。此草稿不指定审批人,不代表已批准。"


def _slug(text):
    s = re.sub(r"[^a-z0-9一-鿿]+", "-", str(text).lower()).strip("-")
    return s[:40] or "request"


def build_request(form, owner, team, ws_sha, schema, currencies):
    """form (dict from --form) → (request dict, errors). Every problem names its field."""
    errs = []
    if not isinstance(form, dict):
        return None, ["form must be a JSON object"]
    unknown = [k for k in form if k not in FORM_REQUIRED + ("split", "note")]
    if unknown:
        errs.append("form: unknown field(s) %s" % ", ".join(unknown))
    for k in FORM_REQUIRED:
        v = form.get(k)
        if v is None or (isinstance(v, str) and not v.strip()):
            errs.append("form.%s: required (带 * 的项目为生成草稿所需)" % k)
    if errs:
        return None, errs
    cur = str(form["currency"]).strip().upper()
    if cur not in currencies:
        errs.append("form.currency: unknown currency %r (known: %s; 其他币种在补充说明注明并按现行流程换算)" % (form["currency"], ", ".join(currencies)))
    try:
        d0 = datetime.strptime(str(form["start"]), "%Y-%m-%d").date()
        d1 = datetime.strptime(str(form["end"]), "%Y-%m-%d").date()
        if d1 < d0:
            errs.append("form.end: 结束日期 %s 不能早于开始日期 %s" % (d1, d0))
    except ValueError:
        errs.append("form.start / form.end: must be YYYY-MM-DD")
        d0 = None
    split = form.get("split") or []
    if form.get("allocation") == "split":
        tot = sum((x.get("ratio") or 0) for x in split if isinstance(x, dict))
        if not split or abs(tot - 100) > 1e-9:
            errs.append("form.split: 分摊比例合计必须为 100%%(现在 %s%%)" % tot)
    elif split:
        errs.append("form.split: only meaningful when allocation = split")
    try:
        amount = float(form["amount"])
        if amount < 0:
            errs.append("form.amount: must be >= 0")
    except (TypeError, ValueError):
        errs.append("form.amount: must be a number")
        amount = 0
    if errs:
        return None, errs
    req = {
        "schema_version": 1,
        "id": "%s-%s-%s" % (d0.strftime("%Y-%m"), owner, _slug(form["resource"])),
        "created_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "human_id": owner, "team": team,
        "kind": form["kind"], "resource": str(form["resource"]).strip(), "business": str(form["business"]).strip(),
        "project": str(form["project"]).strip(), "purpose": str(form["purpose"]).strip(), "outcome": str(form["outcome"]).strip(),
        "amount": amount, "currency": cur, "start": d0.isoformat(), "end": d1.isoformat(),
        "renewal": form["renewal"], "allocation": form["allocation"], "split": split, "note": str(form.get("note") or "").strip(),
        "status": "draft", "bill_refs": [], "review_before_renewal": None, "workspace_sha": ws_sha,
    }
    errs = validate(req, schema, "request")
    return (None, errs) if errs else (req, [])


def render_request_md(r):
    L = ["# AI 资源申请草稿(未提交审批)", "",
         "编号 %s · 状态 %s · 创建 %s · ws-%s" % (r["id"], STATUS_LABEL[r["status"]], r["created_at"][:16], (r["workspace_sha"] or "unknown")[:6]), "",
         "| 项 | 内容 |", "|---|---|",
         "| 申请人 | %s(%s) |" % (r["human_id"], r["team"]),
         "| 申请类型 | %s |" % KIND_LABEL[r["kind"]],
         "| 工具 / 模型 / 资源 | %s |" % r["resource"],
         "| 归属业务 / 职能 | %s |" % r["business"],
         "| 团队 / 项目 | %s |" % r["project"],
         "| 预计完整付款金额 | %s %s |" % (("%.2f" % r["amount"]).rstrip("0").rstrip("."), r["currency"]),
         "| 服务周期 | %s 至 %s |" % (r["start"], r["end"]),
         "| 续费方式 | %s |" % RENEWAL_LABEL[r["renewal"]],
         "| 费用归属方式 | %s%s |" % (ALLOC_LABEL[r["allocation"]], ("(" + "; ".join("%s %s%%" % (x["target"], x["ratio"]) for x in r["split"]) + ")") if r["split"] else ""),
         "", "## 工作用途与现有资源不足", "", r["purpose"], "",
         "## 预期产出与验证方式", "", r["outcome"], "",
         "## 补充说明", "", r["note"] or "无", "",
         "## 闭环", "",
         "- 状态: %s(draft → confirmed → purchased → expired)" % r["status"],
         "- 关联账单: %s" % (", ".join(r["bill_refs"]) or "购买后关联账单 / 付款凭证(bill_refs)"),
         "- 续费前复评: %s" % (("%s — %s(%s,%s)" % (r["review_before_renewal"]["verdict"], r["review_before_renewal"]["reason"],
                                                    r["review_before_renewal"]["reviewed_by"], r["review_before_renewal"]["reviewed_at"][:10]))
                              if r["review_before_renewal"] else "到期前带出历史投入、利用情况与成果再决定(review_before_renewal)"),
         "", "## 原则", ""] + ["- " + x for x in REQUEST_PRINCIPLES] + ["", "---", REQUEST_CLOSING, ""]
    return "\n".join(L)


def load_requests(reports_dir, schema):
    """All reports/requests/*.json that validate; broken ones are returned with the reason."""
    d = os.path.join(reports_dir, "reports", "requests")
    good, bad = [], []
    if not os.path.isdir(d):
        return good, bad
    for fn in sorted(os.listdir(d)):
        if not fn.endswith(".json"):
            continue
        try:
            r = load_json(os.path.join(d, fn))
        except (OSError, json.JSONDecodeError) as e:
            bad.append((fn, "not readable JSON: %s" % e))
            continue
        errs = validate(r, schema, "request")
        if errs:
            bad.append((fn, "; ".join(errs[:2])))
        else:
            good.append(r)
    return good, bad


def requests_for_week(reqs, since, until):
    """(new this week, renewal reviews due) — a request is 'due' when it renews (not once), is not
    expired / rejected, ends within 30 days after the week, and has no review_before_renewal yet."""
    new, due = [], []
    for r in reqs:
        try:
            created = from_iso(r["created_at"]).date()
        except ValueError:
            created = None
        if created and since <= created <= until:
            new.append(r)
        if r["status"] in ("expired", "rejected") or r["renewal"] == "once" or r["review_before_renewal"]:
            continue
        end = datetime.strptime(r["end"], "%Y-%m-%d").date()
        if end < since or end > until + timedelta(days=30):
            continue
        due.append(r)
    return new, due


def cmd_request_dispatch(args):
    if args.verb == "review":
        if not args.id:
            print("FAIL: request review needs an id (reports/requests/<id>.json)")
            return 2
        return cmd_request_review(args)
    if not args.form:
        print("FAIL: request needs --form <json> (or: request review <id>)")
        return 2
    return cmd_request(args)


def cmd_request(args):
    root = os.path.abspath(args.workspace_root) if args.workspace_root else os.path.dirname(_HERE)
    tool_root = os.path.dirname(_HERE)
    owner, team, _ = workspace_identity(root)
    if _placeholder(owner) or _placeholder(team):
        print("FAIL: workspace.yaml owner/team must be filled (owner=%r team=%r) — 申请人是人,不是 agent" % (owner, team))
        return 2
    reports_dir = os.path.abspath(args.reports_dir) if args.reports_dir else os.path.join(root, REPORTS_REL)
    if not ensure_reports_dir(reports_dir, tool_root, create=True):
        return 2
    try:
        form = load_json(args.form)
        schema = load_json(os.path.join(tool_root, REQUEST_SCHEMA_REL))
        currencies = load_mapping(args.mapping or os.path.join(tool_root, MAPPING_REL))["currencies"]
    except (OSError, ValueError, json.JSONDecodeError) as e:
        print("FAIL: %s" % e)
        return 2
    req, errs = build_request(form, owner, team, git_head(root), schema, currencies)
    if errs:
        print("FAIL: form rejected — nothing written:\n  " + "\n  ".join(errs))
        return 2
    out_dir = os.path.join(reports_dir, "reports", "requests")
    os.makedirs(out_dir, exist_ok=True)
    jp = os.path.join(out_dir, req["id"] + ".json")
    mp = os.path.join(out_dir, req["id"] + ".md")
    if os.path.isfile(jp) and not args.force:
        print("FAIL: %s exists — edit that file's status / fields, or pass --force to overwrite the draft" % jp)
        return 2
    with open(jp, "w", encoding="utf-8") as fh:
        json.dump(req, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    with open(mp, "w", encoding="utf-8") as fh:
        fh.write(render_request_md(req))
    print("OK: request draft written: %s (+ .md) — %s %s, %s %s, %s 至 %s, %s" % (
        jp, KIND_LABEL[req["kind"]], req["resource"], req["amount"], req["currency"], req["start"], req["end"], RENEWAL_LABEL[req["renewal"]]))
    if args.commit:
        rel = [os.path.relpath(p, reports_dir) for p in (jp, mp)]
        if subprocess.run(["git", "-C", reports_dir, "rev-parse", "--git-dir"], capture_output=True).returncode != 0:
            print("WARN: --commit skipped: %s is not a git checkout" % reports_dir)
        else:
            subprocess.run(["git", "-C", reports_dir, "add", "--"] + rel, check=False)
            r = subprocess.run(["git", "-C", reports_dir, "commit", "-q", "-m", "ai-usage-weekly: request %s" % req["id"]],
                               capture_output=True, text=True)
            print("OK: committed in %s" % reports_dir if r.returncode == 0
                  else "WARN: nothing to commit or commit failed: %s" % (r.stdout + r.stderr).strip())
    print("NEXT: 这是草稿,不是审批 — 按公司现行流程确认;购买或续费前取得确认;购买后把账单来源写进 bill_refs 并把 status 改为 purchased。"
          " This tool never submits, buys, or pushes.")
    return 0


def review_request(reports_dir, req, schema):
    """Gather, for the request's service period, the bills that reference it, the requester's
    usage per week, and narrative items that mention the resource. Facts only — no verdict."""
    start = datetime.strptime(req["start"], "%Y-%m-%d").date()
    end = datetime.strptime(req["end"], "%Y-%m-%d").date()
    refs = [x.strip().lower() for x in req.get("bill_refs") or [] if str(x).strip()]
    res = req["resource"].lower()
    weeks = []
    rdir = os.path.join(reports_dir, "reports")
    for name in sorted(os.listdir(rdir)):
        if not re.match(r"^\d{4}-W\d{2}$", name):
            continue
        s0, s1, _ = resolve_window(name, None, None)
        if s1 < start or s0 > end:
            continue
        subs, _ = load_week(reports_dir, name, schema)
        spend, usage, outcomes, coarse = {}, None, [], []  # spend: {currency: amount} — never summed across currencies
        for sub in subs:
            c = sub["cost"]
            for blk in (c.get("allocated"), c.get("actual")):
                if not blk or blk.get("amount") is None:
                    continue
                hit = _match_bill_items(blk, refs, res)
                if hit is None:
                    continue
                amt, exact = hit
                cur = (blk.get("currency") or "?").upper()
                spend[cur] = spend.get(cur, 0.0) + amt
                if not exact:
                    coarse.append(sub["meta"]["human_id"])
                break  # allocated preferred; never count actual on top of it
            if sub["meta"]["human_id"] == req["human_id"]:
                u = sub["usage"]
                usage = {"requests": u["requests"], "tokens": u["input"] + u["output"] + u["cache_read"] + u["cache_creation"],
                         "estimated": c["estimated"].get("amount"), "pricing": c["estimated"].get("pricing_version")}
            n = sub.get("narrative")
            if n:
                if res in (n.get("summary") or "").lower():
                    outcomes.append((sub["meta"]["human_id"], "摘要", n["summary"]))
                for p in n.get("projects") or []:
                    for t in p.get("tasks") or []:
                        blob = " ".join(str(t.get(k) or "") for k in ("title", "detail", "deliverable", "evidence")).lower()
                        if res in blob or res in (n.get("summary") or "").lower() and t.get("evidence"):
                            outcomes.append((sub["meta"]["human_id"], p["name"], "%s — %s%s" % (
                                t["title"], t.get("deliverable") or "", (" · 证据: " + t["evidence"]) if t.get("evidence") else " · 无证据")))
        weeks.append({"week": name, "spend": spend, "usage": usage, "outcomes": outcomes, "coarse": coarse})
    return weeks


def _money_by_currency(d):
    return " + ".join("%.2f %s" % (v, k) for k, v in sorted(d.items())) if d else ""


def _match_bill_items(blk, refs, res):
    """(amount, exact) of the part of a cost block that belongs to the request, or None.
    With `items[]` (bills read by T2) only the rows whose own source matches count — exact. A block
    without items (hand-written --cost-file, pre-#203 files) can only be matched as a whole on its
    merged source string — coarse, flagged 未逐笔 in the review so nobody mistakes it for precision.
    An explicit bill_ref matches a source **whole** (case-insensitive, trimmed): `invoice-1` never
    matches `invoice-10`. A merged block source (`a; b`) is split on `;` and each part compared whole.
    Without bill_refs the resource name is searched as a substring — a name search, never "exact"."""
    def parts(src):
        return [x.strip().lower() for x in str(src or "").split(";") if x.strip()]
    def ok(src):
        if refs:
            return any(x in refs for x in parts(src))
        return res in str(src or "").lower()
    items = blk.get("items")
    if items:
        hits = [i for i in items if ok(i.get("source"))]
        return (sum(float(i.get("amount") or 0) for i in hits), bool(refs)) if hits else None
    return (blk["amount"], False) if ok(blk.get("source")) else None


def render_review_md(req, weeks):
    total = {}
    for w in weeks:
        for k, v in w["spend"].items():
            total[k] = total.get(k, 0.0) + v
    cur = req["currency"].upper()
    other = {k: v for k, v in total.items() if k != cur}
    comparison = "%.2f %s" % (total[cur], cur) if cur in total else "待核实(%s 无匹配账单)" % cur
    reqs = sum((w["usage"] or {}).get("requests", 0) for w in weeks)
    L = ["# 续费前复评草稿 — %s" % req["id"], "",
         "资源 **%s** · 申请人 %s · %s · 服务周期 %s 至 %s · %s · 状态 %s · 预计付款 %s %s" % (
             req["resource"], req["human_id"], KIND_LABEL[req["kind"]], req["start"], req["end"], RENEWAL_LABEL[req["renewal"]],
             STATUS_LABEL[req["status"]], req["amount"], req["currency"]), "",
         "预期产出与验证方式(申请时): %s" % req["outcome"], "",
         "## 历史投入(账单,匹配 bill_refs %s)" % (", ".join(req.get("bill_refs") or []) or "— 无 bill_refs,按资源名匹配来源"), "",
         "| 周 | 计入账单 | 申请人请求数 | token | 估算费用(估算) |", "|---|---|---|---|---|"]
    for w in weeks:
        u = w["usage"] or {}
        L.append("| %s | %s%s | %s | %s | %s |" % (w["week"], _money_by_currency(w["spend"]) or "待核实",
                                               (" (未逐笔: %s 的账单块无 items,按整块来源匹配)" % ", ".join(w["coarse"])) if w["coarse"] else "",
                                               fmt(u.get("requests", 0)) if u else "未提交", fmt(u.get("tokens", 0)) if u else "—",
                                               ("%s (价格表 %s)" % (money({"amount": u.get("estimated"), "currency": "USD"}), u.get("pricing"))) if u else "—"))
    L += ["| **合计** | **%s** | **%s** | | |" % (_money_by_currency(total) or "待核实", fmt(reqs)), "",
          "预算比对: 申请预计 %s %s vs 账单累计 %s(%s)%s。" % (
              req["amount"], cur, comparison,
              "%s 账单覆盖了周期内 %d 周" % (cur, sum(1 for w in weeks if cur in w["spend"])) if weeks else "周期内无提交",
              (";另有 %s 为其他币种,未换算、不计入比对 — 待换算" % _money_by_currency(other)) if other else ""),
          "", "## 成果(叙事中提到该资源的任务)", ""]
    outs = [o for w in weeks for o in w["outcomes"]]
    L += ["- %s · %s · %s" % o for o in outs] or ["- 无 — 叙事里没有提到该资源;续费前请申请人补充产出与验证结果"]
    L += ["", "## 复评结论(由人填写)", "",
          "- 结论: continue / adjust / stop —— 三选一",
          "- 理由:",
          "- 填入申请 json 的 `review_before_renewal`: `{\"verdict\": \"…\", \"reason\": \"…\", \"reviewed_by\": \"<human_id>\", \"reviewed_at\": \"<date>\"}`",
          "", "## 原则", ""] + ["- " + x for x in REQUEST_PRINCIPLES] + ["", "---", REQUEST_CLOSING, ""]
    return "\n".join(L)


def cmd_request_review(args):
    root = os.path.abspath(args.workspace_root) if args.workspace_root else os.path.dirname(_HERE)
    tool_root = os.path.dirname(_HERE)
    reports_dir = os.path.abspath(args.reports_dir) if args.reports_dir else os.path.join(root, REPORTS_REL)
    rp = os.path.join(reports_dir, "reports", "requests", args.id + ".json")
    if not os.path.isfile(rp):
        print("FAIL: request not found: %s" % rp)
        return 2
    try:
        req = load_json(rp)
        rschema = load_json(os.path.join(tool_root, REQUEST_SCHEMA_REL))
        schema = load_json(os.path.join(tool_root, SCHEMA_REL))
    except (OSError, json.JSONDecodeError) as e:
        print("FAIL: %s" % e)
        return 2
    errs = validate(req, rschema, "request")
    if errs:
        print("FAIL: request file invalid:\n  " + "\n  ".join(errs))
        return 2
    weeks = review_request(reports_dir, req, schema)
    mp = os.path.join(reports_dir, "reports", "requests", args.id + ".review.md")
    with open(mp, "w", encoding="utf-8") as fh:
        fh.write(render_review_md(req, weeks))
    total = {}
    for w in weeks:
        for k, v in w["spend"].items():
            total[k] = total.get(k, 0.0) + v
    print("OK: review draft written: %s — %d 周, 账单累计 %s, 结论留给人填(review_before_renewal)" % (
        mp, len(weeks), _money_by_currency(total) or "待核实"))
    return 0


# ---------------------------------------------------------------- monthly report (#359 / #360)
# One month = one LiteLLM key allocation file (real cost, split by key in proportion to tokens).
# The record reports/months/<YYYY-MM>/month.json is rewritten whole on every import, so a
# re-import replaces the month and never adds to it. It carries no key and no email: cost is
# grouped by the file's own Team column. Sections without a source stay null → 待接入, never 0.

MONTH_SCHEMA = "ai-usage-month/1"
TOTAL_TOLERANCE_USD = 0.01
_MONTH_NAMES = (("jan", "january"), ("feb", "february"), ("mar", "march"), ("apr", "april"), ("may",),
                ("jun", "june"), ("jul", "july"), ("aug", "august"), ("sep", "sept", "september"),
                ("oct", "october"), ("nov", "november"), ("dec", "december"))
_MONTH_NAME_NUM = {n: i for i, names in enumerate(_MONTH_NAMES, 1) for n in names}
_MN = "|".join(sorted(_MONTH_NAME_NUM, key=len, reverse=True))
_SEP = r"[\s_.\-]*"
_MONTH_PATTERNS = (
    (re.compile(r"(?<![a-z])(%s)(?![a-z])%s(?<!\d)(20\d\d)(?!\d)" % (_MN, _SEP)), "name"),   # september_2026
    (re.compile(r"(?<!\d)(20\d\d)(?!\d)%s(?<![a-z])(%s)(?![a-z])" % (_SEP, _MN)), "name"),   # 2026-september
    (re.compile(r"(?<!\d)(20\d\d)[\-_.](0?[1-9]|1[0-2])(?!\d)"), "num"),                    # 2026-09
    (re.compile(r"(?<!\d)(20\d\d)(0[1-9]|1[0-2])(?!\d)"), "num"),                            # 202609
    (re.compile(r"(?<!\d)(20\d\d)\s*年\s*(0?[1-9]|1[0-2])\s*月"), "num"),                   # 2026年9月
)


def month_from_filename(path):
    """The one calendar month YYYY-MM the file name states, or raise ValueError — the allocation file
    carries no month column, so its name is the only source (no name → rename the file, never a guess)."""
    name = os.path.splitext(os.path.basename(path))[0].lower()
    found = set()
    for rx, kind in _MONTH_PATTERNS:
        for g in rx.findall(name):
            if kind == "name":
                word, year = (g[0], g[1]) if g[0].isalpha() else (g[1], g[0])
                found.add("%s-%02d" % (year, _MONTH_NAME_NUM[word]))
            else:
                found.add("%s-%02d" % (g[0], int(g[1])))
    if len(found) == 1:
        return found.pop()
    hint = "rename it to state one month, e.g. allocation_september_2026.xlsx, 2026-09.xlsx or 2026年9月.xlsx"
    if not found:
        raise ValueError("file name %r states no month — %s" % (os.path.basename(path), hint))
    raise ValueError("file name %r states more than one month (%s) — %s"
                     % (os.path.basename(path), ", ".join(sorted(found)), hint))


# Git history of mounted repos (#363). Local git only: the operator pulls first, the tool never fetches.
# A commit counts in the month of its author date, in the team timezone. Merge commits are left out.
# "AI-assisted" = a Co-Authored-By trailer that names an AI tool. Work without the trailer is not seen,
# so the share is a lower bound and is labelled so.
AI_COAUTHOR_RX = re.compile(r"claude|anthropic|codex|openai|copilot|cursor|gemini|devin|aider|windsurf|qwen", re.I)
_PERSON_KEY_RX = re.compile(r"[^@\s]+@[^@\s]+\.[^@\s]+")      # a key named by an email is a person's key
_NOREPLY_RX = re.compile(r"^(?:\d+\+)?([^@]+)@users\.noreply\.github\.com$", re.I)
GIT_NOTE = "AI 协作 = 带有指向 AI 工具的 Co-Authored-By 行的提交;没有这一行的 AI 协作看不到,所以占比是下限"


def _tzinfo(name):
    """tzinfo for an IANA name or a fixed offset like +08:00 (what local_timezone() returns)."""
    m = re.fullmatch(r"([+-])(\d\d):?(\d\d)", name or "")
    if m:
        off = timedelta(hours=int(m.group(2)), minutes=int(m.group(3)))
        return timezone(-off if m.group(1) == "-" else off)
    from zoneinfo import ZoneInfo, available_timezones
    try:
        return ZoneInfo(name)
    except Exception:
        if not available_timezones():
            raise ValueError("timezone %r: this Python has no time zone data (on Windows: pip install tzdata)" % name)
        raise ValueError("unknown timezone %r (reports/team.json timezone)" % name)


def month_bounds(month, tz):
    y, mo = (int(x) for x in month.split("-"))
    return datetime(y, mo, 1, tzinfo=tz), datetime(y + (mo == 12), mo % 12 + 1, 1, tzinfo=tz)


def git_month(path, start, end):
    """One repo's non-merge commits with an author date in [start, end), read from the default branch
    (origin/HEAD when the clone has it, else HEAD). Raises ValueError when path is not a git repo."""
    def git(*a):
        return subprocess.run(["git", "-C", path] + list(a), capture_output=True, text=True, timeout=120)
    try:
        if git("rev-parse", "--git-dir").returncode != 0:
            raise ValueError("%s is not a git repo" % path)
        ref = "origin/HEAD" if git("rev-parse", "-q", "--verify", "refs/remotes/origin/HEAD").returncode == 0 else "HEAD"
        r = git("log", ref, "--no-merges",
                "--format=%H%x1f%aI%x1f%an%x1f%ae%x1f%s%x1f%(trailers:key=Co-authored-by,valueonly,separator=%x1d)%x1f%b%x1e")
    except (OSError, subprocess.SubprocessError) as e:
        raise ValueError("git log failed in %s: %s" % (path, e))
    if r.returncode != 0:
        raise ValueError("git log failed in %s: %s" % (path, r.stderr.strip()[:200]))
    commits = []
    for rec in r.stdout.split("\x1e"):
        f = rec.strip("\n").split("\x1f")
        if len(f) < 7:
            continue
        when = from_iso(f[1])
        if not start <= when < end:
            continue
        commits.append({"name": f[2], "email": f[3].lower(),
                        "ai": any(AI_COAUTHOR_RX.search(v) for v in f[5].split("\x1d") if v.strip()),
                        "revert": f[4].startswith("Revert ") or "This reverts commit " in f[6]})
    return {"repo": os.path.basename(os.path.normpath(path)), "ref": ref, "head": git_head(path), "commits": commits}


def _person_lookup(team):
    """reports/team.json `identities` ({"<email | GitHub login>": "<human_id>"}, case-insensitive) + `members`.
    None when the roster has no identities (or only placeholders) — then nobody is mapped and nothing is
    listed as unmapped."""
    ids = (team or {}).get("identities") if team and not team.get("_broken") else None
    if not isinstance(ids, dict) or not ids:
        return None
    # A starter roster keeps "<...>" placeholders; they map nobody, so a roster of only placeholders is none.
    alias = {str(k).strip().lower(): v.strip() for k, v in ids.items()
             if isinstance(v, str) and not _placeholder(v.strip()) and not _placeholder(str(k).strip())}
    if not alias:
        return None
    alias.update({m.lower(): m for m in team.get("members") or [] if isinstance(m, str) and not _placeholder(m)})

    def look(*keys):
        for k in keys:
            if k and k.lower() in alias:
                return alias[k.lower()]
        return None
    return look


def build_git(repos):
    if not repos:
        return None
    rows = []
    for g in sorted(repos, key=lambda g: g["repo"].lower()):
        cs = g["commits"]
        rows.append({"repo": g["repo"], "ref": g["ref"], "head": g["head"] or None, "commits": len(cs),
                     "ai_commits": sum(c["ai"] for c in cs), "reverts": sum(c["revert"] for c in cs),
                     "authors": len({c["email"] for c in cs})})
    return {"date": "author", "ai_rule": "Co-Authored-By trailer that names an AI tool (lower bound)", "repos": rows}


def build_people(spend, unalloc_keys, repos, look):
    """Cost keys and commit authors → human_id. Returns (people, unmapped), or (None, None) without a lookup.
    Cost is never split by repo: a person's cost and commits sit side by side."""
    if look is None:
        return None, None
    people, un_keys, un_authors = {}, {}, {}

    def person(hid):
        return people.setdefault(hid, {"human_id": hid, "teams": set(), "keys": set(), "cost_usd": None,
                                       "commits": 0, "ai_commits": 0, "reverts": 0, "repos": {}})
    for r in spend:
        if r["vk"] in unalloc_keys or not _PERSON_KEY_RX.fullmatch(r["vk"]):
            continue                               # non-person keys stay under their file team only
        hid = look(r["vk"])
        if hid is None:
            k = un_keys.setdefault(r["vk"], {"cost_usd": 0.0})
            k["cost_usd"] += r["cost_usd"]
            continue
        p = person(hid)
        p["teams"].add(r["team"])
        p["keys"].add(r["vk"])
        p["cost_usd"] = (p["cost_usd"] or 0.0) + r["cost_usd"]
    for g in repos or []:
        for c in g["commits"]:
            m = _NOREPLY_RX.match(c["email"])
            hid = look(c["email"], m.group(1) if m else None)
            if hid is None:
                a = un_authors.setdefault((g["repo"], c["email"]), {"repo": g["repo"], "name": c["name"], "email": c["email"], "commits": 0})
                a["commits"] += 1
                continue
            p = person(hid)
            rp = p["repos"].setdefault(g["repo"], {"commits": 0, "ai_commits": 0, "reverts": 0})
            for tgt in (p, rp):
                tgt["commits"] += 1
                tgt["ai_commits"] += c["ai"]
                tgt["reverts"] += c["revert"]
    rows = []
    for p in sorted(people.values(), key=lambda p: p["human_id"].lower()):
        rows.append(dict(p, teams=sorted(p["teams"], key=str.lower), keys=len(p["keys"]),
                         cost_usd=None if p["cost_usd"] is None else round(p["cost_usd"], 6)))
        if repos is None:                          # no repo read: commits are unknown, not 0
            rows[-1].update(commits=None, ai_commits=None, reverts=None, repos=None)
    # Unmapped keys are counted, not named: most belong to persons outside the repos read, and a list of
    # every key would bury the few authors the lead must map. The count and cost keep them visible.
    unmapped = {"keys": len(un_keys), "keys_cost_usd": round(sum(k["cost_usd"] for k in un_keys.values()), 6),
                "authors": sorted(un_authors.values(), key=lambda a: (a["repo"].lower(), a["email"]))}
    return rows, unmapped


def build_month(month, spend, summary, mapping, src_name, src_sha, ws_sha, repos=None, team=None, tz_name=None):
    unalloc_keys = set(mapping.get("allocation_unallocated_keys", []))
    teams, unalloc = {}, {"cost_usd": 0.0, "rows": 0}
    for r in spend:
        if r["vk"] in unalloc_keys:
            unalloc["cost_usd"] += r["cost_usd"]
            unalloc["rows"] += 1
            continue
        t = teams.setdefault(r["team"], {"team": r["team"], "cost_usd": 0.0, "tokens": 0, "keys": set()})
        t["cost_usd"] += r["cost_usd"]
        t["tokens"] += r.get("tokens") or 0
        t["keys"].add(r["vk"])
    team_rows = [{"team": t["team"], "cost_usd": round(t["cost_usd"], 6), "tokens": t["tokens"], "keys": len(t["keys"])}
                 for t in sorted(teams.values(), key=lambda t: t["team"].lower())]
    spend_total = sum(r["cost_usd"] for r in spend)
    file_total = sum(r["total_usd"] for r in summary)
    checks = [("合计一致", spend_total, file_total,
               "`%s` 合计 vs `%s` Total Cost (USD)" % (mapping["allocation_sheets"]["spend"], mapping["allocation_sheets"]["summary"]))]
    file_unalloc = None
    if summary and "unallocated_usd" in summary[0]:
        file_unalloc = sum(r["unallocated_usd"] for r in summary)
        checks.append(("未分摊一致", unalloc["cost_usd"], file_unalloc,
                       "%s 行 vs `%s` Unallocated (USD)" % (" / ".join(sorted(unalloc_keys)) or "未分摊",
                                                         mapping["allocation_sheets"]["summary"])))
    total_checks = [{"name": n, "status": "ok" if abs(a - b) <= TOTAL_TOLERANCE_USD else "fail",
                     "report_usd": round(a, 6), "file_usd": round(b, 6), "detail": d} for n, a, b, d in checks]
    git = build_git(repos)
    if git:
        git["timezone"] = tz_name
    people, unmapped = build_people(spend, unalloc_keys, repos, _person_lookup(team))
    return {
        "schema": MONTH_SCHEMA,
        "month": month,
        "currency": "USD",
        "nature": "allocated",
        "source": {"file": src_name, "sha256": src_sha, "spend_rows": len(spend), "summary_rows": len(summary)},
        "generated_at": datetime.now().astimezone().isoformat(timespec="seconds"),
        "workspace_sha": ws_sha or None,
        "tool": "ws-%s" % (ws_sha[:6] if ws_sha else "unknown"),
        "total": {"cost_usd": round(spend_total, 6), "file_total_usd": round(file_total, 6),
                  "unallocated_usd": round(unalloc["cost_usd"], 6), "unallocated_rows": unalloc["rows"],
                  "file_unallocated_usd": None if file_unalloc is None else round(file_unalloc, 6)},
        "checks": total_checks,
        "teams": team_rows,
        "git": git,
        "people": people,
        "unmapped": unmapped,
        "intake": None,
        "coverage": None,
        "ai_use": None,
        "delivery": None,
        "value": None,
        "not_connected": [{"key": k, "part": p, "reason": r} for k, p, r in NOT_CONNECTED],
    }


# Monthly view of the weekly data (#361). A week belongs to the month of its Sunday (its end date), so
# a week that crosses a month boundary counts in one month only. Submissions and requests are read
# as they are; neither format changes. The repo cost here is the price-table estimate (估算) — it is
# never shown as real cost and never added to the allocation file's amounts.
VERDICT_LABEL = {"continue": "继续", "adjust": "调整", "stop": "停止"}
# Parts of #22 with no data source yet (#359 requirement 5). Listed so the reader sees what is missing;
# each stays 待接入 until a data owner and a source exist — never 0.
NOT_CONNECTED = (
    ("quality", "质量对冲指标: 缺陷逃逸、复发、代码留存(回滚已在按仓库一节)", "尚无数据负责人和数据来源"),
    ("bug_bash", "Bug Bash 有效性: 参与人数、发现 bug 数、严重程度", "尚无数据负责人和数据来源"),
    ("value_hypothesis", "价值假设与回收: 预期收益、衡量方式、回收结果(#26 字段)", "#26 的价值假设字段尚未接入"),
    ("maturity", "AI 应用模式 / 成熟度阶段、项目类型、工具可用性原因码", "尚无指标口径"),
)


def month_weeks(reports_dir, month):
    """ISO week folders under reports/ whose Sunday falls in month (YYYY-MM), in order."""
    rdir = os.path.join(reports_dir, "reports")
    out = []
    for name in sorted(os.listdir(rdir)) if os.path.isdir(rdir) else []:
        if not re.match(r"^\d{4}-W\d{2}$", name):
            continue
        try:
            s0, s1, _ = resolve_window(name, None, None)
        except ValueError:
            continue
        if s1.strftime("%Y-%m") == month:
            out.append((name, s0, s1))
    return out


def build_month_view(reports_dir, month, schema, req_schema, people, total_usd):
    """(ai_use, delivery, value, coverage, intake) for the month. A section with no source is None → 待接入."""
    weeks = month_weeks(reports_dir, month)
    subs, rejected = [], []
    for name, _, _ in weeks:
        s, r = load_week(reports_dir, name, schema)
        subs += s
        rejected += [("%s/%s" % (name, fn), why) for fn, why in r]
    a = aggregate(subs, rejected, None) if subs else None
    submitted = sorted({s["meta"]["human_id"] for s in subs}, key=str.lower)
    intake = {"weeks": [{"week": n, "since": s0.isoformat(), "until": s1.isoformat()} for n, s0, s1 in weeks],
              "submissions": len(subs), "rejected": [{"file": f, "reason": why} for f, why in rejected]}
    ai_use = delivery = None
    if a:
        tokens = a["input"] + a["output"] + a["cache_read"] + a["cache_creation"]
        agents = {}
        for s in subs:
            for ag, v in ((s["usage"].get("by_agent") or {}).items()):
                if v:
                    d = agents.setdefault(ag, {"tokens": 0, "people": set()})
                    d["tokens"] += sum(v.get(k, 0) for k in ("input", "output", "cache_read", "cache_creation"))
                    d["people"].add(s["meta"]["human_id"])
        # Repo rows and their people come from usage only: a bucket that a submission lists only under
        # `git` (git_stats() counts every author) has no tokens and must not add a row or a person.
        used = {}
        for s in subs:
            for bk, v in s["usage"]["by_bucket"].items():
                if v.get("tokens", 0) or v.get("requests", 0):
                    used.setdefault(bk, set()).add(s["meta"]["human_id"])
        by_person = {}
        for p in a["people"]:
            d = by_person.setdefault(p["human_id"], {"tokens": 0, "requests": 0, "weeks": set(), "repos": set()})
            d["tokens"] += p["tokens"]
            d["requests"] += p["requests"]
            d["weeks"].add(p["week"])
            d["repos"].update(bk for bk in p["buckets"] if p["human_id"] in used.get(bk, ()))
        ai_use = {
            "estimate_note": "估算 = token × 价格表,不是账单;不与分摊文件的实际费用相加",
            "requests": a["requests"], "tokens": tokens,
            "estimated_usd": a["est_total"], "pricing_versions": a["pricing_versions"], "unpriced_models": a["est_unpriced"],
            "by_repo": [{"repo": b, "tokens": v["tokens"], "requests": v["requests"],
                         "people": sorted(used[b], key=str.lower)}
                        for b, v in sorted(a["by_bucket"].items(), key=lambda kv: kv[0].lower()) if b in used],
            "by_person": [{"human_id": h, "tokens": v["tokens"], "requests": v["requests"], "weeks": len(v["weeks"]),
                           "repos": sorted(v["repos"], key=str.lower)}
                          for h, v in sorted(by_person.items(), key=lambda kv: kv[0].lower())],
            "by_model": [{"model": k, "requests": v["requests"], "estimated_usd": v["cost"]}
                         for k, v in sorted(a["by_model"].items(), key=lambda kv: kv[0].lower())],
            "by_agent": [{"agent": k, "tokens": v["tokens"], "people": len(v["people"])} for k, v in sorted(agents.items())],
            "methods": [{"who": h, "item": x} for h, x in a["methods"]],
            "issues": [{"who": h, "item": x} for h, x in a["issues"]],
            "resource_needs": [{"who": h, "item": x} for h, x in a["resource_needs"]],
        }
        dl = sorted(a["deliverables"].values(), key=lambda d: (d["project"].lower(), d["title"].lower()))
        delivery = {"deliverables": [dict(d, people=sorted(d["people"], key=str.lower)) for d in dl if d["evidence"]],
                    "no_evidence": a["no_evidence"]}
    value = None
    if os.path.isdir(os.path.join(reports_dir, "reports", "requests")):
        reqs, bad = load_requests(reports_dir, req_schema)
        y, mo = (int(x) for x in month.split("-"))
        m0, m1 = date(y, mo, 1), date(y + (mo == 12), mo % 12 + 1, 1) - timedelta(days=1)
        new, due = requests_for_week(reqs, m0, m1)
        reviewed = [r for r in reqs if r["review_before_renewal"]
                    and r["review_before_renewal"]["reviewed_at"][:7] == month]

        def row(r):
            rv = r["review_before_renewal"]
            return {"id": r["id"], "human_id": r["human_id"], "kind": r["kind"], "resource": r["resource"],
                    "amount": r["amount"], "currency": r["currency"], "start": r["start"], "end": r["end"],
                    "status": r["status"], "outcome": r["outcome"], "verdict": rv["verdict"] if rv else None,
                    "verdict_reason": rv["reason"] if rv else None}
        value = {"new": [row(r) for r in new], "reviewed": [row(r) for r in reviewed], "due": [row(r) for r in due],
                 "rejected": [{"file": f, "reason": why} for f, why in bad]}
    coverage = None
    if subs:
        coverage = {"submitted": submitted, "cost_persons": None, "submitted_with_cost": None,
                    "cost_covered_usd": None, "cost_share": None}
        if people is not None:
            with_cost = [p for p in people if p["cost_usd"] is not None]
            hit = [p for p in with_cost if p["human_id"].lower() in {h.lower() for h in submitted}]
            covered = sum(p["cost_usd"] for p in hit)
            coverage.update({"cost_persons": len(with_cost), "submitted_with_cost": len(hit),
                             "cost_covered_usd": round(covered, 6),
                             "cost_share": round(covered / total_usd, 6) if total_usd else None})
    return ai_use, delivery, value, coverage, intake


def _coverage_text(cv):
    if cv is None:
        return "覆盖: 待接入(本月没有周报)"
    s = "覆盖: %d 人提交周报" % len(cv["submitted"])
    if cv["cost_persons"] is None:
        return s + ";成本文件里的人: 待接入(reports/team.json 没有 identities)"
    return s + ";成本文件里已映射 %d 人,其中 %d 人提交,覆盖实际费用 %s(占本月 %s)" % (
        cv["cost_persons"], cv["submitted_with_cost"], usd(cv["cost_covered_usd"]),
        "—" if cv["cost_share"] is None else _share(cv["cost_share"], 1))


def _git_cells(p):
    """(commits, AI share, reverts) for one person; 待接入 when no repo was read — never 0."""
    if p["commits"] is None:
        return ("待接入", "待接入", "待接入")
    return (str(p["commits"]), _share(p["ai_commits"], p["commits"]), str(p["reverts"]))


def month_history(months_dir):
    """One row per imported month (reports/months/*/month.json), oldest first — for the month view."""
    rows = []
    for name in sorted(os.listdir(months_dir)) if os.path.isdir(months_dir) else []:
        p = os.path.join(months_dir, name, "month.json")
        if not re.match(r"^\d{4}-\d{2}$", name) or not os.path.isfile(p):
            continue
        try:
            h = load_json(p)
        except (OSError, ValueError):
            continue
        g, u, it = h.get("git"), h.get("ai_use"), h.get("intake")
        rows.append({"month": name, "cost_usd": (h.get("total") or {}).get("cost_usd"),
                     "unallocated_usd": (h.get("total") or {}).get("unallocated_usd"), "teams": len(h.get("teams") or []),
                     "checks_ok": all(c.get("status") == "ok" for c in h.get("checks") or []),
                     "commits": sum(r["commits"] for r in g["repos"]) if g else None,
                     "ai_commits": sum(r["ai_commits"] for r in g["repos"]) if g else None,
                     "submissions": it.get("submissions") if it else None,
                     "estimated_usd": u.get("estimated_usd") if u else None})
    return rows


def _share(v, total):
    """Share of the month total; a non-zero share under 0.05% reads <0.1%, never 0.0% (same rule as usd())."""
    if not total:
        return "—"
    p = 100.0 * v / total
    return "<0.1%" if 0 < p < 0.05 else "%.1f%%" % p


_MONTH_CSS = """
nav.views{display:flex;gap:6px;margin:16px 0 4px;flex-wrap:wrap}nav.views button.on{background:var(--ink);color:var(--surface);border-color:var(--ink)}
html.js section[data-view]:not(.on){display:none}
.hint{color:var(--ink2);font-size:13px;margin:4px 0 10px}ul.summary{margin:16px 0;padding-left:20px}ul.summary li{margin:4px 0}
details{margin:8px 0}details>summary{cursor:pointer;color:var(--ink2);font-size:14px;padding:6px 0}
table.sortable th{cursor:pointer;user-select:none}table.sortable th::after{content:" \\2195";color:var(--muted)}
table.sortable th[aria-sort=ascending]::after{content:" \\2191"}table.sortable th[aria-sort=descending]::after{content:" \\2193"}
"""

# Views and sorting (#362). Only the repo tables sort; team and person tables never carry a sort control,
# so the page itself cannot rank persons or teams (#22 非目标). Without script every section shows.
_MONTH_JS = """
(function(){var d=document.documentElement;d.classList.add('js');
var bs=document.querySelectorAll('nav.views button'),ss=document.querySelectorAll('section[data-view]');
function show(v){bs.forEach(function(b){b.classList.toggle('on',b.dataset.view===v);b.setAttribute('aria-pressed',b.dataset.view===v)});
ss.forEach(function(s){s.classList.toggle('on',v==='all'||s.dataset.view===v)});}
bs.forEach(function(b){b.addEventListener('click',function(){show(b.dataset.view)})});show('all');
document.querySelectorAll('table.sortable').forEach(function(t){t.querySelectorAll('th').forEach(function(th,i){
th.addEventListener('click',function(){var asc=th.getAttribute('aria-sort')!=='ascending';
t.querySelectorAll('th').forEach(function(x){x.removeAttribute('aria-sort')});th.setAttribute('aria-sort',asc?'ascending':'descending');
var tb=t.tBodies[0],rows=Array.prototype.slice.call(tb.rows);
function key(r){var c=r.cells[i],v=c.getAttribute('data-v');return v===null?c.textContent.trim().toLowerCase():(v===''?null:parseFloat(v));}
rows.sort(function(a,b){var x=key(a),y=key(b);if(x===y)return 0;if(x===null)return 1;if(y===null)return -1;
return (x<y?-1:1)*(asc?1:-1);});rows.forEach(function(r){tb.appendChild(r)});});});});})();
"""


def _html_table(heads, rows, sortable=False):
    """heads: a name starting with ">" is a number column. A cell may be (display, value): value goes to
    data-v so the sort uses the number, not the text (None sorts last)."""
    def td(h, c):
        cls = ' class="n"' if h.startswith(">") else ""
        if isinstance(c, tuple):
            return '<td%s data-v="%s">%s</td>' % (cls, "" if c[1] is None else c[1], esc(c[0]))
        return "<td%s>%s</td>" % (cls, esc(c))
    return '<table%s><thead><tr>%s</tr></thead><tbody>%s</tbody></table>' % (
        ' class="sortable"' if sortable else "",
        "".join('<th class="n">%s</th>' % esc(h[1:]) if h.startswith(">") else "<th>%s</th>" % esc(h) for h in heads),
        "".join("<tr>%s</tr>" % "".join(td(h, c) for h, c in zip(heads, r)) for r in rows))


def _person_rows(m):
    """One row per person: weekly tokens next to git commits. Weekly rows are keyed by human_id; git
    rows exist only when reports/team.json has identities. Name order, never a sort control."""
    u, P = m["ai_use"], m["people"]
    tok = {r["human_id"].lower(): r for r in (u["by_person"] if u else [])}
    git = {p["human_id"].lower(): p for p in (P or [])}
    names = {}
    for h in [r["human_id"] for r in (u["by_person"] if u else [])] + [p["human_id"] for p in (P or [])]:
        names.setdefault(h.lower(), h)
    rows = []
    for k in sorted(names, key=lambda k: names[k].lower()):
        t, p = tok.get(k), git.get(k)
        tc = ("待接入", "待接入") if u is None else (("无周报", "无周报") if t is None else (fmt(t["tokens"]), fmt(t["requests"])))
        gc = ("待接入",) * 3 if P is None else (("未映射",) * 3 if p is None else _git_cells(p))
        rows.append((names[k],) + tc + gc)
    return rows


def _repo_rows(m):
    """One row per repo: weekly tokens next to git commits. A cell is (display, value) so the sort
    uses the number. 待接入 = the source is missing; — = the source has no row for this repo."""
    g, u = m["git"], m["ai_use"]
    gr = {r["repo"]: r for r in (g["repos"] if g else [])}
    ur = {r["repo"]: r for r in (u["by_repo"] if u else [])}

    def cell(src, row, f):
        if src is None:
            return ("待接入", None)
        if row is None:
            return ("—", None)
        return f(row)
    rows = []
    for name in sorted(set(gr) | set(ur), key=str.lower):
        a, r = ur.get(name), gr.get(name)
        rows.append((name,
                     cell(u, a, lambda x: (fmt(x["tokens"]), x["tokens"])),
                     cell(u, a, lambda x: (fmt(x["requests"]), x["requests"])),
                     cell(g, r, lambda x: (str(x["commits"]), x["commits"])),
                     cell(g, r, lambda x: (_share(x["ai_commits"], x["commits"]),
                                           round(x["ai_commits"] / x["commits"], 6) if x["commits"] else None)),
                     cell(g, r, lambda x: (str(x["reverts"]), x["reverts"])),
                     ", ".join(a["people"]) if a else "—"))
    return rows


_VIEWS = (("overview", "概览"), ("person", "按人"), ("repo", "按仓库"), ("team", "成本"), ("value", "交付与价值"),
          ("month", "各月"), ("detail", "详情"))
_MENU = (("all", "全部"),) + _VIEWS[1:]


def month_blocks(m, history):
    """The whole page except the header and the four cards, as neutral blocks that both renderers print:
    ("view", k) ("h2", t) ("h3", t) ("p", t) ("note", t) ("ul", items) ("table", heads, rows[, "sort"])
    ("fold", t) ("endfold",). A head starting with ">" is a number column. The page shows no 估算."""
    B = []
    tot, g, u, P = m["total"], m["git"], m["ai_use"], m["people"]
    it = m.get("intake") or {}
    weeks = ", ".join(w["week"] for w in it.get("weeks") or []) or "无"
    fails = [c for c in m["checks"] if c["status"] != "ok"]
    checks = ("table", ["校验", "结果", ">报告", ">文件", "说明"],
              [(c["name"], "通过" if c["status"] == "ok" else "未通过", usd(c["report_usd"]), usd(c["file_usd"]), c["detail"])
               for c in m["checks"]])

    B += [("view", "person"), ("h2", "按人(名称排序)")]
    if u is None and P is None:
        B.append(("p", "待接入(本月没有周报;reports/team.json 没有 identities)"))
    else:
        B.append(("note", "Tokens 来自各人本机的周报(周: %s,按周日所在月份计入)。提交来自代码仓。%s。不做排名。" % (
            weeks, _coverage_text(m.get("coverage")))))
        B.append(("table", ["人", ">Tokens", ">请求", ">提交", ">AI 协作占比(下限)", ">回滚"], _person_rows(m)))

    B += [("view", "repo"), ("h2", "按仓库")]
    if u is None and g is None:
        B.append(("p", "待接入(本月没有周报;没有读取代码仓)"))
    else:
        B.append(("note", "%s。按作者日期计入月份,不含合并提交。other = 不在本工作区内的会话。点表头排序。" % GIT_NOTE))
        B.append(("table", ["仓库", ">Tokens", ">请求", ">提交", ">AI 协作占比(下限)", ">回滚", "人"], _repo_rows(m), "sort"))

    B += [("view", "team"), ("h2", "成本(按团队,名称排序)")]
    B.append(("ul", ["合计 %s(分摊文件的实际费用) · 未分摊 %s · 校验 %d / %d 通过" % (
        usd(tot["cost_usd"]), usd(tot["unallocated_usd"]), len(m["checks"]) - len(fails), len(m["checks"]))]))
    B.append(("table", ["团队", ">实际费用", ">占比"],
              [(t["team"], usd(t["cost_usd"]), _share(t["cost_usd"], tot["cost_usd"])) for t in m["teams"]]
              + ([("未分摊", usd(tot["unallocated_usd"]), _share(tot["unallocated_usd"], tot["cost_usd"]))]
                 if tot["unallocated_rows"] else [])))
    if fails:
        B.append(checks)

    d, v = m["delivery"], m["value"]
    B += [("view", "value"), ("h2", "交付与价值")]
    if d is None:
        B.append(("p", "交付: 待接入(%s 没有周报)" % m["month"]))
    else:
        B.append(("ul", ["交付: %s · %s(%s)%s" % (x["project"], x["title"], x["evidence"],
                                                  " · " + ", ".join(x["people"]) if x["people"] else "")
                         for x in d["deliverables"]] or ["交付: 无有证据的交付物"]))
        B.append(("note", "同一证据只算一次。没有证据的任务: %d(不算交付物)。" % d["no_evidence"]))
    if v is None:
        B.append(("p", "价值: 待接入(reports/requests/ 没有申请)"))
    else:
        def item(label, r, last):
            return "%s: %s · %s · %s %s · %s 至 %s · %s · %s" % (
                label, r["human_id"], r["resource"], ("%.2f" % r["amount"]).rstrip("0").rstrip("."), r["currency"],
                r["start"], r["end"], STATUS_LABEL.get(r["status"], r["status"]), last)
        items = [item("新申请", r, "预期: %s" % r["outcome"]) for r in v["new"]] \
            + [item("复评", r, "%s — %s" % (VERDICT_LABEL.get(r["verdict"], r["verdict"]), r["verdict_reason"])) for r in v["reviewed"]] \
            + [item("待复评(30 天内到期)", r, "预期: %s" % r["outcome"]) for r in v["due"]]
        B.append(("ul", items or ["价值: 本月没有新申请、复评或待复评"]))
        B.append(("note", "按申请创建 / 复评日期计入本月。"))

    B += [("view", "month"), ("h2", "各月(已导入,按月份排序)")]
    if history:
        B += [("table", ["月份", ">实际费用", ">未分摊", "校验", ">提交", ">AI 协作占比(下限)", ">周报"],
                         [(h["month"], "待接入" if h["cost_usd"] is None else usd(h["cost_usd"]),
                           "待接入" if h["unallocated_usd"] is None else usd(h["unallocated_usd"]), "通过" if h["checks_ok"] else "未通过",
                           "待接入" if h["commits"] is None else str(h["commits"]),
                           "待接入" if h["commits"] is None else _share(h["ai_commits"], h["commits"]),
                           "待接入" if not h["submissions"] else str(h["submissions"])) for h in history])]

    parts = [x for x, on in (("校验", not fails), ("模型", u is not None), ("方法与问题", u is not None),
                             ("按人实际费用", P is not None), ("未映射", P is not None)) if on]
    B += [("view", "detail"), ("h2", "详情"), ("fold", ("、".join(parts) + " — 点开") if parts else "无")]
    if not fails:
        B += [("h3", "校验"), checks]
    if u is not None:
        B += [("h3", "模型与 Agent(周报)"),
              ("table", ["模型", ">请求"], [(r["model"], fmt(r["requests"])) for r in u["by_model"]])]
        if u["by_agent"]:
            B.append(("table", ["Agent", ">Tokens", ">人数"], [(r["agent"], fmt(r["tokens"]), r["people"]) for r in u["by_agent"]]))
        B += [("h3", "方法 / 问题 / 额度需求(周报)"),
              ("ul", [("%s: 无" % label) if not u[key] else "; ".join("%s — %s" % (x["who"], x["item"]) for x in u[key])
                      for key, label in (("methods", "可复用的方法"), ("issues", "问题"), ("resource_needs", "额度 / 资源需求"))])]
    if P is not None:
        un = m["unmapped"]
        B += [("h3", "按人实际费用(分摊文件)"), ("note", "费用不按仓库拆分。"),
              ("table", ["人", "团队", ">实际费用", ">Keys"],
               [(p["human_id"], " / ".join(p["teams"]) or "—", "—" if p["cost_usd"] is None else usd(p["cost_usd"]), p["keys"]) for p in P]),
              ("h3", "未映射(在 reports/team.json identities 里补上)"),
              ("ul", ["作者 %s <%s> · %s · %d 次提交" % (a["name"], a["email"], a["repo"], a["commits"]) for a in un["authors"]]
               + ["未映射的个人 key: %d 个, %s(只计数;费用仍在按团队里)" % (un["keys"], usd(un["keys_cost_usd"]))])]
    B.append(("endfold",))
    return B


def render_month_md(m, history=None):
    L = ["# AI 月度报告 %s" % m["month"], "",
         "> 初版月报(#359)。实际费用来自分摊文件。人和团队按名称排序,不做排名。缺数据显示待接入,不显示 0。", "",
         "- 来源: `%s` (sha256 %s…, %d 行) · 生成: %s · 工具 %s" % (
             m["source"]["file"], m["source"]["sha256"][:12], m["source"]["spend_rows"], m["generated_at"], m["tool"])]
    for b in month_blocks(m, history or []):
        k = b[0]
        if k in ("view", "endfold"):
            continue
        if k == "fold":
            L += ["", "> %s" % b[1]]
        elif k in ("h2", "h3"):
            L += ["", "%s %s" % ("##" if k == "h2" else "###", b[1]), ""]
        elif k == "p":
            L += [b[1], ""]
        elif k == "note":
            L += ["> " + b[1], ""]
        elif k == "ul":
            L += ["- %s" % x for x in b[1]] + [""]
        else:
            heads, rows = b[1], b[2]
            L += ["| %s |" % " | ".join(h.lstrip(">") for h in heads),
                  "|%s|" % "|".join("---:" if h.startswith(">") else "---" for h in heads)]
            L += ["| %s |" % " | ".join(str(c[0] if isinstance(c, tuple) else c).replace("|", "/") for c in r) for r in rows] + [""]
    L.append("")
    return "\n".join(L)


def render_month_html(m, history=None):
    tot, g, u, dl, val = m["total"], m["git"], m["ai_use"], m["delivery"], m["value"]
    fails = [c for c in m["checks"] if c["status"] != "ok"]
    cv = m.get("coverage")
    V = {k: [] for k, _ in _VIEWS}

    def card(label, value, sub):
        return '<div class="kpi"><div class="l">%s</div><div class="v">%s</div><div class="s">%s</div></div>' % (esc(label), esc(value), esc(sub))
    H = ['<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">',
         "<title>AI 月度报告 %s</title><style>%s%s</style></head><body><main>" % (esc(m["month"]), _CSS, _MONTH_CSS),
         '<header><div><h1>AI 月度报告 %s</h1><div class="meta">来源 %s (sha256 %s…) · 生成 %s · 工具 %s</div></div>'
         '<button id="theme" type="button">浅色 / 深色</button>' % (
             esc(m["month"]), esc(m["source"]["file"]), esc(m["source"]["sha256"][:12]), esc(m["generated_at"]), esc(m["tool"]))]
    if fails:
        H.append('<div class="alert"><strong>校验未通过:</strong> ' + "; ".join(
            "%s — 报告 %s, 文件 %s" % (esc(c["name"]), esc(usd(c["report_usd"])), esc(usd(c["file_usd"]))) for c in fails) + "</div>")
    H.append("</header>")
    H.append('<p class="hint">初版月报(#359)。实际费用来自分摊文件。人和团队按名称排序,不做排名。缺数据显示待接入,不显示 0。</p>')
    H.append('<nav class="views" aria-label="视图">%s</nav>' % "".join(
        '<button type="button" data-view="%s">%s</button>' % (k, esc(n)) for k, n in _MENU))

    commits = sum(r["commits"] for r in g["repos"]) if g else None
    ai = sum(r["ai_commits"] for r in g["repos"]) if g else None
    reverts = sum(r["reverts"] for r in g["repos"]) if g else None
    # the four parts of #22 side by side — cost, AI use, delivery, value — each 待接入 when it has no source
    V["overview"].append('<div class="kpis">%s</div>' % "".join((
        card("成本", usd(tot["cost_usd"]), "%d 个团队 · 未分摊 %s" % (len(m["teams"]), usd(tot["unallocated_usd"]))),
        card("AI 使用", "待接入" if u is None else "%s tokens" % fmt(u["tokens"]),
             "本月没有周报" if u is None else "%d 人提交周报 · 请求 %s" % (len(cv["submitted"]) if cv else 0, fmt(u["requests"]))),
        card("交付", "待接入" if g is None else "%s 次提交" % fmt(commits),
             "; ".join(x for x in ("AI 协作 ≥ %s · 回滚 %d" % (_share(ai, commits), reverts) if g else "",
                                   "有证据的交付物 %d" % len(dl["deliverables"]) if dl else "") if x) or "没有代码仓,没有周报"),
        card("价值", "待接入" if val is None else "%d 个申请" % (len(val["new"]) + len(val["reviewed"]) + len(val["due"])),
             "没有资源申请" if val is None else "新 %d · 复评 %d · 待复评 %d" % (len(val["new"]), len(val["reviewed"]), len(val["due"]))))))
    view = "overview"
    for b in month_blocks(m, history or []):
        k = b[0]
        if k == "view":
            view = b[1]
        elif k == "fold":
            V[view].append("<details><summary>%s</summary>" % esc(b[1]))
        elif k == "endfold":
            V[view].append("</details>")
        elif k in ("h2", "h3"):
            V[view].append("<%s>%s</%s>" % (k, esc(b[1]), k))
        elif k == "p":
            V[view].append('<div class="card"><p class="meta">%s</p></div>' % esc(b[1]))
        elif k == "note":
            V[view].append('<p class="hint">%s</p>' % esc(b[1]))
        elif k == "ul":
            V[view].append('<ul class="summary">%s</ul>' % "".join("<li>%s</li>" % esc(x) for x in b[1]))
        else:
            V[view].append(_html_table(b[1], b[2], sortable=len(b) > 3 and b[3] == "sort"))
    for k, _ in _VIEWS:
        H.append('<section data-view="%s">%s</section>' % (k, "".join(V[k])))
    H.append("<footer>实际费用只来自分摊文件。Tokens 来自周报。缺数据的部分显示待接入,不显示 0。</footer>")
    H.append("</main><script>%s%s</script></body></html>" % (_JS, _MONTH_JS))
    return "".join(H)


def cmd_month(args):
    import hashlib
    root = os.path.abspath(args.workspace_root) if args.workspace_root else os.path.dirname(_HERE)
    tool_root = os.path.dirname(_HERE)
    try:
        month = month_from_filename(args.allocation)
        mapping = load_mapping(args.mapping or os.path.join(tool_root, MAPPING_REL))
        for k in ("allocation_sheets", "allocation_columns", "allocation_summary_columns"):
            if k not in mapping:
                raise ValueError("mapping lacks '%s'" % k)
        spend, summary = read_allocation(args.allocation, mapping)
        with open(args.allocation, "rb") as fh:
            src_sha = hashlib.sha256(fh.read()).hexdigest()
    except (OSError, ValueError, KeyError, json.JSONDecodeError) as e:
        print("FAIL: %s" % e)
        return 2
    if not spend:
        print("FAIL: sheet %r has no rows — nothing to import" % mapping["allocation_sheets"]["spend"])
        return 2
    reports_dir = os.path.abspath(args.reports_dir) if args.reports_dir else os.path.join(root, REPORTS_REL)
    if not ensure_reports_dir(reports_dir, tool_root, create=True):
        return 2
    team = load_team_json(reports_dir)
    if team and team.get("_broken"):
        print("WARN: reports/team.json is not valid JSON — nobody is mapped to a person this run")
    tz_name = (team or {}).get("timezone") if team and not team.get("_broken") else None
    tz_name = tz_name or local_timezone()
    repos = None
    if not args.no_git:
        if args.repo:
            paths = args.repo
        else:
            mount = os.path.join(root, "repos")
            paths = sorted(os.path.join(mount, d) for d in os.listdir(mount)
                           if os.path.exists(os.path.join(mount, d, ".git"))) if os.path.isdir(mount) else []
        try:
            start, end = month_bounds(month, _tzinfo(tz_name))
            repos = [git_month(p, start, end) for p in paths] or None
        except ValueError as e:
            print("FAIL: %s" % e)
            return 2
    m = build_month(month, spend, summary, mapping, os.path.basename(args.allocation), src_sha, git_head(root),
                    repos=repos, team=team, tz_name=tz_name)
    try:
        schema = load_json(os.path.join(tool_root, SCHEMA_REL))
        req_schema = load_json(os.path.join(tool_root, REQUEST_SCHEMA_REL))
    except (OSError, json.JSONDecodeError) as e:
        print("FAIL: schema unusable: %s" % e)
        return 2
    m["ai_use"], m["delivery"], m["value"], m["coverage"], m["intake"] = build_month_view(
        reports_dir, month, schema, req_schema, m["people"], m["total"]["cost_usd"])
    out_dir = os.path.abspath(args.out) if args.out else os.path.join(reports_dir, "reports", "months", month)
    jp = os.path.join(out_dir, "month.json")
    replaced = None
    if os.path.isfile(jp):
        try:
            replaced = load_json(jp).get("source", {}).get("sha256")
        except (OSError, ValueError, AttributeError):
            replaced = "unreadable"
    os.makedirs(out_dir, exist_ok=True)
    hp, mp = os.path.join(out_dir, "month-report.html"), os.path.join(out_dir, "month-report.md")
    with open(jp, "w", encoding="utf-8") as fh:
        json.dump(m, fh, ensure_ascii=False, indent=2)
        fh.write("\n")
    history = month_history(os.path.dirname(out_dir))
    with open(mp, "w", encoding="utf-8") as fh:
        fh.write(render_month_md(m, history))
    with open(hp, "w", encoding="utf-8") as fh:
        fh.write(render_month_html(m, history))
    print("OK: month report written: %s (+ .md, month.json) — %d 个团队, 实际费用 %s (分摊文件), 未分摊 %s" % (
        hp, len(m["teams"]), usd(m["total"]["cost_usd"]), usd(m["total"]["unallocated_usd"])))
    if replaced:
        print("NOTE: %s 已存在,已整月替换(旧来源 sha256 %s…%s)" % (
            month, str(replaced)[:12], ",同一文件" if replaced == src_sha else ""))
    for c in m["checks"]:
        if c["status"] != "ok":
            print("WARN: 校验未通过 %s — 报告 %s, 文件 %s" % (c["name"], usd(c["report_usd"]), usd(c["file_usd"])))
    if m["git"]:
        print("OK: git — %s (author date, %s); pull the repos first, this tool never fetches" % (
            ", ".join("%s %d 次提交" % (r["repo"], r["commits"]) for r in m["git"]["repos"]), tz_name))
    else:
        print("NOTE: no git repo read — 代码仓 shows 待接入 (mount repos under repos/, or pass --repo)")
    it = m["intake"]
    print("OK: 周报 — %s: %d 份%s; 申请 %s" % (
        ", ".join(w["week"] for w in it["weeks"]) or "本月无周报", it["submissions"],
        ", 未纳入 %d" % len(it["rejected"]) if it["rejected"] else "",
        "待接入" if m["value"] is None else "新 %d / 复评 %d / 待复评 %d" % (len(m["value"]["new"]), len(m["value"]["reviewed"]), len(m["value"]["due"]))))
    rej = it["rejected"] + ((m["value"] or {}).get("rejected") or [])
    if rej:
        print("NOTE: 未纳入 — " + "; ".join("%s (%s)" % (x["file"], x["reason"]) for x in rej))
    if m["people"] is None:
        print("NOTE: reports/team.json has no identities — 按人 shows 待接入")
    else:
        print("OK: %d 人; 未映射作者 %d (add them to reports/team.json identities), 未映射 key %d (counted only)" % (
            len(m["people"]), len(m["unmapped"]["authors"]), m["unmapped"]["keys"]))
    if args.open:
        import webbrowser
        webbrowser.open("file://" + hp)
    print("NEXT: review %s, then commit / push through your normal flow — this tool never pushes." % mp)
    return 0


# ---------------------------------------------------------------- cli

def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("submit", help="write this operator's weekly submission into the reports repo")
    s.add_argument("--week", help="ISO week, e.g. 2026-W37 (Mon..Sun); default: last complete week")
    s.add_argument("--since", help="explicit window start YYYY-MM-DD (alternative to --week)")
    s.add_argument("--until", help="explicit window end YYYY-MM-DD, inclusive")
    s.add_argument("--reports-dir", help="team reports repo checkout (default: <root>/%s)" % REPORTS_REL)
    s.add_argument("--narrative", metavar="PATH", help="confirmed narrative JSON (see assets/narrative.example.json)")
    s.add_argument("--cost-file", metavar="PATH",
                   help="billing-owner JSON with actual / allocated / allocation / shared_costs / confirmed_by "
                        "(see assets/cost.example.json); without it 实际/分摊 are null and shown as 待核实")
    s.add_argument("--timezone", help="team timezone the week boundaries are stated in (default: this machine's)")
    s.add_argument("--platform-export", metavar="FILE", action="append",
                   help="CSV / XLSX export from the unified API platform (repeatable); (day, model) rows it covers "
                        "replace the local log's — 择一计入. Columns per assets/platform-export.mapping.json")
    s.add_argument("--platform-user", help="your user id in the export when it is not your human_id")
    s.add_argument("--bill", metavar="FILE", help="bill / subscription ledger (csv or json, see assets/bill.example.csv) → cost.actual "
                                                 "+ cost.allocated (prorated to the week)")
    s.add_argument("--mapping", metavar="PATH", help="column mapping (default: %s)" % MAPPING_REL)
    s.add_argument("--commit", action="store_true", help="git add+commit the json/md/html in the reports repo (local only)")
    s.add_argument("--open", action="store_true", help="open the personal HTML in the default viewer (local file)")
    s.add_argument("--pricing", metavar="PATH", help="price table (default: %s)" % PRICING_REL)
    s.add_argument("--source", choices=["auto", "native"], default="auto",
                   help="base-usage source passed to token-usage-report")
    s.add_argument("--workspace-root", help="AI-Workspace root (default: this script's repo)")
    s.add_argument("--out", help="where collector outputs land (default: <root>/runs/token-usage)")
    s.add_argument("--claude-dir", default=os.path.expanduser("~/.claude/projects"))
    s.add_argument("--codex-dir", default=os.path.expanduser("~/.codex/sessions"))
    s.add_argument("--qoder-dir", default=os.path.expanduser("~/.qoder/projects"))
    s.set_defaults(func=cmd_submit)

    t = sub.add_parser("team", help="aggregate one week's submissions into the team report")
    t.add_argument("--week", required=True, help="ISO week, e.g. 2026-W37")
    t.add_argument("--reports-dir", help="team reports repo checkout (default: <root>/%s)" % REPORTS_REL)
    t.add_argument("--summary-file", metavar="PATH", help="lead-reviewed 管理摘要 (markdown/plain text)")
    t.add_argument("--platform-export", metavar="FILE", action="append",
                   help="the lead's whole-team CSV / XLSX export; users map to human_id via reports/team.json platform_ids; "
                        "a member without a submission still gets a usage row (叙事 待提交)")
    t.add_argument("--pricing", metavar="PATH", help="price table for platform rows (default: %s)" % PRICING_REL)
    t.add_argument("--mapping", metavar="PATH", help="column mapping (default: %s)" % MAPPING_REL)
    t.add_argument("--budget-file", metavar="PATH", help="monthly budget per business (default: <reports-dir>/reports/budget.json)")
    t.add_argument("--open", action="store_true", help="open the HTML in the default viewer (local file)")
    t.add_argument("--workspace-root", help="AI-Workspace root (default: this script's repo)")
    t.add_argument("--out", help="output dir (default: beside the submissions, reports/<week>/)")
    t.set_defaults(func=cmd_team)

    mo = sub.add_parser("month", help="import one month's LiteLLM key allocation file into the monthly cost report")
    mo.add_argument("--allocation", required=True, metavar="FILE",
                    help="the month's key allocation xlsx (sheets per %s allocation_sheets); the month "
                         "comes from the file name only (september_2026 / 2026-09 / 202609 / 2026年9月); "
                         "re-import replaces the month" % MAPPING_REL)
    mo.add_argument("--reports-dir", help="team reports repo checkout (default: <root>/%s)" % REPORTS_REL)
    mo.add_argument("--mapping", metavar="PATH", help="column mapping (default: %s)" % MAPPING_REL)
    mo.add_argument("--open", action="store_true", help="open the HTML in the default viewer (local file)")
    mo.add_argument("--workspace-root", help="AI-Workspace root (default: this script's repo)")
    mo.add_argument("--out", help="output dir (default: <reports-dir>/reports/months/<month>/)")
    mo.add_argument("--repo", metavar="PATH", action="append",
                    help="git repo to read for the month (repeatable; default: every repo mounted under <root>/repos/). "
                         "Local git only — pull first")
    mo.add_argument("--no-git", action="store_true", help="do not read any git repo (代码仓 shows 待接入)")
    mo.set_defaults(func=cmd_month)

    q = sub.add_parser("request", help="AI resource request: write a draft (--form) or a pre-renewal review (review <id>)")
    q.add_argument("--form", metavar="PATH", help="the filled form (see assets/request.example.json)")
    q.add_argument("--reports-dir", help="team reports repo checkout (default: <root>/%s)" % REPORTS_REL)
    q.add_argument("--commit", action="store_true", help="git add+commit the two files in the reports repo (local only)")
    q.add_argument("--force", action="store_true", help="overwrite an existing draft with the same id")
    q.add_argument("--mapping", metavar="PATH", help="currency list source (default: %s)" % MAPPING_REL)
    q.add_argument("--workspace-root", help="AI-Workspace root (default: this script's repo)")
    q.add_argument("verb", nargs="?", choices=["review"], help="'review <id>': gather bills / usage / outcomes for the renewal decision")
    q.add_argument("id", nargs="?", help="request id (file basename without .json) for 'review'")
    q.set_defaults(func=cmd_request_dispatch)

    args = ap.parse_args()
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
