#!/usr/bin/env python3
"""Install the codebase-memory-mcp binary (pinned version) for `scripts/generate-map`.

Zero-dependency (stdlib only), a sibling of scripts/setup-repos/setup-skills — same idempotent,
non-interactive, run_log-ing shape. codebase-memory-mcp is the MCP/CLI tool behind the
`code-map-query` skill (skills/code-map-query/SKILL.md) and `scripts/generate-map`: it builds a
local code knowledge graph per repo and answers structural queries (callers, architecture, dead
code) far cheaper than grep.

Installs a plain release binary from https://github.com/DeusData/codebase-memory-mcp/releases into
a **user-level** bin dir (default `~/.local/bin`, override with `--dir` or `$CBM_INSTALL_DIR`) —
never `/usr/local/bin`, never sudo, never a system package manager: this workspace does not modify
the host, only the operator's own `$HOME` (the same "reuse the operator's own local permissions"
principle as `gh`/`ccusage` in workspace.yaml's required_local_permissions). Idempotent: if
the pinned version is already resolvable on PATH, the binary install is a no-op unless --force is
passed; any other version is replaced (so pulling a pin bump + `ws map install` upgrades you). The
swap runs through the downloaded binary's own `install` command, which stops running CBM sessions
before replacing the file — overwriting a binary in place can crash processes still mapped to it.
Client registration (`codebase-memory-mcp install -y`, wiring the MCP server into
Claude Code/Codex/etc. config) still runs every time, so a user who already has the binary but
never registered it gets fixed too. Pass --skip-register to install the binary only. Either way,
a fresh MCP connection needs a session reload — this script cannot do that part.
After successful registration, remove the installer's managed global instruction blocks so
workspace instructions control code-map behavior, while keeping MCP registration and hooks.
"""
import hashlib
import json
import os
import pathlib
import platform
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.request
from datetime import datetime, timezone

root = pathlib.Path(__file__).resolve().parent.parent

PINNED_VERSION = "v0.12.1"  # validated: scripts/generate-map output checked against this release
GH_REPO = "DeusData/codebase-memory-mcp"
BINARY = "codebase-memory-mcp"
# shortcut: three confirmed marker targets, extend when other installer targets are verified.
INSTRUCTION_FILES = (".claude/CLAUDE.md", ".codex/AGENTS.md", ".config/zed/AGENTS.md")

# (platform.system(), platform.machine()) -> release asset stem (without the .tar.gz suffix).
# darwin has no "-portable" variant; the linux "-portable" variant is what the sandbox validated
# (statically-linked, works across distros without extra runtime deps).
ASSET_MAP = {
    ("Darwin", "arm64"): "darwin-arm64",
    ("Darwin", "x86_64"): "darwin-amd64",
    ("Linux", "x86_64"): "linux-amd64-portable",
    ("Linux", "amd64"): "linux-amd64-portable",
    ("Linux", "aarch64"): "linux-arm64-portable",
    ("Linux", "arm64"): "linux-arm64-portable",
}


def usage(exit_code):
    print(__doc__.strip().splitlines()[0])
    print()
    print("usage: scripts/setup-map-tool [--dir <path>] [--force] [--skip-register]")
    print("  --dir <path>      install dir (default: ~/.local/bin, or $CBM_INSTALL_DIR)")
    print("  --force           reinstall the pinned version even if it is already on PATH")
    print("  --skip-register   install the binary only; don't wire it into Claude Code/Codex/etc.")
    sys.exit(exit_code)


def _git_out(*args, default=""):
    try:
        out = subprocess.run(["git", "-C", str(root), *args], capture_output=True, text=True).stdout.strip()
    except OSError:
        return default
    return out or default


def run_log(command, exit_code):
    runs_dir = root / "runs"
    runs_dir.mkdir(exist_ok=True)
    sha = _git_out("rev-parse", "HEAD", default="0" * 40)
    short_sha = _git_out("rev-parse", "--short", "HEAD", default="nogit")
    operator = _git_out("config", "user.name") or os.environ.get("USER", "unknown")
    now = datetime.now(timezone.utc)
    line = json.dumps({
        "run_id": f"run-{now.strftime('%Y%m%dT%H%M%SZ')}-{short_sha}",
        "ts": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "workspace_sha": sha,
        "command": f"setup-map-tool {command}",
        "exit_code": exit_code,
        "operator": operator,
    }, ensure_ascii=False) + "\n"
    with open(runs_dir / "run-log.jsonl", "a", encoding="utf-8") as f:
        f.write(line)


def _fetch(url):
    req = urllib.request.Request(url, headers={"User-Agent": "ai-native-workspace-setup-map-tool"})
    with urllib.request.urlopen(req, timeout=60) as resp:
        return resp.read()


def installed_version():
    found = shutil.which(BINARY)
    if not found:
        return None, ""
    try:
        version = subprocess.run([found, "--version"], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        version = ""
    return found, version


def strip_client_instructions():
    """Remove only complete managed blocks and their preceding blank lines, preserving other bytes."""
    seen = set()
    for name in INSTRUCTION_FILES:
        path = pathlib.Path.home() / name
        try:
            path = path.resolve()
            if path in seen:
                continue
            seen.add(path)
            original = path.read_bytes()
            markers = re.findall(rb"(?m)^<!-- codebase-memory-mcp:(start|end) -->(?:\r?\n|\Z)", original)
            if markers != [b"start", b"end"] * (len(markers) // 2):
                print(f"  WARNING: malformed managed instruction markers in {path}, leaving file unchanged", file=sys.stderr)
                continue
            cleaned = re.sub(
                rb"(?m)(?:^[ \t]*\r?\n)*^<!-- codebase-memory-mcp:start -->\r?\n"
                rb"(?s:.*?)^<!-- codebase-memory-mcp:end -->(?:\r?\n|\Z)",
                b"", original)
            if cleaned != original:
                path.write_bytes(cleaned)
                print(f"  OK: removed managed instruction block from {path}")
        except FileNotFoundError:
            continue
        except (OSError, RuntimeError) as exc:
            print(f"  WARNING: could not strip managed instruction block from {path}: {exc}", file=sys.stderr)


def register_clients(binary_path):
    """Wire the installed binary into whichever MCP clients (Claude Code, Codex, ...) it detects
    on this machine — the "register" step a user would otherwise have to run by hand before the
    tools show up, followed by a session reload this script cannot trigger for them."""
    print(f"registering {BINARY} with detected MCP clients ({binary_path} install -y) ...")
    try:
        result = subprocess.run([str(binary_path), "install", "-y"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        print("  FAIL: client registration could not run", file=sys.stderr)
        print(f"        register manually: {binary_path} install -y", file=sys.stderr)
        return False
    if result.returncode != 0:
        print(f"  FAIL: client registration exited {result.returncode} — register manually: {binary_path} install -y", file=sys.stderr)
        return False
    strip_client_instructions()
    print("  OK: registration command succeeded for detected clients")
    print("  UNVERIFIED: native tool access and queries — reload the session and run search_graph")
    return True


def main(argv):
    if argv and argv[0] in ("-h", "--help"):
        usage(0)

    env_dir = os.environ.get("CBM_INSTALL_DIR")
    install_dir = pathlib.Path(env_dir) if env_dir else (pathlib.Path.home() / ".local" / "bin")
    force = False
    skip_register = False
    i = 0
    while i < len(argv):
        if argv[i] == "--dir" and i + 1 < len(argv):
            install_dir = pathlib.Path(argv[i + 1]).expanduser()
            i += 2
        elif argv[i] == "--force":
            force = True
            i += 1
        elif argv[i] == "--skip-register":
            skip_register = True
            i += 1
        else:
            print(f"setup-map-tool: unknown argument '{argv[i]}'", file=sys.stderr)
            usage(2)

    found, version = installed_version()
    # `--version` prints "codebase-memory-mcp 0.11.0"; the pin carries a leading "v".
    at_pin = version.split()[-1:] == [PINNED_VERSION.lstrip("v")]
    if found and at_pin and not force:
        print(f"OK: {BINARY} {PINNED_VERSION} already on PATH at {found} — nothing to do")
        print("     re-run with --force to (re)install the pinned version instead")
        if skip_register:
            print("SKIPPED: client registration (--skip-register)")
        code = 0 if skip_register or register_clients(found) else 1
        run_log(" ".join(argv), code)
        return code
    if found and not at_pin:
        print(f"{found} is {version or 'an unknown version'}, workspace pins {PINNED_VERSION} — replacing it")

    key = (platform.system(), platform.machine())
    asset_stem = ASSET_MAP.get(key)
    if asset_stem is None:
        print(f"FAIL: no known {BINARY} release asset for platform {key}", file=sys.stderr)
        print(f"  - install manually: https://github.com/{GH_REPO}/releases/tag/{PINNED_VERSION}", file=sys.stderr)
        run_log(" ".join(argv), 1)
        return 1

    archive = f"{BINARY}-{asset_stem}.tar.gz"
    base_url = f"https://github.com/{GH_REPO}/releases/download/{PINNED_VERSION}"
    print(f"installing {BINARY} {PINNED_VERSION} ({archive}) into {install_dir} ...")

    try:
        checksums = _fetch(f"{base_url}/checksums.txt").decode("utf-8", "replace")
    except (urllib.error.URLError, OSError) as exc:
        print(f"FAIL: could not fetch checksums.txt: {exc}", file=sys.stderr)
        run_log(" ".join(argv), 1)
        return 1

    expected = None
    for line in checksums.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == archive:
            expected = parts[0]
            break
    if not expected:
        print(f"FAIL: {archive} not listed in {base_url}/checksums.txt", file=sys.stderr)
        run_log(" ".join(argv), 1)
        return 1

    try:
        data = _fetch(f"{base_url}/{archive}")
    except (urllib.error.URLError, OSError) as exc:
        print(f"FAIL: could not fetch {archive}: {exc}", file=sys.stderr)
        run_log(" ".join(argv), 1)
        return 1

    actual = hashlib.sha256(data).hexdigest()
    if actual != expected:
        print(f"FAIL: checksum mismatch for {archive} (expected {expected}, got {actual})", file=sys.stderr)
        run_log(" ".join(argv), 1)
        return 1

    install_dir.mkdir(parents=True, exist_ok=True)
    dest = install_dir / BINARY
    with tempfile.TemporaryDirectory() as staging:
        tmp_tar = pathlib.Path(staging) / archive
        tmp_tar.write_bytes(data)
        with tarfile.open(tmp_tar, "r:gz") as tf:
            try:
                extracted = tf.extractfile(tf.getmember(BINARY))
            except KeyError:
                extracted = None
            if extracted is None:
                print(f"FAIL: {archive} has no '{BINARY}' member", file=sys.stderr)
                run_log(" ".join(argv), 1)
                return 1
            staged = pathlib.Path(staging) / BINARY
            staged.write_bytes(extracted.read())
            staged.chmod(0o755)
        # The staged binary's own installer does the swap (and, unless --skip-register, the client
        # registration): it stops running CBM sessions first, then replaces dest.
        cmd = [str(staged), "install", "-y", f"--dir={install_dir}"] + (["--skip-config"] if skip_register else [])
        try:
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        except (OSError, subprocess.TimeoutExpired) as exc:
            print(f"FAIL: {BINARY} install did not run: {exc}", file=sys.stderr)
            run_log(" ".join(argv), 1)
            return 1
        if result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().splitlines()
            print(f"FAIL: {BINARY} install exited {result.returncode}: {detail[-1] if detail else ''}", file=sys.stderr)
            run_log(" ".join(argv), 1)
            return 1

    if not skip_register:
        strip_client_instructions()

    try:
        printed_version = subprocess.run([str(dest), "--version"], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as exc:
        print(f"FAIL: installed {dest} but it would not run: {exc}", file=sys.stderr)
        run_log(" ".join(argv), 1)
        return 1

    print(f"OK: installed {dest} ({printed_version}), checksum verified")
    if shutil.which(BINARY) is None:
        print(f"  NOTE: {install_dir} is not on PATH — add it to use `codebase-memory-mcp` directly "
              f"(scripts/generate-map checks {install_dir} itself either way)")
    if not skip_register:
        print("  OK: registration command succeeded for detected clients")
        print("  UNVERIFIED: native tool access and queries — restart sessions and run search_graph")
    else:
        print("  SKIPPED: client registration (--skip-register)")
    run_log(" ".join(argv), 0)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
