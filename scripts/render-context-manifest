#!/usr/bin/env python3
"""Render team-context/manifest.yaml (generated) from the fragments in team-context/manifest.d/ (lexical order).

Fragments share manifest.yaml's shape (`task_types:` → `  <type>:` → optional `    when:` → `    read:` → rows).
Composition (agent-instructions/context-manifest.md § "manifest.d/"): task types appear in first-seen order;
a task type's `when:` is set by the first fragment declaring it (a later, different `when:` is an error);
`read` rows and their comment lines are concatenated in fragment order — rows are additive, there is no
override; the same `path` twice under one task type is an error. Zero-dependency (stdlib only).
`--check` renders in memory and exits 1 if the tracked manifest.yaml differs. A non-flag argv is a root override.
"""
import pathlib
import re
import sys

args = [a for a in sys.argv[1:] if a != "--check"]
check = "--check" in sys.argv[1:]
root = pathlib.Path(args[0]).resolve() if args else pathlib.Path(__file__).resolve().parent.parent
FRAG_DIR = root / "team-context" / "manifest.d"
OUT = root / "team-context" / "manifest.yaml"
HEADER = """\
# team-context/manifest.yaml — Context Manifest (read-order list), #49
#
# GENERATED by scripts/render-context-manifest from team-context/manifest.d/ — do not edit this file.
#   00-template.yaml  framework-owned rows (shipped by the template)
#   50-team.yaml      this team's rows (team-owned)
# Edit a fragment, then re-render; `ws health` fails while this file is stale. Spec: agent-instructions/context-manifest.md.
#
# Each `read` entry: { path, authority, last_reviewed[, expires][, optional] }
#   authority: trusted (framework-tracked) | data (mount point) — per security-defaults.md §1
#   last_reviewed: YYYY-MM-DD — freshness anchor (the "no lag" red line)
#   optional: true — the path may not exist yet (a gitignored file a later setup step writes)
# Entries whose path contains a <placeholder> are template rows (filled when you mount a repo/suite);
# check-context-freshness validates their dates but skips path-existence — same for `optional` rows.
version: 1

task_types:
"""
TT = re.compile(r"^  ([A-Za-z0-9_-]+):\s*$")
WHEN = re.compile(r"^    when:\s*(.+?)\s*$")
READ = re.compile(r"^    read:\s*$")
ROW_PATH = re.compile(r"^\s*-\s*\{.*?\bpath:\s*([^,}]+)")


def parse(frag):
    """→ list of [task_type, when|None, preamble_lines, row_lines] in file order."""
    blocks, in_tt, pre, cur = [], False, [], None
    for raw in frag.read_text().splitlines():
        if not in_tt:
            in_tt = bool(re.match(r"^task_types:\s*$", raw))
            continue
        m = TT.match(raw)
        if m:
            cur = [m.group(1), None, pre, []]
            blocks.append(cur)
            pre = []
            continue
        if cur is None:
            if raw.strip():
                pre.append(raw)
            continue
        m = WHEN.match(raw)
        if m:
            cur[1] = m.group(1)
            continue
        if READ.match(raw):
            continue
        if raw.startswith("  #") and not raw.startswith("    "):   # 2-space comment → preamble of the NEXT type
            pre.append(raw)
            continue
        if raw.strip():
            cur[3].append(raw)
    return blocks


frags = sorted(FRAG_DIR.glob("*.yaml")) if FRAG_DIR.is_dir() else []
if not frags:
    sys.exit("ERROR: no fragments under team-context/manifest.d/ — expected at least 00-template.yaml")

order, whens, pres, rows, seen, errors = [], {}, {}, {}, {}, []
for frag in frags:
    for tt, when, pre, row_lines in parse(frag):
        if tt not in order:
            order.append(tt)
            whens[tt], pres[tt], rows[tt], seen[tt] = when, list(pre), [], {}
        else:
            if when and whens[tt] and when != whens[tt]:
                errors.append(f"{frag.name}: task type '{tt}' redeclares `when:` differently (set first by an earlier fragment)")
            whens[tt] = whens[tt] or when
            rows[tt].extend(pre)
        for ln in row_lines:
            m = ROW_PATH.match(ln)
            if m:
                p = m.group(1).strip()
                if p in seen[tt]:
                    errors.append(f"{frag.name}: duplicate path '{p}' under '{tt}' (first in {seen[tt][p]}) — rows are additive, drop one")
                seen[tt][p] = frag.name
        rows[tt].extend(row_lines)

if errors:
    print("FAIL: context-manifest render")
    for e in errors:
        print("  -", e)
    sys.exit(1)

out = [HEADER.rstrip("\n")]
for tt in order:
    out.append("")
    out.extend(pres[tt])
    out.append(f"  {tt}:")
    if whens[tt]:
        out.append(f"    when: {whens[tt]}")
    out.append("    read:")
    out.extend(rows[tt])
text = "\n".join(out) + "\n"

if check:
    if not OUT.exists() or OUT.read_text() != text:
        print("FAIL: team-context/manifest.yaml is stale — run scripts/render-context-manifest")
        sys.exit(1)
    print(f"OK: team-context/manifest.yaml matches manifest.d/ ({len(frags)} fragments, {len(order)} task types)")
else:
    OUT.write_text(text)
    print(f"rendered team-context/manifest.yaml ({len(frags)} fragments, {len(order)} task types)")
