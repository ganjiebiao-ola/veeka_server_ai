    "requests": ["requests", "request count", "request_count", "calls", "请求数", "请求"],
    "input": ["input tokens", "input_tokens", "input", "prompt tokens", "prompt_tokens", "输入 token"],
    "output": ["output tokens", "output_tokens", "output", "completion tokens", "completion_tokens", "输出 token"],
    "cache_read": ["cached tokens", "cached_tokens", "cache read tokens", "cache_read_input_tokens", "cache_read", "缓存读取"],
    "cache_creation": ["cache creation tokens", "cache_creation_input_tokens", "cache write tokens", "cache_creation", "缓存写入"],
