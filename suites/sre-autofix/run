#!/usr/bin/env sh
# suites/sre-autofix/run — main flow entry (#43 convention): claim | plan | fix | gate | ship | release
# POSIX sh dispatcher; all logic is python3-stdlib under lib/. Usage: run <verb> [args] (run -h).
set -u
here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
root="$(CDPATH= cd -- "$here/../.." && pwd)"
exec python3 "$here/lib/cli.py" --root "$root" "$@"
