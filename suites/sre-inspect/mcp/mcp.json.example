// Claude Code project MCP config — merge the `grafana` server into <workspace>/.mcp.json.
// Values come from your shell environment (`set -a; . suites/sre-inspect/env/.env.holmes; set +a`).
// Codex: `suites/sre-inspect/run mcp-config` prints the ~/.codex/config.toml form.
{
  "mcpServers": {
    "grafana": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GRAFANA_URL",
        "-e",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN",
        "-e",
        "GRAFANA_ORG_ID",
        "--entrypoint",
        "/app/mcp-grafana",
        "grafana/mcp-grafana:1.2.0@sha256:cfae68f893dbe40cb6df69579f78beb226f973ded4436d47c844f91d2f00dc53",
        "-t",
        "stdio",
        "--disable-write",
        "--enabled-tools",
        "datasource,prometheus,alerting,dashboard,navigation,search",
        "--grafana-timeout",
        "60s"
      ],
      "env": {
        "GRAFANA_URL": "${GRAFANA_URL}",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}",
        "GRAFANA_ORG_ID": "${GRAFANA_ORG_ID:-1}"
      }
    }
  }
}
