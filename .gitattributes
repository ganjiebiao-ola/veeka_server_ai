# Downstream sync (platform-internals/ownership.yaml): seed + generated files keep THIS clone's version when
# `git merge upstream/<branch>` finds both sides changed. Needs, once per clone:
#   git config merge.ours.driver 'scripts/lib/merge-keep-team %O %A %B'   (the workspace-upstream-sync skill's preflight sets it;
#   the script keeps the team's side even under an accidental `git rebase`, where git swaps ours/theirs)
# Inert in the template itself (nothing merges into it through this mechanism). Leading `/` anchors a
# root file: a bare `README.md` would also match skills/README.md, which is framework-owned.
/README.md merge=ours
/README.en.md merge=ours
/workspace.yaml merge=ours
rules/** merge=ours
team-context/security-defaults.team.md merge=ours
team-context/agent-entry.team.md merge=ours
team-context/manifest.d/50-team.yaml merge=ours
team-context/freshness-log.md merge=ours
knowledge/README.md merge=ours
knowledge/maps/overview.md merge=ours
/CLAUDE.md merge=ours
/AGENTS.md merge=ours
team-context/manifest.yaml merge=ours
